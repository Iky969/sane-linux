#!/bin/sh
# sane-reliability -- Phase C system reliability toolkit.
#
# Host-side POSIX sh tool that operates on a target rootfs (--root DIR).
# Provides snapshots, verified rollback, staged upgrades, journal-driven
# recovery, structured logging and backup/restore. Fail-closed: a malformed
# or unverifiable input never modifies the target.
set -eu

PROG=${0##*/}
ROOT=/
VERBOSE=0

STATE_FILES="etc/passwd etc/group etc/shadow etc/doas.conf etc/init.conf etc/fstab etc/hostname"

usage() {
	cat <<EOF
Usage: $PROG [--root DIR] <command> [args]

Commands:
  init                          create state dirs and idle journal
  snapshot TAG [--force]        capture verified state snapshot
  list                          list snapshots
  verify TAG                    verify snapshot integrity
  rollback TAG                  restore a verified snapshot
  upgrade PAYLOAD_DIR           verify, snapshot, then commit a payload
  recover                       roll back an interrupted upgrade
  net-recover [--iface IFACE]   restore default DNS and reconnect networking
  log LEVEL MESSAGE             append a structured log entry
  backup ARCHIVE [--force]      archive snapshots, journal and logs
  restore ARCHIVE               restore an archive into a target root
EOF
}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
note() { [ "$VERBOSE" -eq 1 ] && printf 'ok: %s\n' "$*"; return 0; }

canonicalize_root() {
	# Resolve ROOT to a canonical physical path with cd -P + pwd (POSIX, no
	# realpath dependency). A brand-new root may not exist yet (D4: init
	# creates it): resolve the nearest existing ancestor physically, then walk
	# the remaining tail component by component, expanding symlinks with a
	# bounded hop count so the canonical path never traverses a link (a
	# dangling root symlink resolves to its absent target). Nothing is created
	# here, so malformed commands still fail before any write.
	cr_path=$ROOT
	while [ "${cr_path%/}" != "$cr_path" ]; do cr_path=${cr_path%/}; done
	[ -n "$cr_path" ] || cr_path=/
	cr_tail=
	while [ ! -d "$cr_path" ]; do
		cr_tail="/${cr_path##*/}$cr_tail"
		cr_path=${cr_path%/*}
		[ -n "$cr_path" ] || cr_path=/
	done
	cr_base=$(cd -P "$cr_path" && pwd) || die "cannot resolve --root: $ROOT"
	cr_rest=${cr_tail#/}
	cr_hops=0
	while [ -n "$cr_rest" ]; do
		case "$cr_rest" in
			*/*) cr_comp=${cr_rest%%/*}; cr_rest=${cr_rest#*/} ;;
			*) cr_comp=$cr_rest; cr_rest= ;;
		esac
		case "$cr_comp" in
			''|.) continue ;;
			..) cr_base=${cr_base%/*}; [ -n "$cr_base" ] || cr_base=/; continue ;;
		esac
		if [ -L "$cr_base/$cr_comp" ]; then
			cr_hops=$((cr_hops + 1))
			[ "$cr_hops" -le 40 ] || die "too many symlink hops in --root: $ROOT"
			cr_target=$(readlink "$cr_base/$cr_comp" 2>/dev/null) || \
				die "cannot read root symlink: $cr_base/$cr_comp"
			[ -n "$cr_target" ] || die "empty root symlink target: $cr_base/$cr_comp"
			case "$cr_target" in
				/*) cr_base=/; cr_rest="${cr_target#/}/$cr_rest" ;;
				*) cr_rest="$cr_target/$cr_rest" ;;
			esac
			continue
		fi
		cr_base="$cr_base/$cr_comp"
	done
	ROOT=$cr_base
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		--root) [ "$#" -ge 2 ] || die "--root needs a directory"; ROOT=$2; shift 2 ;;
		-v|--verbose) VERBOSE=1; shift ;;
		-h|--help) usage; exit 0 ;;
		--) shift; break ;;
		-*) die "unknown option: $1" ;;
		*) break ;;
	esac
done

[ "$#" -ge 1 ] || { usage >&2; exit 1; }
CMD=$1; shift

case "$ROOT" in
	/*) ;;
	*) die "--root must be an absolute path" ;;
esac
canonicalize_root

STATE="$ROOT/var/lib/sane/reliability"
SNAPS="$STATE/snapshots"
STAGING="$STATE/staging"
JOURNAL="$STATE/journal"
LOCK_DIR="$STATE/lock"
LOGDIR="$ROOT/var/log/sane"
LOGFILE="$LOGDIR/reliability.log"
MAX_LOG_BYTES=65536

# Internal state/log path components whose symlink resolution must stay inside
# the canonical ROOT. Validated at the top-level dispatcher entry BEFORE any
# write, mkdir or lock acquisition (see validate_internal_state). Kept as
# relative paths so the same bounded-hop walk as symlink_safe_rel resolves
# them. Order matters: the shallowest component of a chain is listed first,
# so the failure reason names the exact component that escaped.
INTERNAL_STATE_RELS="var var/lib var/lib/sane var/lib/sane/reliability \
var/lib/sane/reliability/snapshots var/lib/sane/reliability/staging \
var/lib/sane/reliability/journal var/lib/sane/reliability/lock \
var/lib/sane/reliability/lock/pid \
var/log var/log/sane var/log/sane/reliability.log \
var/log/sane/reliability.log.1"

valid_tag() {
	# '.' and '..' are whole-dot components, and '.tmp.*' / '.old.*' are
	# the internal crash-window staging/aside namespaces: none can be a
	# user snapshot tag. Dot-prefixed names such as '.hidden' remain legal.
	case "$1" in
		''|.|..|.tmp.*|.old.*|*[!A-Za-z0-9._-]*) return 1 ;;
		-*) return 1 ;;
	esac
	[ "${#1}" -le 64 ]
}

cmd_init() {
	mkdir -p "$SNAPS" "$STAGING" "$LOGDIR" || die "cannot create reliability state"
	chmod 0755 "$SNAPS" "$STAGING" "$LOGDIR"
	[ -f "$JOURNAL" ] || printf 'state=idle\n' > "$JOURNAL"
	chmod 0600 "$JOURNAL"
	[ -f "$LOGFILE" ] || : > "$LOGFILE"
	chmod 0644 "$LOGFILE"
	note "reliability state initialised in $STATE"
}

valid_rel_path() {
	# Reject absolute paths, traversal, non-canonical dot/empty components
	# and NUL/backslash tricks.
	case "$1" in
		''|.|/*|*'\'*|*..*) return 1 ;;
	esac
	case "/$1/" in
		*/../*|*/./*|*//*) return 1 ;;
	esac
	return 0
}

normalize_path() {
	# normalize_path ABS -- collapse '.' and '..' components of an absolute
	# path using pure POSIX parameter expansion (no GNU realpath dependency).
	np_in=$1
	case "$np_in" in /*) ;; *) return 1 ;; esac
	np_out=
	np_rest=${np_in#/}
	while [ -n "$np_rest" ]; do
		case "$np_rest" in
			*/*) np_comp=${np_rest%%/*}; np_rest=${np_rest#*/} ;;
			*) np_comp=$np_rest; np_rest= ;;
		esac
		case "$np_comp" in
			''|.) continue ;;
			..) np_out=${np_out%/*} ;;
			*) np_out="$np_out/$np_comp" ;;
		esac
	done
	printf '%s\n' "${np_out:-/}"
}

symlink_safe_rel() {
	# symlink_safe_rel REL -- fail closed if any component of ROOT/REL is a
	# symlink whose resolution leaves ROOT. Walks each component physically,
	# resolving symlink chains with readlink and a bounded hop count, and
	# requires every resolved path to stay under ROOT. Internal-root symlinks
	# are allowed. REL must already pass valid_rel_path (no '..'/absolute).
	ssr_rel=$1
	ssr_root=$ROOT
	while [ "${ssr_root%/}" != "$ssr_root" ]; do ssr_root=${ssr_root%/}; done
	ssr_cur=$ssr_root
	ssr_rest=$ssr_rel
	while [ -n "$ssr_rest" ]; do
		case "$ssr_rest" in
			*/*) ssr_comp=${ssr_rest%%/*}; ssr_rest=${ssr_rest#*/} ;;
			*) ssr_comp=$ssr_rest; ssr_rest= ;;
		esac
		[ -n "$ssr_comp" ] || continue
		ssr_cur="$ssr_cur/$ssr_comp"
		ssr_hops=0
		while [ -L "$ssr_cur" ]; do
			ssr_hops=$((ssr_hops + 1))
			[ "$ssr_hops" -le 40 ] || return 1
			ssr_target=$(readlink "$ssr_cur" 2>/dev/null) || return 1
			case "$ssr_target" in
				/*) ssr_cur=$ssr_target ;;
				*) ssr_cur="$(dirname "$ssr_cur")/$ssr_target" ;;
			esac
			ssr_cur=$(normalize_path "$ssr_cur") || return 1
			case "$ssr_cur/" in
				"$ssr_root/"*) ;;
				*) return 1 ;;
			esac
		done
	done
	return 0
}

resolve_abs_no_contain() {
	# resolve_abs_no_contain ABS -- follow an ABSOLUTE symlink target to its
	# final physical path with the same bounded-hop component walk, WITHOUT
	# any containment check. An absolute target's prefixes are legitimately
	# outside ROOT (e.g. /tmp when ROOT is /tmp/fixture/root), so checking
	# each prefix against ROOT would over-reject an internal absolute link.
	# The CALLER tests the final resolved path under ROOT. Relative targets
	# keep the containment-checked walk in symlink_resolve_contained.
	rac_base=/
	rac_rest=${1#/}
	rac_hops=0
	while [ -n "$rac_rest" ]; do
		case "$rac_rest" in
			*/*) rac_comp=${rac_rest%%/*}; rac_rest=${rac_rest#*/} ;;
			*) rac_comp=$rac_rest; rac_rest= ;;
		esac
		case "$rac_comp" in
			''|.) continue ;;
		esac
		rac_cand=$(normalize_path "$rac_base/$rac_comp") || return 1
		if [ -L "$rac_cand" ]; then
			rac_hops=$((rac_hops + 1))
			[ "$rac_hops" -le 40 ] || return 1
			rac_target=$(readlink "$rac_cand" 2>/dev/null) || return 1
			[ -n "$rac_target" ] || return 1
			case "$rac_target" in
				/*) rac_base=/; rac_rest="${rac_target#/}/$rac_rest" ;;
				*)  rac_base=$(dirname "$rac_cand")
				    rac_rest="$rac_target/$rac_rest" ;;
			esac
			continue
		fi
		rac_base=$rac_cand
	done
	printf '%s\n' "$rac_base"
}

symlink_resolve_contained() {
	# symlink_resolve_contained REL -- bounded-hop resolver for the internal
	# state preflight. REL is relative (no '..'/absolute) and ROOT is already
	# canonical. Walk component by component; whenever a component is a
	# symlink, expand it and RESTART the walk from the new base with the link
	# target's components prepended to the remaining ones. Restarting is
	# essential: resolving a link to "a/b" must still walk "a", which may be
	# an ancestor symlink pointing outside ROOT even when "b" is ordinary —
	# a one-shot normalize would wrongly accept that chain. Absolute targets
	# are resolved fully by resolve_abs_no_contain WITHOUT per-prefix
	# containment (their prefixes may lie outside ROOT) and their FINAL
	# resolved path must be under ROOT; relative targets resolve against the
	# link's directory with per-component containment. Hops are bounded at 40
	# and '.'/'..' collapse via normalize_path (pure POSIX, identical on the
	# BusyBox runtime). Nothing is created here.
	src_rel=$1
	src_root=$ROOT
	while [ "${src_root%/}" != "$src_root" ]; do src_root=${src_root%/}; done
	[ -n "$src_root" ] || src_root=/
	# canonicalize_root can emit a doubled leading slash for symlinked roots
	# (abs-target expansion sets base=/ then appends a leading-'/'-stripped
	# target). Collapse it so the lexical containment check compares the
	# same spelling as normalize_path's output.
	src_root=$(normalize_path "$src_root") || return 1
	src_base=$src_root
	src_rest=$src_rel
	src_hops=0
	while [ -n "$src_rest" ]; do
		case "$src_rest" in
			*/*) src_comp=${src_rest%%/*}; src_rest=${src_rest#*/} ;;
			*) src_comp=$src_rest; src_rest= ;;
		esac
		case "$src_comp" in
			''|.) continue ;;
		esac
		src_cand=$(normalize_path "$src_base/$src_comp") || return 1
		if [ "$src_root" != "/" ]; then
			case "$src_cand/" in
				"$src_root/"*) ;;
				*) return 1 ;;
			esac
		fi
		if [ -L "$src_cand" ]; then
			src_hops=$((src_hops + 1))
			[ "$src_hops" -le 40 ] || return 1
			src_target=$(readlink "$src_cand" 2>/dev/null) || return 1
			[ -n "$src_target" ] || return 1
			case "$src_target" in
				/*)
					# Absolute target: resolve every component (including
					# further symlink hops) WITHOUT per-prefix containment,
					# then require the FINAL resolved path to stay under
					# ROOT. Prefixes like /tmp are outside ROOT by design.
					src_abs=$(resolve_abs_no_contain "$src_target") || return 1
					if [ "$src_root" != "/" ]; then
						case "$src_abs/" in
							"$src_root/"*) ;;
							*) return 1 ;;
						esac
					fi
					src_base=$src_abs
					;;
				*)  src_base=$(dirname "$src_cand")
				    src_rest="$src_target/$src_rest" ;;
			esac
			continue
		fi
		src_base=$src_cand
	done
	return 0
}

validate_internal_state() {
	# validate_internal_state -- containment gate for the tool's OWN state
	# and log paths. Called at the top-level dispatcher entry BEFORE
	# acquire_lock's mkdir and before any command's first write, so every
	# command (and every nested/internal recovery path, which runs later in
	# the same process) is covered without a second acquisition.
	#
	# Every listed path (state directories, the journal/lock/pid leaves and
	# the log leaves that cmd_init/log_event create or append directly) is
	# resolved with symlink_resolve_contained. An existing symlink whose full
	# resolution stays under the canonical ROOT is accepted (internal
	# symlinks remain legal); a chain that escapes ROOT fails closed with a
	# specific reason and NO lock, directory or file is created. Paths that
	# do not exist yet (fresh roots) pass trivially.
	for vis_rel in $INTERNAL_STATE_RELS; do
		symlink_resolve_contained "$vis_rel" || \
			die "internal state path escapes root: $vis_rel"
	done
}

record_symlink() {
	# record_symlink SNAPSHOT_TMP SRC_PATH REL -- append a path/target pair
	# to the snapshot's symlinks metadata (two lines per entry). Targets
	# share the manifest grammar: a backslash or newline cannot be
	# represented in the line format, so refuse to record it (fail closed).
	rs_tmp=$1; rs_src=$2; rs_rel=$3
	rs_target=$(readlink "$rs_src") || return 1
	case "$rs_target" in
		*'\'*) return 1 ;;
	esac
	[ "$(printf '%s' "$rs_target" | wc -l | tr -d ' ')" -eq 0 ] || return 1
	printf '%s\n%s\n' "$rs_rel" "$rs_target" >> "$rs_tmp/symlinks"
}

symlink_target_inside() {
	# symlink_target_inside REL TARGET -- fail closed unless a recorded
	# symlink target resolves inside ROOT. Absolute targets must normalize
	# under ROOT; relative targets resolve against the link's directory.
	# The resolved target's own components are walked too (bounded hops via
	# symlink_safe_rel), so an internal-looking first hop cannot chain out
	# of ROOT. Dangling targets inside ROOT are allowed.
	sti_rel=$1; sti_target=$2
	[ -n "$sti_target" ] || return 1
	case "$sti_target" in
		*'\'*) return 1 ;;
	esac
	case "$sti_target" in
		/*) sti_cand=$(normalize_path "$sti_target") || return 1 ;;
		*) sti_cand=$(normalize_path "$(dirname "$ROOT/$sti_rel")/$sti_target") || return 1 ;;
	esac
	sti_root=$ROOT
	while [ "${sti_root%/}" != "$sti_root" ]; do sti_root=${sti_root%/}; done
	case "$sti_cand/" in
		"$sti_root/"*) ;;
		*) return 1 ;;
	esac
	sti_crel=${sti_cand#"$sti_root"/}
	symlink_safe_rel "$sti_crel"
}

check_dest_symlinks() {
	# check_dest_symlinks DIR -- pre-pass over a manifest: reject before any
	# write if a destination would traverse a symlink escaping ROOT.
	cds_dir=$1
	while IFS= read -r cds_line; do
		[ -n "$cds_line" ] || continue
		cds_path=$(printf '%s\n' "$cds_line" | sed 's/^[^ ]*  //')
		case "$cds_path" in
			./meta|./manifest.sha256|./new-files|./symlinks|'') continue ;;
		esac
		cds_rel=${cds_path#./}
		valid_rel_path "$cds_rel" || die "unsafe manifest path: $cds_path"
		symlink_safe_rel "$cds_rel" || die "destination symlink escapes root: $cds_rel"
	done < "$cds_dir/manifest.sha256"
}

validate_manifest() {
	# validate_manifest DIR -- fail closed before hashing or applying entries
	vm_dir=$1
	[ -f "$vm_dir/manifest.sha256" ] || die "manifest missing in $vm_dir"
	while IFS= read -r vm_line; do
		[ -n "$vm_line" ] || continue
		vm_path=$(printf '%s\n' "$vm_line" | sed 's/^[^ ]*  //')
		case "$vm_path" in
			./meta|./manifest.sha256|./new-files|./symlinks|'') continue ;;
		esac
		vm_rel=${vm_path#./}
		valid_rel_path "$vm_rel" || die "unsafe manifest path: $vm_path"
	done < "$vm_dir/manifest.sha256"
}

write_manifest() {
	# write_manifest DIR -- NUL-delimited so spaced names survive. One
	# grammar with the verifier: GNU sha256sum escapes backslash/newline
	# names with a leading backslash, which valid_rel_path rejects -- such
	# a manifest could never verify, so refuse the snapshot here (fail
	# closed, staging removed) instead of writing a permanently dead one.
	dir=$1
	(cd "$dir" && find . -type f ! -name manifest.sha256 -print0 | \
		LC_ALL=C sort -z | xargs -0 -r sha256sum) > "$dir/manifest.sha256"
	while IFS= read -r wm_line; do
		[ -n "$wm_line" ] || continue
		case "$wm_line" in
			'\'*)
				rm -rf -- "$dir"
				die "snapshot rejected: backslash/newline filename breaks the manifest grammar: $wm_line" ;;
		esac
		wm_path=$(printf '%s\n' "$wm_line" | sed 's/^[^ ]*  //')
		wm_rel=${wm_path#./}
		valid_rel_path "$wm_rel" || { rm -rf -- "$dir"; die "unsafe snapshot filename: $wm_path"; }
	done < "$dir/manifest.sha256"
}

unique_tag() {
	# unique_tag PREFIX -- never collide, even twice in the same second
	ut_prefix=$1; ut_n=0; ut_candidate=$ut_prefix
	while [ -e "$SNAPS/$ut_candidate" ]; do
		ut_n=$((ut_n + 1)); ut_candidate="$ut_prefix-$ut_n"
	done
	printf '%s\n' "$ut_candidate"
}

do_snapshot() {
	# do_snapshot TAG [force] [extra-list] -- internal, no logging. extra-list
	# is a file of relative payload target paths: existing targets are copied
	# into the snapshot; absent targets are recorded in new-files for deletion
	# on rollback/recover.
	ds_tag=$1; ds_force=${2:-0}; ds_extra=${3:-}
	valid_tag "$ds_tag" || die "invalid snapshot tag: $ds_tag"
	ds_target="$SNAPS/$ds_tag"
	[ -d "$ds_target" ] && [ "$ds_force" -ne 1 ] && die "snapshot already exists: $ds_tag"
	ds_tmp=$(mktemp -d "$SNAPS/.tmp.XXXXXX") || die "cannot create snapshot staging dir"
	[ -d "$ds_tmp" ] || die "mktemp did not create a directory"
	# Symlink metadata: two lines per entry (relative path, readlink target).
	# A regular file, so write_manifest hashes it and verify protects it.
	: > "$ds_tmp/symlinks"
	for rel in $STATE_FILES; do
		src="$ROOT/$rel"
		if [ -L "$src" ]; then
			record_symlink "$ds_tmp" "$src" "$rel" || \
				{ rm -rf -- "$ds_tmp"; die "cannot record symlink: $rel"; }
			continue
		fi
		[ -f "$src" ] || continue
		mkdir -p "$ds_tmp/$(dirname "$rel")"
		cp -p "$src" "$ds_tmp/$rel" || { rm -rf -- "$ds_tmp"; die "cannot copy $rel"; }
	done
	if [ -d "$ROOT/var/lib/spm" ]; then
		mkdir -p "$ds_tmp/var/lib"
		cp -a "$ROOT/var/lib/spm" "$ds_tmp/var/lib/" || { rm -rf -- "$ds_tmp"; die "cannot copy spm DB"; }
		# cp -a preserved DB symlinks; record them (relative to ROOT) so
		# rollback recreates them -- the manifest only covers regular files.
		ds_llist=$(mktemp "$STAGING/.snapshot-links.XXXXXX") || \
			{ rm -rf -- "$ds_tmp"; die "cannot stage symlink list"; }
		find "$ds_tmp/var/lib/spm" -type l -print > "$ds_llist"
		while IFS= read -r ds_lnk; do
			[ -n "$ds_lnk" ] || continue
			ds_lrel=${ds_lnk#"$ds_tmp/"}
			record_symlink "$ds_tmp" "$ds_lnk" "$ds_lrel" || \
				{ rm -f -- "$ds_llist"; rm -rf -- "$ds_tmp"; die "cannot record spm symlink: $ds_lrel"; }
		done < "$ds_llist"
		rm -f -- "$ds_llist"
	fi
	if [ -n "$ds_extra" ] && [ -f "$ds_extra" ]; then
		: > "$ds_tmp/new-files"
		while IFS= read -r ds_rel; do
			[ -n "$ds_rel" ] || continue
			valid_rel_path "$ds_rel" || { rm -rf -- "$ds_tmp"; die "unsafe snapshot path: $ds_rel"; }
			case "$ds_rel" in
				symlinks)
					rm -rf -- "$ds_tmp"
					die "payload target collides with snapshot metadata: $ds_rel" ;;
			esac
			if [ -L "$ROOT/$ds_rel" ]; then
				record_symlink "$ds_tmp" "$ROOT/$ds_rel" "$ds_rel" || \
					{ rm -rf -- "$ds_tmp"; die "cannot record symlink: $ds_rel"; }
			elif [ -f "$ROOT/$ds_rel" ]; then
				mkdir -p "$ds_tmp/$(dirname "$ds_rel")"
				cp -p "$ROOT/$ds_rel" "$ds_tmp/$ds_rel" || { rm -rf -- "$ds_tmp"; die "cannot copy $ds_rel"; }
			else
				printf '%s\n' "$ds_rel" >> "$ds_tmp/new-files"
			fi
		done < "$ds_extra"
	fi
	printf 'timestamp=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$ds_tmp/meta"
	write_manifest "$ds_tmp" || { rm -rf -- "$ds_tmp"; die "cannot write manifest"; }
	# Swap atomically: rename the old snapshot aside, install the new one,
	# then delete the old one. A failed install restores the original. The
	# aside name is deterministic (.old.<tag>, tag already validated) so a
	# crash between the two renames is healable by heal_snapshot_swaps.
	if [ -d "$ds_target" ]; then
		ds_old="$SNAPS/.old.$ds_tag"
		[ -e "$ds_old" ] && rm -rf -- "$ds_old"
		if ! mv "$ds_target" "$ds_old"; then
			rm -rf -- "$ds_tmp"; die "cannot move old snapshot aside"
		fi
		if ! mv "$ds_tmp" "$ds_target"; then
			mv "$ds_old" "$ds_target" || true
			rm -rf -- "$ds_tmp"; die "cannot install snapshot $ds_tag"
		fi
		rm -rf -- "$ds_old" || true
	else
		mv "$ds_tmp" "$ds_target" || { rm -rf -- "$ds_tmp"; die "cannot install snapshot $ds_tag"; }
	fi
}

check_snapshot() {
	tag=$1
	dir="$SNAPS/$tag"
	[ -d "$dir" ] || die "no such snapshot: $tag"
	validate_manifest "$dir"
	(cd "$dir" && sha256sum -c manifest.sha256 >/dev/null 2>&1) || die "snapshot integrity check failed: $tag"
}

cmd_snapshot() {
	[ "$#" -ge 1 ] || die "usage: snapshot TAG [--force]"
	tag=$1; shift
	force=0
	for arg in "$@"; do
		case "$arg" in
			--force) force=1 ;;
			*) die "unknown snapshot option: $arg" ;;
		esac
	done
	cmd_init
	do_snapshot "$tag" "$force"
	note "snapshot '$tag' created"
}

cmd_list() {
	cmd_init
	printf 'TAG  CREATED\n'
	# Enumerate dot-directories too: user tags such as '.hidden' are legal
	# and must be visible. Only the internal .tmp.* staging and .old.*
	# swap-aside directories (plus '.'/'..') are hidden.
	for dir in "$SNAPS"/* "$SNAPS"/.*; do
		[ -d "$dir" ] || continue
		tag=${dir##*/}
		case "$tag" in
			.|..|.tmp.*|.old.*) continue ;;
		esac
		ts=$(sed -n 's/^timestamp=//p' "$dir/meta" 2>/dev/null || true)
		printf '%-24s %s\n' "$tag" "${ts:-unknown}"
	done
}

cmd_verify() {
	[ "$#" -eq 1 ] || die "usage: verify TAG"
	cmd_init
	check_snapshot "$1"
	printf 'verified: %s\n' "$1"
}

write_journal() {
	# write_journal STATE [TAG] [IFACE] -- atomic, mode 0600
	st=$1; tag=${2:-}; journal_iface=${3:-}
	tmp=$(mktemp "$STATE/.journal.XXXXXX") || die "cannot create journal temp"
	printf 'state=%s\n' "$st" > "$tmp"
	[ -n "$tag" ] && printf 'snapshot=%s\n' "$tag" >> "$tmp"
	[ -n "$journal_iface" ] && printf 'net-iface=%s\n' "$journal_iface" >> "$tmp"
	printf 'timestamp=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "$tmp"
	mv "$tmp" "$JOURNAL"
	chmod 0600 "$JOURNAL"
}

journal_get() { sed -n "s/^$1=//p" "$JOURNAL" 2>/dev/null | head -n1; }

log_event() {
	# log_event LEVEL MESSAGE -- internal structured logger with rotation
	level=$1; shift
	[ -f "$LOGFILE" ] || : > "$LOGFILE"
	if [ -f "$LOGFILE" ]; then
		size=$(wc -c < "$LOGFILE" | tr -d ' ')
		if [ "${size:-0}" -ge "$MAX_LOG_BYTES" ]; then
			mv "$LOGFILE" "$LOGFILE.1" || true
			: > "$LOGFILE"
		fi
	fi
	printf '%s %s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$level" "$*" >> "$LOGFILE"
	chmod 0644 "$LOGFILE"
}

restore_files_from() {
	# restore_files_from DIR -- apply every manifest entry atomically
	rf_dir=$1
	validate_manifest "$rf_dir"
	check_dest_symlinks "$rf_dir"
	while IFS= read -r rf_line; do
		[ -n "$rf_line" ] || continue
		rf_path=$(printf '%s\n' "$rf_line" | sed 's/^[^ ]*  //')
		case "$rf_path" in
			./meta|./manifest.sha256|./new-files|./symlinks|'') continue ;;
		esac
		rf_rel=${rf_path#./}
		valid_rel_path "$rf_rel" || die "unsafe manifest path: $rf_path"
		rf_src="$rf_dir/$rf_path"
		rf_dst="$ROOT/$rf_rel"
		[ -f "$rf_src" ] || die "snapshot file missing: $rf_rel"
		mkdir -p "$(dirname "$rf_dst")" || die "cannot create parent for $rf_rel"
		rf_tmp=$(mktemp "$(dirname "$rf_dst")/.sane-rel.XXXXXX") || die "cannot stage $rf_rel"
		cp -p "$rf_src" "$rf_tmp" || { rm -f "$rf_tmp"; die "cannot copy $rf_rel"; }
		mv "$rf_tmp" "$rf_dst" || { rm -f "$rf_tmp"; die "cannot install $rf_rel"; }
	done < "$rf_dir/manifest.sha256"
	# Delete files the upgrade introduced (recorded in new-files), so a
	# rollback/recover leaves the filesystem consistent with the snapshot.
	# Deletion honours symlink containment: never rm through an escaping link.
	if [ -f "$rf_dir/new-files" ]; then
		while IFS= read -r rf_new; do
			[ -n "$rf_new" ] || continue
			valid_rel_path "$rf_new" || die "unsafe new-file path: $rf_new"
			symlink_safe_rel "$rf_new" || die "new-file symlink escapes root: $rf_new"
			rm -f "$ROOT/$rf_new"
		done < "$rf_dir/new-files"
	fi
	# Recreate recorded symlinks (type + target preserved). The metadata is
	# a regular manifest entry, so its integrity is already verified; each
	# path and target is still validated fail-closed before installation.
	if [ -f "$rf_dir/symlinks" ]; then
		while IFS= read -r rf_lpath; do
			IFS= read -r rf_ltarget || die "malformed symlinks metadata in $rf_dir"
			valid_rel_path "$rf_lpath" || die "unsafe symlink path: $rf_lpath"
			symlink_safe_rel "$rf_lpath" || die "symlink destination escapes root: $rf_lpath"
			symlink_target_inside "$rf_lpath" "$rf_ltarget" || \
				die "symlink target escapes root: $rf_lpath -> $rf_ltarget"
			rf_ldst="$ROOT/$rf_lpath"
			mkdir -p "$(dirname "$rf_ldst")" || die "cannot create parent for $rf_lpath"
			# Stage the link NEXT TO its destination, then rename it over
			# the live path. The destination is never removed first: a
			# failing ln leaves it exactly as it was. '--' keeps a target
			# starting with '-' from being parsed as an ln option; this is
			# portable to dash/ash and their ln/mv applets.
			rf_ltmp=$(mktemp -u "$(dirname "$rf_ldst")/.sane-rel-ln.XXXXXX") || \
				die "cannot stage symlink: $rf_lpath"
			ln -s -- "$rf_ltarget" "$rf_ltmp" || \
				{ rm -f -- "$rf_ltmp"; die "cannot recreate symlink: $rf_lpath"; }
			mv -fT -- "$rf_ltmp" "$rf_ldst" || \
				{ rm -f -- "$rf_ltmp"; die "cannot install symlink: $rf_lpath"; }
		done < "$rf_dir/symlinks"
	fi
}

cmd_rollback() {
	[ "$#" -eq 1 ] || die "usage: rollback TAG"
	cmd_init
	tag=$1
	check_snapshot "$tag"
	case "$tag" in
		auto-pre-rollback-*) ;;
		*)
			safety=$(unique_tag "auto-pre-rollback-$(date -u '+%Y%m%dT%H%M%SZ')")
			do_snapshot "$safety" 0 || die "cannot create safety snapshot"
			;;
	esac
	restore_files_from "$SNAPS/$tag"
	write_journal rolled-back "$tag"
	log_event INFO "rollback to $tag completed"
	note "rolled back to '$tag'"
}

recover_internal() {
	state=$(journal_get state)
	case "$state" in
		net-in-progress)
			nr_iface=$(journal_get net-iface)
			valid_iface "$nr_iface" || \
				net_recover_fail "interrupted network recovery has invalid interface: ${nr_iface:-missing}"
			cmd_net_recover --iface "$nr_iface"
			;;
		in-progress)
			tag=$(journal_get snapshot)
			if [ -z "$tag" ]; then
				# Legacy CLI wrote network recovery as plain in-progress.
				nr_iface=$(journal_get net-iface)
				if [ -z "$nr_iface" ]; then
					log_event WARN "legacy journal missing net-iface, defaulting to eth0"
					nr_iface=eth0
				else
					valid_iface "$nr_iface" || \
						net_recover_fail "legacy network recovery has invalid interface: $nr_iface"
				fi
				log_event WARN "migrating legacy in-progress network journal for $nr_iface"
				cmd_net_recover --iface "$nr_iface"
			else
				check_snapshot "$tag"
				restore_files_from "$SNAPS/$tag"
				write_journal recovered "$tag"
				log_event WARN "recovered from interrupted upgrade using $tag"
				note "recovered using '$tag'"
			fi
			;;
		*)
			log_event INFO "no interrupted upgrade or network recovery"
			return 0
			;;
	esac
}

cmd_recover() {
	cmd_init
	recover_internal
}

valid_iface() {
	case "$1" in
		''|-*|*[!A-Za-z0-9_.-]*) return 1 ;;
	esac
	[ "${#1}" -le 15 ]
}

net_recover_fail() {
	# Keep the network journal intact so a later recovery can retry.
	log_event ERROR "$1" || true
	die "$1"
}

cmd_net_recover() {
	nr_iface=eth0
	case "$ROOT" in
		/*) ;;
		*) die "--root must be an absolute path" ;;
	esac
	case "$#" in
		0) ;;
		2)
			[ "$1" = "--iface" ] || die "usage: net-recover [--iface IFACE]"
			nr_iface=$2
			;;
		*) die "usage: net-recover [--iface IFACE]" ;;
	esac
	valid_iface "$nr_iface" || die "invalid network interface: $nr_iface"
	cmd_init
	log_event INFO "network recovery started for $nr_iface"
	write_journal net-in-progress "" "$nr_iface"

	nr_resolv="$ROOT/etc/resolv.conf"
	nr_default="$ROOT/etc/resolv.conf.default"
	nr_dir=$(dirname "$nr_resolv")
	[ -f "$nr_default" ] || net_recover_fail "default resolver is missing: $nr_default"
	[ -d "$nr_dir" ] || net_recover_fail "resolver directory is missing: $nr_dir"
	nr_tmp=$(mktemp "$nr_dir/.sane-net-recover.XXXXXX") || \
		net_recover_fail "cannot stage default resolver in $nr_dir"
	if ! cat "$nr_default" > "$nr_tmp"; then
		rm -f "$nr_tmp"
		net_recover_fail "cannot read default resolver: $nr_default"
	fi
	if ! chmod 0644 "$nr_tmp"; then
		rm -f "$nr_tmp"
		net_recover_fail "cannot set resolver mode in $nr_dir"
	fi
	if ! mv "$nr_tmp" "$nr_resolv"; then
		rm -f "$nr_tmp"
		net_recover_fail "cannot install default resolver: $nr_resolv"
	fi

	if ! SANE_ROOT="$ROOT" sane-net reconnect "$nr_iface"; then
		net_recover_fail "sane-net reconnect failed for $nr_iface"
	fi
	if ! SANE_ROOT="$ROOT" sane-net check "$nr_iface"; then
		net_recover_fail "sane-net check failed for $nr_iface"
	fi
	write_journal recovered "" "$nr_iface"
	log_event INFO "network recovery completed for $nr_iface"
	note "network recovered on $nr_iface"
}

cmd_upgrade() {
	[ "$#" -eq 1 ] || die "usage: upgrade PAYLOAD_DIR"
	payload=$1
	[ -d "$payload" ] || die "payload directory not found: $payload"
	[ -f "$payload/manifest.sha256" ] || die "payload has no manifest.sha256"
	cmd_init
	# Verify-at-use (F4): read the manifest ONCE into a staged copy and let
	# every consumer (pre-check, validation, path-list builder, apply loop)
	# use that same copy. A same-user writer swapping payload/manifest.sha256
	# after this point cannot redirect the upgrade; payload file contents
	# are re-hashed again immediately before each install below.
	up_stage=$(mktemp -d "$STAGING/.upgrade.XXXXXX") || die "cannot stage upgrade manifest"
	cp "$payload/manifest.sha256" "$up_stage/manifest.sha256" || \
		{ rm -rf -- "$up_stage"; die "cannot stage upgrade manifest"; }
	# Clean the staged dir on EVERY exit path (die, set -e, signals, success);
	# release_lock stays part of the EXIT trap owned by the dispatcher.
	trap 'rm -rf -- "$up_stage"; release_lock' EXIT
	# Fast-fail pre-check against the staged manifest (legacy error contract).
	(cd "$payload" && sha256sum -c "$up_stage/manifest.sha256" >/dev/null 2>&1) || \
		die "payload integrity check failed"
	validate_manifest "$up_stage"
	check_dest_symlinks "$up_stage"
	up_extra=$(mktemp "$STAGING/.upgrade-paths.XXXXXX") || die "cannot stage upgrade path list"
	while IFS= read -r upe_line; do
		[ -n "$upe_line" ] || continue
		upe_path=$(printf '%s\n' "$upe_line" | sed 's/^[^ ]*  //')
		case "$upe_path" in
			./manifest.sha256|./meta|'') continue ;;
		esac
		upe_rel=${upe_path#./}
		valid_rel_path "$upe_rel" || { rm -f "$up_extra"; die "unsafe manifest path: $upe_path"; }
		# Self-state protection (D7): an upgrade payload may not target the
		# reliability state (journal/snapshots) or the tool itself. This
		# restricts PAYLOAD targets only; the internal snapshot extra-list /
		# new-files mechanism in do_snapshot is deliberately not blocked.
		case "$upe_rel" in
			var/lib/sane/reliability|var/lib/sane/reliability/*|usr/bin/sane-reliability)
				rm -f "$up_extra"
				die "payload targets protected reliability state: $upe_rel" ;;
		esac
		printf '%s\n' "$upe_rel" >> "$up_extra"
	done < "$up_stage/manifest.sha256"
	tag=$(unique_tag "auto-pre-upgrade-$(date -u '+%Y%m%dT%H%M%SZ')")
	do_snapshot "$tag" 0 "$up_extra" || { rm -f "$up_extra"; die "cannot create pre-upgrade snapshot"; }
	rm -f "$up_extra"
	write_journal in-progress "$tag"
	# Fault hook (test-only, same pattern as sane-net's SANE_NET_FAULT):
	# exact match against ${SANE_RELIABILITY_FAULT:-}; any other value or
	# unset is a complete no-op. Simulates a same-user writer mutating one
	# payload file AFTER the pre-check; the apply loop's re-hash must catch
	# it. Writes only into the payload directory, never into tool state.
	if [ "${SANE_RELIABILITY_FAULT:-}" = payload-swap ]; then
		printf '%s: fault injection: payload-swap\n' "$PROG" >&2
		fs_path=
		while IFS= read -r fs_line; do
			[ -n "$fs_line" ] || continue
			fs_path=$(printf '%s\n' "$fs_line" | sed 's/^[^ ]*  //')
			case "$fs_path" in
				./manifest.sha256|./meta|'') continue ;;
			esac
			break
		done < "$up_stage/manifest.sha256"
		[ -n "$fs_path" ] || die "payload-swap fault found no payload file"
		printf 'fault-swap\n' >> "$payload/$fs_path"
	fi
	while IFS= read -r up_line; do
		[ -n "$up_line" ] || continue
		up_hash=${up_line%%  *}
		up_path=$(printf '%s\n' "$up_line" | sed 's/^[^ ]*  //')
		case "$up_path" in
			./manifest.sha256|./meta|'') continue ;;
		esac
		up_rel=${up_path#./}
		valid_rel_path "$up_rel" || die "unsafe manifest path: $up_path"
		up_src="$payload/$up_path"
		up_dst="$ROOT/$up_rel"
		[ -f "$up_src" ] || { recover_internal || true; die "payload file missing: $up_rel"; }
		# Re-hash immediately before copy: the pre-check is a fast-fail, not
		# a guarantee about the bytes present at install time.
		up_actual=$(sha256sum "$up_src") || { recover_internal || true; die "cannot re-hash payload file: $up_rel"; }
		[ "${up_actual%% *}" = "$up_hash" ] || \
			{ recover_internal || true; die "payload changed during upgrade: $up_rel"; }
		# Re-check containment immediately before install as well.
		symlink_safe_rel "$up_rel" || \
			{ recover_internal || true; die "destination symlink escapes root: $up_rel"; }
		mkdir -p "$(dirname "$up_dst")" || { recover_internal || true; die "cannot create parent for $up_rel"; }
		up_tmp=$(mktemp "$(dirname "$up_dst")/.sane-rel.XXXXXX") || { recover_internal || true; die "cannot stage $up_rel"; }
		# Late-swap fault hook (exact match, no-op for any other value):
		# mutate the payload source AFTER its hash was verified and BEFORE
		# cp, so only hashing the private staged copy can detect the change.
		# Writes only into the test-owned payload directory.
		if [ "${SANE_RELIABILITY_FAULT:-}" = payload-swap-late ]; then
			printf '%s: fault injection: payload-swap-late\n' "$PROG" >&2
			printf 'fault-swap-late\n' >> "$up_src"
		fi
		cp -p "$up_src" "$up_tmp" || { rm -f "$up_tmp"; recover_internal || true; die "cannot copy $up_rel"; }
		# Verify the bytes actually staged, not just the source we copied.
		up_tmp_hash=$(sha256sum "$up_tmp") || \
			{ rm -f "$up_tmp"; recover_internal || true; die "cannot re-hash staged file: $up_rel"; }
		[ "${up_tmp_hash%% *}" = "$up_hash" ] || \
			{ rm -f "$up_tmp"; recover_internal || true; die "payload changed during upgrade: $up_rel"; }
		mv "$up_tmp" "$up_dst" || { rm -f "$up_tmp"; recover_internal || true; die "cannot install $up_rel"; }
	done < "$up_stage/manifest.sha256"
	rm -rf -- "$up_stage"
	write_journal 'done' "$tag"
	log_event INFO "upgrade committed with pre-upgrade snapshot $tag"
	note "upgrade committed (rollback tag: $tag)"
}

cmd_log() {
	[ "$#" -ge 2 ] || die "usage: log LEVEL MESSAGE"
	level=$1; shift
	case "$level" in
		INFO|WARN|ERROR) ;;
		*) die "invalid log level: $level" ;;
	esac
	[ -n "$*" ] || die "log message must not be empty"
	cmd_init
	log_event "$level" "$*"
}

cmd_backup() {
	[ "$#" -ge 1 ] || die "usage: backup ARCHIVE [--force]"
	archive=$1; shift
	force=0
	for arg in "$@"; do
		case "$arg" in
			--force) force=1 ;;
			*) die "unknown backup option: $arg" ;;
		esac
	done
	cmd_init
	[ -e "$archive" ] && [ "$force" -ne 1 ] && die "archive already exists: $archive"
	# The lock is process-local runtime state, never backup material: list
	# persistent members EXPLICITLY so lock/ and lock.stale.* are excluded by
	# construction. The shipped BusyBox tar has no --exclude/-X support, and
	# enumerating members works with both GNU tar and BusyBox tar. Every
	# member below exists after cmd_init. NEW persistent state MUST be added
	# to this list AND documented in doc/reliability.md (Backup and restore).
	tar -czf "$archive" -C "$ROOT" \
		var/lib/sane/reliability/snapshots \
		var/lib/sane/reliability/staging \
		var/lib/sane/reliability/journal \
		var/log/sane 2>/dev/null || die "cannot create archive"
	[ -s "$archive" ] || die "archive is empty"
	note "backup written to $archive"
}

restore_link_safe() {
	# restore_link_safe LINK -- fail closed if LINK's target is absolute or
	# its resolved chain leaves the restore staging root (rt_tmp). Walks the
	# chain with a bounded hop count like symlink_safe_rel; internal relative
	# chains (including '..' that normalizes back inside rt_tmp) are allowed.
	rls_cur=$1
	rls_hops=0
	while [ -L "$rls_cur" ]; do
		rls_hops=$((rls_hops + 1))
		[ "$rls_hops" -le 40 ] || return 1
		rls_target=$(readlink "$rls_cur" 2>/dev/null) || return 1
		case "$rls_target" in
			/*) return 1 ;;
			*) rls_cur="$(dirname "$rls_cur")/$rls_target" ;;
		esac
		rls_cur=$(normalize_path "$rls_cur") || return 1
		case "$rls_cur/" in
			"$rt_tmp/"*) ;;
			*) return 1 ;;
		esac
	done
	return 0
}

cmd_restore() {
	[ "$#" -eq 1 ] || die "usage: restore ARCHIVE"
	archive=$1
	[ -f "$archive" ] || die "archive not found: $archive"
	rt_tmp=$(mktemp -d) || die "cannot create restore staging dir"
	# Validate member names BEFORE extraction so a traversal entry cannot
	# write outside the staging directory.
	tar -tzf "$archive" > "$rt_tmp/members" 2>/dev/null || \
		{ rm -rf -- "$rt_tmp"; die "cannot read archive"; }
	while IFS= read -r rt_member; do
		[ -n "$rt_member" ] || continue
		case "$rt_member" in
			/*|..|../*|*/..|*../*) \
				{ rm -rf -- "$rt_tmp"; die "unsafe archive member: $rt_member"; } ;;
		esac
	done < "$rt_tmp/members"
	tar -xzf "$archive" -C "$rt_tmp" 2>/dev/null || \
		{ rm -rf -- "$rt_tmp"; die "cannot extract archive"; }
	# Archives made by old tool versions still carry the backup holder's
	# lock/ (and lock.stale.* crash residue). Never restore lock state: strip
	# every lock* entry from staging right after extraction, before any
	# validation or install. The LIVE restore lock lives under the target
	# root (not staging), so it is untouched and release_lock still sees $$.
	for rt_lock in "$rt_tmp/var/lib/sane/reliability/lock"*; do
		[ -e "$rt_lock" ] || [ -L "$rt_lock" ] || continue
		rm -rf -- "$rt_lock"
	done
	[ -d "$rt_tmp/var/lib/sane/reliability/snapshots" ] || \
		{ rm -rf -- "$rt_tmp"; die "archive has no reliability snapshots"; }
	# Reject absolute targets and symlink chains that leave the staging root
	# before anything is installed. Each chain is walked with a bounded hop
	# count (like symlink_safe_rel); internal relative chains, including '..'
	# that normalizes back inside the staging root, are allowed.
	find "$rt_tmp" -type l -print > "$rt_tmp/links"
	while IFS= read -r rt_link; do
		[ -n "$rt_link" ] || continue
		restore_link_safe "$rt_link" || \
			{ rm -rf -- "$rt_tmp"; die "unsafe symlink chain in archive: $rt_link"; }
	done < "$rt_tmp/links"
	# Verify every snapshot manifest found in the archive.
	find "$rt_tmp/var/lib/sane/reliability/snapshots" -name manifest.sha256 -print > "$rt_tmp/manifests"
	while IFS= read -r rt_manifest; do
		[ -n "$rt_manifest" ] || continue
		rt_dir=$(dirname "$rt_manifest")
		validate_manifest "$rt_dir" || { rm -rf -- "$rt_tmp"; die "invalid archive manifest"; }
		(cd "$rt_dir" && sha256sum -c manifest.sha256 >/dev/null 2>&1) || \
			{ rm -rf -- "$rt_tmp"; die "archive manifest verification failed"; }
	done < "$rt_tmp/manifests"
	mkdir -p "$STATE" "$LOGDIR"
	cp -a "$rt_tmp/var/lib/sane/reliability/." "$STATE/" || \
		{ rm -rf -- "$rt_tmp"; die "cannot restore state"; }
	cp -a "$rt_tmp/var/log/sane/." "$LOGDIR/" || \
		{ rm -rf -- "$rt_tmp"; die "cannot restore logs"; }
	# Never trust the archived journal: an archive captured mid-upgrade carries
	# state=in-progress + snapshot=X, and the next recover would force a
	# rollback to X over the freshly restored state. Restore is a terminal
	# operation: force the journal to idle (state only, no tag or interface).
	write_journal idle || \
		{ rm -rf -- "$rt_tmp"; die "cannot reset journal after restore"; }
	rm -rf -- "$rt_tmp"
	log_event INFO "archive restored"
	note "archive restored into $ROOT"
}

heal_snapshot_swaps() {
	# Complete or discard interrupted --force swaps. Called ONLY while the
	# state lock is held (every command entry acquires it, including
	# recover's boot path), so every .old.<tag> aside and .tmp.* staging dir
	# here is crash residue: the exclusive lock guarantees no live writer
	# owns them.
	for hs_old in "$SNAPS"/.old.*; do
		[ -d "$hs_old" ] || continue
		hs_tag=${hs_old##*/}
		hs_tag=${hs_tag#.old.}
		case "$hs_tag" in
			''|.|..) rm -rf -- "$hs_old"; continue ;;
		esac
		if ! valid_tag "$hs_tag"; then
			rm -rf -- "$hs_old"
			continue
		fi
		if [ -d "$SNAPS/$hs_tag" ]; then
			# Install completed before the crash: the aside is redundant.
			rm -rf -- "$hs_old"
		else
			# Install never happened: restore the old snapshot.
			mv "$hs_old" "$SNAPS/$hs_tag" || \
				die "cannot heal interrupted snapshot swap: $hs_tag"
		fi
	done
	for hs_tmp in "$SNAPS"/.tmp.*; do
		[ -d "$hs_tmp" ] || continue
		rm -rf -- "$hs_tmp"
	done
}

release_lock() {
	# EXIT-trap release, owned by the top-level acquisition only. Remove the
	# lock only if this process still owns it (lock/pid == $$); a lock stolen
	# or held by anyone else is never touched.
	lk_rel_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
	if [ "$lk_rel_pid" = "$$" ]; then
		rm -rf -- "$LOCK_DIR"
	fi
}

acquire_lock() {
	# Atomic mkdir lock for ALL commands (every command writes or auto-inits
	# state, so all writes happen under the lock), acquired ONLY at the
	# top-level dispatcher entry. Nested calls in the same process (recover
	# -> cmd_net_recover, rollback/upgrade -> do_snapshot, every command ->
	# cmd_init) never re-acquire: the pid check below makes the lock
	# reentrant by pid, and the EXIT-trap release belongs to the top-level
	# acquisition alone.
	#
	# Stale handling: a lock whose pid is dead (kill -0 fails) or garbage is
	# stolen via an atomic mv aside; the mv loser loops and re-evaluates.
	# A pidless lock gets a 1s grace (the holder may be between mkdir and the
	# pid write) before it is treated as crash residue and stolen.
	#
	# Limits (documented in doc/reliability.md): stale detection is kill -0
	# based, so a REUSED pid of a dead holder can look alive and delay
	# acquisition up to the timeout (fail-closed, never a wrongful steal of a
	# live same-user holder); kill -0 also fails with EPERM across users, so
	# the tool assumes single-user/root operation on the state it protects.
	LOCK_TIMEOUT=${SANE_RELIABILITY_LOCK_TIMEOUT:-30}
	case "$LOCK_TIMEOUT" in
		''|*[!0-9]*|0) die "invalid SANE_RELIABILITY_LOCK_TIMEOUT: $LOCK_TIMEOUT" ;;
	esac
	lk_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
	[ "$lk_pid" = "$$" ] && return 0
	mkdir -p "$STATE" || die "cannot create reliability state for locking"
	lk_tries=0
	lk_empty=0
	lk_max=$((LOCK_TIMEOUT * 10))
	while ! mkdir "$LOCK_DIR" 2>/dev/null; do
		lk_tries=$((lk_tries + 1))
		[ "$lk_tries" -le "$lk_max" ] || \
			die "timed out waiting for reliability lock: $LOCK_DIR"
		lk_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
		[ "$lk_pid" = "$$" ] && return 0
		lk_stale=0
		case "$lk_pid" in
			'') lk_empty=$((lk_empty + 1))
			    [ "$lk_empty" -ge 10 ] && lk_stale=1 ;;
			*[!0-9]*) lk_stale=1 ;;
			*) lk_empty=0
			   kill -0 "$lk_pid" 2>/dev/null || lk_stale=1 ;;
		esac
		if [ "$lk_stale" = 1 ]; then
			if mv "$LOCK_DIR" "$LOCK_DIR.stale.$$" 2>/dev/null; then
				rm -rf -- "$LOCK_DIR.stale.$$"
			else
				sleep 0.1
			fi
		else
			sleep 0.1
		fi
	done
	printf '%s\n' "$$" > "$LOCK_DIR/pid"
	trap release_lock EXIT
	trap 'exit 1' HUP INT TERM
	heal_snapshot_swaps
}

case "$CMD" in
	init|list|verify|log|snapshot|rollback|upgrade|recover|net-recover|backup|restore)
		# Internal state containment (P1-2): validate every self-owned
		# state/log path for escaping symlinks BEFORE acquire_lock's mkdir
		# and before any command's first write. Covers all commands and,
		# because nested recovery runs in this same process, every internal
		# recovery path too. Rejection creates no lock, dir or file.
		validate_internal_state
		# ALL commands serialize on the state lock: init/list/verify/log
		# auto-init and write state too, so every write happens under the
		# lock. Read commands (list/verify) may block up to the lock timeout
		# while a mutator holds it. Acquisition happens only here, at the
		# top-level entry; the EXIT-trap release belongs to this acquisition
		# alone. Nested calls within the process reuse the held lock
		# (reentrant by pid) and never re-acquire or release it.
		acquire_lock
		case "$CMD" in
			init)        cmd_init "$@" ;;
			list)        cmd_list "$@" ;;
			verify)      cmd_verify "$@" ;;
			log)         cmd_log "$@" ;;
			snapshot)    cmd_snapshot "$@" ;;
			rollback)    cmd_rollback "$@" ;;
			upgrade)     cmd_upgrade "$@" ;;
			recover)     cmd_recover "$@" ;;
			net-recover) cmd_net_recover "$@" ;;
			backup)      cmd_backup "$@" ;;
			restore)     cmd_restore "$@" ;;
		esac
		;;
	*) usage >&2; die "unknown command: $CMD" ;;
esac
