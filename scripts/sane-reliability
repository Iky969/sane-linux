#!/bin/sh
# sane-reliability -- Phase C system reliability toolkit.
#
# Host-side POSIX sh tool that operates on a target rootfs (--root DIR).
# Provides snapshots, verified rollback, staged upgrades, journal-driven
# recovery, structured logging and backup/restore. Fail-closed: a malformed
# or unverifiable input never modifies the target.
set -eu

PROG=${0##*/}
ROOT=/
VERBOSE=0

STATE_FILES="etc/passwd etc/group etc/shadow etc/doas.conf etc/init.conf etc/fstab etc/hostname"

usage() {
	cat <<EOF
Usage: $PROG [--root DIR] <command> [args]

Commands:
  init                          create state dirs and idle journal
  snapshot TAG [--force]        capture verified state snapshot
  list                          list snapshots
  verify TAG                    verify snapshot integrity
  rollback TAG                  restore a verified snapshot
  upgrade PAYLOAD_DIR           verify, snapshot, then commit a payload
  recover                       roll back an interrupted upgrade
  net-recover [--iface IFACE]   restore default DNS and reconnect networking
  log LEVEL MESSAGE             append a structured log entry
  backup ARCHIVE [--force]      archive snapshots, journal and logs
  restore ARCHIVE               restore an archive into a target root
EOF
}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
note() { [ "$VERBOSE" -eq 1 ] && printf 'ok: %s\n' "$*"; return 0; }

canonicalize_root() {
	# Resolve ROOT to a canonical physical path with cd -P + pwd (POSIX, no
	# realpath dependency). A brand-new root may not exist yet (D4: init
	# creates it): resolve the nearest existing ancestor physically, then walk
	# the remaining tail component by component, expanding symlinks with a
	# bounded hop count so the canonical path never traverses a link (a
	# dangling root symlink resolves to its absent target). Nothing is created
	# here, so malformed commands still fail before any write.
	cr_path=$ROOT
	while [ "${cr_path%/}" != "$cr_path" ]; do cr_path=${cr_path%/}; done
	[ -n "$cr_path" ] || cr_path=/
	cr_tail=
	while [ ! -d "$cr_path" ]; do
		cr_tail="/${cr_path##*/}$cr_tail"
		cr_path=${cr_path%/*}
		[ -n "$cr_path" ] || cr_path=/
	done
	cr_base=$(cd -P "$cr_path" && pwd) || die "cannot resolve --root: $ROOT"
	cr_rest=${cr_tail#/}
	cr_hops=0
	while [ -n "$cr_rest" ]; do
		case "$cr_rest" in
			*/*) cr_comp=${cr_rest%%/*}; cr_rest=${cr_rest#*/} ;;
			*) cr_comp=$cr_rest; cr_rest= ;;
		esac
		case "$cr_comp" in
			''|.) continue ;;
			..) cr_base=${cr_base%/*}; [ -n "$cr_base" ] || cr_base=/; continue ;;
		esac
		if [ -L "$cr_base/$cr_comp" ]; then
			cr_hops=$((cr_hops + 1))
			[ "$cr_hops" -le 40 ] || die "too many symlink hops in --root: $ROOT"
			cr_target=$(readlink "$cr_base/$cr_comp" 2>/dev/null) || \
				die "cannot read root symlink: $cr_base/$cr_comp"
			[ -n "$cr_target" ] || die "empty root symlink target: $cr_base/$cr_comp"
			case "$cr_target" in
				/*) cr_base=/; cr_rest="${cr_target#/}/$cr_rest" ;;
				*) cr_rest="$cr_target/$cr_rest" ;;
			esac
			continue
		fi
		cr_base="$cr_base/$cr_comp"
	done
	ROOT=$cr_base
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		--root) [ "$#" -ge 2 ] || die "--root needs a directory"; ROOT=$2; shift 2 ;;
		-v|--verbose) VERBOSE=1; shift ;;
		-h|--help) usage; exit 0 ;;
		--) shift; break ;;
		-*) die "unknown option: $1" ;;
		*) break ;;
	esac
done

[ "$#" -ge 1 ] || { usage >&2; exit 1; }
CMD=$1; shift

case "$ROOT" in
	/*) ;;
	*) die "--root must be an absolute path" ;;
esac
canonicalize_root

STATE="$ROOT/var/lib/sane/reliability"
SNAPS="$STATE/snapshots"
STAGING="$STATE/staging"
JOURNAL="$STATE/journal"
LOCK_DIR="$STATE/lock"
LOGDIR="$ROOT/var/log/sane"
LOGFILE="$LOGDIR/reliability.log"
MAX_LOG_BYTES=65536

valid_tag() {
	case "$1" in
		''|*[!A-Za-z0-9._-]*) return 1 ;;
		-*) return 1 ;;
	esac
	[ "${#1}" -le 64 ]
}

cmd_init() {
	mkdir -p "$SNAPS" "$STAGING" "$LOGDIR" || die "cannot create reliability state"
	chmod 0755 "$SNAPS" "$STAGING" "$LOGDIR"
	[ -f "$JOURNAL" ] || printf 'state=idle\n' > "$JOURNAL"
	chmod 0600 "$JOURNAL"
	[ -f "$LOGFILE" ] || : > "$LOGFILE"
	chmod 0644 "$LOGFILE"
	note "reliability state initialised in $STATE"
}

valid_rel_path() {
	# Reject absolute paths, '..' components and NUL/backslash tricks.
	case "$1" in
		''|.|/*|*'\'*|*..*) return 1 ;;
	esac
	case "/$1/" in
		*/../*) return 1 ;;
	esac
	return 0
}

normalize_path() {
	# normalize_path ABS -- collapse '.' and '..' components of an absolute
	# path using pure POSIX parameter expansion (no GNU realpath dependency).
	np_in=$1
	case "$np_in" in /*) ;; *) return 1 ;; esac
	np_out=
	np_rest=${np_in#/}
	while [ -n "$np_rest" ]; do
		case "$np_rest" in
			*/*) np_comp=${np_rest%%/*}; np_rest=${np_rest#*/} ;;
			*) np_comp=$np_rest; np_rest= ;;
		esac
		case "$np_comp" in
			''|.) continue ;;
			..) np_out=${np_out%/*} ;;
			*) np_out="$np_out/$np_comp" ;;
		esac
	done
	printf '%s\n' "${np_out:-/}"
}

symlink_safe_rel() {
	# symlink_safe_rel REL -- fail closed if any component of ROOT/REL is a
	# symlink whose resolution leaves ROOT. Walks each component physically,
	# resolving symlink chains with readlink and a bounded hop count, and
	# requires every resolved path to stay under ROOT. Internal-root symlinks
	# are allowed. REL must already pass valid_rel_path (no '..'/absolute).
	ssr_rel=$1
	ssr_root=$ROOT
	while [ "${ssr_root%/}" != "$ssr_root" ]; do ssr_root=${ssr_root%/}; done
	ssr_cur=$ssr_root
	ssr_rest=$ssr_rel
	while [ -n "$ssr_rest" ]; do
		case "$ssr_rest" in
			*/*) ssr_comp=${ssr_rest%%/*}; ssr_rest=${ssr_rest#*/} ;;
			*) ssr_comp=$ssr_rest; ssr_rest= ;;
		esac
		[ -n "$ssr_comp" ] || continue
		ssr_cur="$ssr_cur/$ssr_comp"
		ssr_hops=0
		while [ -L "$ssr_cur" ]; do
			ssr_hops=$((ssr_hops + 1))
			[ "$ssr_hops" -le 40 ] || return 1
			ssr_target=$(readlink "$ssr_cur" 2>/dev/null) || return 1
			case "$ssr_target" in
				/*) ssr_cur=$ssr_target ;;
				*) ssr_cur="$(dirname "$ssr_cur")/$ssr_target" ;;
			esac
			ssr_cur=$(normalize_path "$ssr_cur") || return 1
			case "$ssr_cur/" in
				"$ssr_root/"*) ;;
				*) return 1 ;;
			esac
		done
	done
	return 0
}

check_dest_symlinks() {
	# check_dest_symlinks DIR -- pre-pass over a manifest: reject before any
	# write if a destination would traverse a symlink escaping ROOT.
	cds_dir=$1
	while IFS= read -r cds_line; do
		[ -n "$cds_line" ] || continue
		cds_path=$(printf '%s\n' "$cds_line" | sed 's/^[^ ]*  //')
		case "$cds_path" in
			./meta|./manifest.sha256|./new-files|'') continue ;;
		esac
		cds_rel=${cds_path#./}
		valid_rel_path "$cds_rel" || die "unsafe manifest path: $cds_path"
		symlink_safe_rel "$cds_rel" || die "destination symlink escapes root: $cds_rel"
	done < "$cds_dir/manifest.sha256"
}

validate_manifest() {
	# validate_manifest DIR -- fail closed before hashing or applying entries
	vm_dir=$1
	[ -f "$vm_dir/manifest.sha256" ] || die "manifest missing in $vm_dir"
	while IFS= read -r vm_line; do
		[ -n "$vm_line" ] || continue
		vm_path=$(printf '%s\n' "$vm_line" | sed 's/^[^ ]*  //')
		case "$vm_path" in
			./meta|./manifest.sha256|./new-files|'') continue ;;
		esac
		vm_rel=${vm_path#./}
		valid_rel_path "$vm_rel" || die "unsafe manifest path: $vm_path"
	done < "$vm_dir/manifest.sha256"
}

write_manifest() {
	# write_manifest DIR -- NUL-delimited so spaced names survive
	dir=$1
	(cd "$dir" && find . -type f ! -name manifest.sha256 -print0 | \
		LC_ALL=C sort -z | xargs -0 -r sha256sum) > "$dir/manifest.sha256"
}

unique_tag() {
	# unique_tag PREFIX -- never collide, even twice in the same second
	ut_prefix=$1; ut_n=0; ut_candidate=$ut_prefix
	while [ -e "$SNAPS/$ut_candidate" ]; do
		ut_n=$((ut_n + 1)); ut_candidate="$ut_prefix-$ut_n"
	done
	printf '%s\n' "$ut_candidate"
}

do_snapshot() {
	# do_snapshot TAG [force] [extra-list] -- internal, no logging. extra-list
	# is a file of relative payload target paths: existing targets are copied
	# into the snapshot; absent targets are recorded in new-files for deletion
	# on rollback/recover.
	ds_tag=$1; ds_force=${2:-0}; ds_extra=${3:-}
	valid_tag "$ds_tag" || die "invalid snapshot tag: $ds_tag"
	ds_target="$SNAPS/$ds_tag"
	[ -d "$ds_target" ] && [ "$ds_force" -ne 1 ] && die "snapshot already exists: $ds_tag"
	ds_tmp=$(mktemp -d "$SNAPS/.tmp.XXXXXX") || die "cannot create snapshot staging dir"
	[ -d "$ds_tmp" ] || die "mktemp did not create a directory"
	for rel in $STATE_FILES; do
		src="$ROOT/$rel"
		[ -f "$src" ] || continue
		mkdir -p "$ds_tmp/$(dirname "$rel")"
		cp -p "$src" "$ds_tmp/$rel" || { rm -rf -- "$ds_tmp"; die "cannot copy $rel"; }
	done
	if [ -d "$ROOT/var/lib/spm" ]; then
		mkdir -p "$ds_tmp/var/lib"
		cp -a "$ROOT/var/lib/spm" "$ds_tmp/var/lib/" || { rm -rf -- "$ds_tmp"; die "cannot copy spm DB"; }
	fi
	if [ -n "$ds_extra" ] && [ -f "$ds_extra" ]; then
		: > "$ds_tmp/new-files"
		while IFS= read -r ds_rel; do
			[ -n "$ds_rel" ] || continue
			valid_rel_path "$ds_rel" || { rm -rf -- "$ds_tmp"; die "unsafe snapshot path: $ds_rel"; }
			if [ -f "$ROOT/$ds_rel" ]; then
				mkdir -p "$ds_tmp/$(dirname "$ds_rel")"
				cp -p "$ROOT/$ds_rel" "$ds_tmp/$ds_rel" || { rm -rf -- "$ds_tmp"; die "cannot copy $ds_rel"; }
			else
				printf '%s\n' "$ds_rel" >> "$ds_tmp/new-files"
			fi
		done < "$ds_extra"
	fi
	printf 'timestamp=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$ds_tmp/meta"
	write_manifest "$ds_tmp" || { rm -rf -- "$ds_tmp"; die "cannot write manifest"; }
	# Swap atomically: rename the old snapshot aside, install the new one,
	# then delete the old one. A failed install restores the original. The
	# aside name is deterministic (.old.<tag>, tag already validated) so a
	# crash between the two renames is healable by heal_snapshot_swaps.
	if [ -d "$ds_target" ]; then
		ds_old="$SNAPS/.old.$ds_tag"
		[ -e "$ds_old" ] && rm -rf -- "$ds_old"
		if ! mv "$ds_target" "$ds_old"; then
			rm -rf -- "$ds_tmp"; die "cannot move old snapshot aside"
		fi
		if ! mv "$ds_tmp" "$ds_target"; then
			mv "$ds_old" "$ds_target" || true
			rm -rf -- "$ds_tmp"; die "cannot install snapshot $ds_tag"
		fi
		rm -rf -- "$ds_old" || true
	else
		mv "$ds_tmp" "$ds_target" || { rm -rf -- "$ds_tmp"; die "cannot install snapshot $ds_tag"; }
	fi
}

check_snapshot() {
	tag=$1
	dir="$SNAPS/$tag"
	[ -d "$dir" ] || die "no such snapshot: $tag"
	validate_manifest "$dir"
	(cd "$dir" && sha256sum -c manifest.sha256 >/dev/null 2>&1) || die "snapshot integrity check failed: $tag"
}

cmd_snapshot() {
	[ "$#" -ge 1 ] || die "usage: snapshot TAG [--force]"
	tag=$1; shift
	force=0
	for arg in "$@"; do
		case "$arg" in
			--force) force=1 ;;
			*) die "unknown snapshot option: $arg" ;;
		esac
	done
	cmd_init
	do_snapshot "$tag" "$force"
	note "snapshot '$tag' created"
}

cmd_list() {
	cmd_init
	printf 'TAG  CREATED\n'
	for dir in "$SNAPS"/*; do
		[ -d "$dir" ] || continue
		tag=${dir##*/}
		case "$tag" in .*) continue ;; esac
		ts=$(sed -n 's/^timestamp=//p' "$dir/meta" 2>/dev/null || true)
		printf '%-24s %s\n' "$tag" "${ts:-unknown}"
	done
}

cmd_verify() {
	[ "$#" -eq 1 ] || die "usage: verify TAG"
	cmd_init
	check_snapshot "$1"
	printf 'verified: %s\n' "$1"
}

write_journal() {
	# write_journal STATE [TAG] [IFACE] -- atomic, mode 0600
	st=$1; tag=${2:-}; journal_iface=${3:-}
	tmp=$(mktemp "$STATE/.journal.XXXXXX") || die "cannot create journal temp"
	printf 'state=%s\n' "$st" > "$tmp"
	[ -n "$tag" ] && printf 'snapshot=%s\n' "$tag" >> "$tmp"
	[ -n "$journal_iface" ] && printf 'net-iface=%s\n' "$journal_iface" >> "$tmp"
	printf 'timestamp=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "$tmp"
	mv "$tmp" "$JOURNAL"
	chmod 0600 "$JOURNAL"
}

journal_get() { sed -n "s/^$1=//p" "$JOURNAL" 2>/dev/null | head -n1; }

log_event() {
	# log_event LEVEL MESSAGE -- internal structured logger with rotation
	level=$1; shift
	[ -f "$LOGFILE" ] || : > "$LOGFILE"
	if [ -f "$LOGFILE" ]; then
		size=$(wc -c < "$LOGFILE" | tr -d ' ')
		if [ "${size:-0}" -ge "$MAX_LOG_BYTES" ]; then
			mv "$LOGFILE" "$LOGFILE.1" || true
			: > "$LOGFILE"
		fi
	fi
	printf '%s %s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$level" "$*" >> "$LOGFILE"
	chmod 0644 "$LOGFILE"
}

restore_files_from() {
	# restore_files_from DIR -- apply every manifest entry atomically
	rf_dir=$1
	validate_manifest "$rf_dir"
	check_dest_symlinks "$rf_dir"
	while IFS= read -r rf_line; do
		[ -n "$rf_line" ] || continue
		rf_path=$(printf '%s\n' "$rf_line" | sed 's/^[^ ]*  //')
		case "$rf_path" in
			./meta|./manifest.sha256|./new-files|'') continue ;;
		esac
		rf_rel=${rf_path#./}
		valid_rel_path "$rf_rel" || die "unsafe manifest path: $rf_path"
		rf_src="$rf_dir/$rf_path"
		rf_dst="$ROOT/$rf_rel"
		[ -f "$rf_src" ] || die "snapshot file missing: $rf_rel"
		mkdir -p "$(dirname "$rf_dst")" || die "cannot create parent for $rf_rel"
		rf_tmp=$(mktemp "$(dirname "$rf_dst")/.sane-rel.XXXXXX") || die "cannot stage $rf_rel"
		cp -p "$rf_src" "$rf_tmp" || { rm -f "$rf_tmp"; die "cannot copy $rf_rel"; }
		mv "$rf_tmp" "$rf_dst" || { rm -f "$rf_tmp"; die "cannot install $rf_rel"; }
	done < "$rf_dir/manifest.sha256"
	# Delete files the upgrade introduced (recorded in new-files), so a
	# rollback/recover leaves the filesystem consistent with the snapshot.
	# Deletion honours symlink containment: never rm through an escaping link.
	if [ -f "$rf_dir/new-files" ]; then
		while IFS= read -r rf_new; do
			[ -n "$rf_new" ] || continue
			valid_rel_path "$rf_new" || die "unsafe new-file path: $rf_new"
			symlink_safe_rel "$rf_new" || die "new-file symlink escapes root: $rf_new"
			rm -f "$ROOT/$rf_new"
		done < "$rf_dir/new-files"
	fi
}

cmd_rollback() {
	[ "$#" -eq 1 ] || die "usage: rollback TAG"
	cmd_init
	tag=$1
	check_snapshot "$tag"
	case "$tag" in
		auto-pre-rollback-*) ;;
		*)
			safety=$(unique_tag "auto-pre-rollback-$(date -u '+%Y%m%dT%H%M%SZ')")
			do_snapshot "$safety" 0 || die "cannot create safety snapshot"
			;;
	esac
	restore_files_from "$SNAPS/$tag"
	write_journal rolled-back "$tag"
	log_event INFO "rollback to $tag completed"
	note "rolled back to '$tag'"
}

recover_internal() {
	state=$(journal_get state)
	case "$state" in
		net-in-progress)
			nr_iface=$(journal_get net-iface)
			valid_iface "$nr_iface" || \
				net_recover_fail "interrupted network recovery has invalid interface: ${nr_iface:-missing}"
			cmd_net_recover --iface "$nr_iface"
			;;
		in-progress)
			tag=$(journal_get snapshot)
			if [ -z "$tag" ]; then
				# Legacy CLI wrote network recovery as plain in-progress.
				nr_iface=$(journal_get net-iface)
				if [ -z "$nr_iface" ]; then
					log_event WARN "legacy journal missing net-iface, defaulting to eth0"
					nr_iface=eth0
				else
					valid_iface "$nr_iface" || \
						net_recover_fail "legacy network recovery has invalid interface: $nr_iface"
				fi
				log_event WARN "migrating legacy in-progress network journal for $nr_iface"
				cmd_net_recover --iface "$nr_iface"
			else
				check_snapshot "$tag"
				restore_files_from "$SNAPS/$tag"
				write_journal recovered "$tag"
				log_event WARN "recovered from interrupted upgrade using $tag"
				note "recovered using '$tag'"
			fi
			;;
		*)
			log_event INFO "no interrupted upgrade or network recovery"
			return 0
			;;
	esac
}

cmd_recover() {
	cmd_init
	recover_internal
}

valid_iface() {
	case "$1" in
		''|-*|*[!A-Za-z0-9_.-]*) return 1 ;;
	esac
	[ "${#1}" -le 15 ]
}

net_recover_fail() {
	# Keep the network journal intact so a later recovery can retry.
	log_event ERROR "$1" || true
	die "$1"
}

cmd_net_recover() {
	nr_iface=eth0
	case "$ROOT" in
		/*) ;;
		*) die "--root must be an absolute path" ;;
	esac
	case "$#" in
		0) ;;
		2)
			[ "$1" = "--iface" ] || die "usage: net-recover [--iface IFACE]"
			nr_iface=$2
			;;
		*) die "usage: net-recover [--iface IFACE]" ;;
	esac
	valid_iface "$nr_iface" || die "invalid network interface: $nr_iface"
	cmd_init
	log_event INFO "network recovery started for $nr_iface"
	write_journal net-in-progress "" "$nr_iface"

	nr_resolv="$ROOT/etc/resolv.conf"
	nr_default="$ROOT/etc/resolv.conf.default"
	nr_dir=$(dirname "$nr_resolv")
	[ -f "$nr_default" ] || net_recover_fail "default resolver is missing: $nr_default"
	[ -d "$nr_dir" ] || net_recover_fail "resolver directory is missing: $nr_dir"
	nr_tmp=$(mktemp "$nr_dir/.sane-net-recover.XXXXXX") || \
		net_recover_fail "cannot stage default resolver in $nr_dir"
	if ! cat "$nr_default" > "$nr_tmp"; then
		rm -f "$nr_tmp"
		net_recover_fail "cannot read default resolver: $nr_default"
	fi
	if ! chmod 0644 "$nr_tmp"; then
		rm -f "$nr_tmp"
		net_recover_fail "cannot set resolver mode in $nr_dir"
	fi
	if ! mv "$nr_tmp" "$nr_resolv"; then
		rm -f "$nr_tmp"
		net_recover_fail "cannot install default resolver: $nr_resolv"
	fi

	if ! SANE_ROOT="$ROOT" sane-net reconnect "$nr_iface"; then
		net_recover_fail "sane-net reconnect failed for $nr_iface"
	fi
	if ! SANE_ROOT="$ROOT" sane-net check "$nr_iface"; then
		net_recover_fail "sane-net check failed for $nr_iface"
	fi
	write_journal recovered "" "$nr_iface"
	log_event INFO "network recovery completed for $nr_iface"
	note "network recovered on $nr_iface"
}

cmd_upgrade() {
	[ "$#" -eq 1 ] || die "usage: upgrade PAYLOAD_DIR"
	payload=$1
	[ -d "$payload" ] || die "payload directory not found: $payload"
	[ -f "$payload/manifest.sha256" ] || die "payload has no manifest.sha256"
	(cd "$payload" && sha256sum -c manifest.sha256 >/dev/null 2>&1) || die "payload integrity check failed"
	validate_manifest "$payload"
	check_dest_symlinks "$payload"
	cmd_init
	up_extra=$(mktemp "$STAGING/.upgrade-paths.XXXXXX") || die "cannot stage upgrade path list"
	while IFS= read -r upe_line; do
		[ -n "$upe_line" ] || continue
		upe_path=$(printf '%s\n' "$upe_line" | sed 's/^[^ ]*  //')
		case "$upe_path" in
			./manifest.sha256|./meta|'') continue ;;
		esac
		upe_rel=${upe_path#./}
		valid_rel_path "$upe_rel" || { rm -f "$up_extra"; die "unsafe manifest path: $upe_path"; }
		# Self-state protection (D7): an upgrade payload may not target the
		# reliability state (journal/snapshots) or the tool itself. This
		# restricts PAYLOAD targets only; the internal snapshot extra-list /
		# new-files mechanism in do_snapshot is deliberately not blocked.
		case "$upe_rel" in
			var/lib/sane/reliability|var/lib/sane/reliability/*|usr/bin/sane-reliability)
				rm -f "$up_extra"
				die "payload targets protected reliability state: $upe_rel" ;;
		esac
		printf '%s\n' "$upe_rel" >> "$up_extra"
	done < "$payload/manifest.sha256"
	tag=$(unique_tag "auto-pre-upgrade-$(date -u '+%Y%m%dT%H%M%SZ')")
	do_snapshot "$tag" 0 "$up_extra" || { rm -f "$up_extra"; die "cannot create pre-upgrade snapshot"; }
	rm -f "$up_extra"
	write_journal in-progress "$tag"
	while IFS= read -r up_line; do
		[ -n "$up_line" ] || continue
		up_path=$(printf '%s\n' "$up_line" | sed 's/^[^ ]*  //')
		case "$up_path" in
			./manifest.sha256|./meta|'') continue ;;
		esac
		up_rel=${up_path#./}
		valid_rel_path "$up_rel" || die "unsafe manifest path: $up_path"
		up_src="$payload/$up_path"
		up_dst="$ROOT/$up_rel"
		[ -f "$up_src" ] || { recover_internal || true; die "payload file missing: $up_rel"; }
		mkdir -p "$(dirname "$up_dst")" || { recover_internal || true; die "cannot create parent for $up_rel"; }
		up_tmp=$(mktemp "$(dirname "$up_dst")/.sane-rel.XXXXXX") || { recover_internal || true; die "cannot stage $up_rel"; }
		cp -p "$up_src" "$up_tmp" || { rm -f "$up_tmp"; recover_internal || true; die "cannot copy $up_rel"; }
		mv "$up_tmp" "$up_dst" || { rm -f "$up_tmp"; recover_internal || true; die "cannot install $up_rel"; }
	done < "$payload/manifest.sha256"
	write_journal done "$tag"
	log_event INFO "upgrade committed with pre-upgrade snapshot $tag"
	note "upgrade committed (rollback tag: $tag)"
}

cmd_log() {
	[ "$#" -ge 2 ] || die "usage: log LEVEL MESSAGE"
	level=$1; shift
	case "$level" in
		INFO|WARN|ERROR) ;;
		*) die "invalid log level: $level" ;;
	esac
	[ -n "$*" ] || die "log message must not be empty"
	cmd_init
	log_event "$level" "$*"
}

cmd_backup() {
	[ "$#" -ge 1 ] || die "usage: backup ARCHIVE [--force]"
	archive=$1; shift
	force=0
	for arg in "$@"; do
		case "$arg" in
			--force) force=1 ;;
			*) die "unknown backup option: $arg" ;;
		esac
	done
	cmd_init
	[ -e "$archive" ] && [ "$force" -ne 1 ] && die "archive already exists: $archive"
	tar -czf "$archive" -C "$ROOT" \
		var/lib/sane/reliability var/log/sane 2>/dev/null || die "cannot create archive"
	[ -s "$archive" ] || die "archive is empty"
	note "backup written to $archive"
}

restore_link_safe() {
	# restore_link_safe LINK -- fail closed if LINK's target is absolute or
	# its resolved chain leaves the restore staging root (rt_tmp). Walks the
	# chain with a bounded hop count like symlink_safe_rel; internal relative
	# chains (including '..' that normalizes back inside rt_tmp) are allowed.
	rls_cur=$1
	rls_hops=0
	while [ -L "$rls_cur" ]; do
		rls_hops=$((rls_hops + 1))
		[ "$rls_hops" -le 40 ] || return 1
		rls_target=$(readlink "$rls_cur" 2>/dev/null) || return 1
		case "$rls_target" in
			/*) return 1 ;;
			*) rls_cur="$(dirname "$rls_cur")/$rls_target" ;;
		esac
		rls_cur=$(normalize_path "$rls_cur") || return 1
		case "$rls_cur/" in
			"$rt_tmp/"*) ;;
			*) return 1 ;;
		esac
	done
	return 0
}

cmd_restore() {
	[ "$#" -eq 1 ] || die "usage: restore ARCHIVE"
	archive=$1
	[ -f "$archive" ] || die "archive not found: $archive"
	rt_tmp=$(mktemp -d) || die "cannot create restore staging dir"
	# Validate member names BEFORE extraction so a traversal entry cannot
	# write outside the staging directory.
	tar -tzf "$archive" > "$rt_tmp/members" 2>/dev/null || \
		{ rm -rf -- "$rt_tmp"; die "cannot read archive"; }
	while IFS= read -r rt_member; do
		[ -n "$rt_member" ] || continue
		case "$rt_member" in
			/*|..|../*|*/..|*../*) \
				{ rm -rf -- "$rt_tmp"; die "unsafe archive member: $rt_member"; } ;;
		esac
	done < "$rt_tmp/members"
	tar -xzf "$archive" -C "$rt_tmp" 2>/dev/null || \
		{ rm -rf -- "$rt_tmp"; die "cannot extract archive"; }
	[ -d "$rt_tmp/var/lib/sane/reliability/snapshots" ] || \
		{ rm -rf -- "$rt_tmp"; die "archive has no reliability snapshots"; }
	# Reject absolute targets and symlink chains that leave the staging root
	# before anything is installed. Each chain is walked with a bounded hop
	# count (like symlink_safe_rel); internal relative chains, including '..'
	# that normalizes back inside the staging root, are allowed.
	find "$rt_tmp" -type l -print > "$rt_tmp/links"
	while IFS= read -r rt_link; do
		[ -n "$rt_link" ] || continue
		restore_link_safe "$rt_link" || \
			{ rm -rf -- "$rt_tmp"; die "unsafe symlink chain in archive: $rt_link"; }
	done < "$rt_tmp/links"
	# Verify every snapshot manifest found in the archive.
	find "$rt_tmp/var/lib/sane/reliability/snapshots" -name manifest.sha256 -print > "$rt_tmp/manifests"
	while IFS= read -r rt_manifest; do
		[ -n "$rt_manifest" ] || continue
		rt_dir=$(dirname "$rt_manifest")
		validate_manifest "$rt_dir" || { rm -rf -- "$rt_tmp"; die "invalid archive manifest"; }
		(cd "$rt_dir" && sha256sum -c manifest.sha256 >/dev/null 2>&1) || \
			{ rm -rf -- "$rt_tmp"; die "archive manifest verification failed"; }
	done < "$rt_tmp/manifests"
	mkdir -p "$STATE" "$LOGDIR"
	cp -a "$rt_tmp/var/lib/sane/reliability/." "$STATE/" || \
		{ rm -rf -- "$rt_tmp"; die "cannot restore state"; }
	cp -a "$rt_tmp/var/log/sane/." "$LOGDIR/" || \
		{ rm -rf -- "$rt_tmp"; die "cannot restore logs"; }
	# Never trust the archived journal: an archive captured mid-upgrade carries
	# state=in-progress + snapshot=X, and the next recover would force a
	# rollback to X over the freshly restored state. Restore is a terminal
	# operation: force the journal to idle (state only, no tag or interface).
	write_journal idle || \
		{ rm -rf -- "$rt_tmp"; die "cannot reset journal after restore"; }
	rm -rf -- "$rt_tmp"
	log_event INFO "archive restored"
	note "archive restored into $ROOT"
}

heal_snapshot_swaps() {
	# Complete or discard interrupted --force swaps. Called ONLY while the
	# state lock is held (mutator entry, including recover's boot path), so
	# every .old.<tag> aside and .tmp.* staging dir here is crash residue:
	# the exclusive lock guarantees no live writer owns them. Never called
	# from the lock-free read-only commands (init/list/verify/log).
	for hs_old in "$SNAPS"/.old.*; do
		[ -d "$hs_old" ] || continue
		hs_tag=${hs_old##*/}
		hs_tag=${hs_tag#.old.}
		case "$hs_tag" in
			''|.|..) rm -rf -- "$hs_old"; continue ;;
		esac
		if ! valid_tag "$hs_tag"; then
			rm -rf -- "$hs_old"
			continue
		fi
		if [ -d "$SNAPS/$hs_tag" ]; then
			# Install completed before the crash: the aside is redundant.
			rm -rf -- "$hs_old"
		else
			# Install never happened: restore the old snapshot.
			mv "$hs_old" "$SNAPS/$hs_tag" || \
				die "cannot heal interrupted snapshot swap: $hs_tag"
		fi
	done
	for hs_tmp in "$SNAPS"/.tmp.*; do
		[ -d "$hs_tmp" ] || continue
		rm -rf -- "$hs_tmp"
	done
}

release_lock() {
	# EXIT-trap release, owned by the top-level acquisition only. Remove the
	# lock only if this process still owns it (lock/pid == $$); a lock stolen
	# or held by anyone else is never touched.
	lk_rel_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
	if [ "$lk_rel_pid" = "$$" ]; then
		rm -rf -- "$LOCK_DIR"
	fi
}

acquire_lock() {
	# Atomic mkdir lock for ALL mutators, acquired ONLY at the top-level
	# dispatcher entry. Nested mutator calls in the same process (recover ->
	# cmd_net_recover, rollback/upgrade -> do_snapshot) never re-acquire: the
	# pid check below makes the lock reentrant by pid, and the EXIT-trap
	# release belongs to the top-level acquisition alone.
	#
	# Stale handling: a lock whose pid is dead (kill -0 fails) or garbage is
	# stolen via an atomic mv aside; the mv loser loops and re-evaluates.
	# A pidless lock gets a 1s grace (the holder may be between mkdir and the
	# pid write) before it is treated as crash residue and stolen.
	#
	# Limits (documented in doc/reliability.md): stale detection is kill -0
	# based, so a REUSED pid of a dead holder can look alive and delay
	# acquisition up to the timeout (fail-closed, never a wrongful steal of a
	# live same-user holder); kill -0 also fails with EPERM across users, so
	# the tool assumes single-user/root operation on the state it protects.
	LOCK_TIMEOUT=${SANE_RELIABILITY_LOCK_TIMEOUT:-30}
	case "$LOCK_TIMEOUT" in
		''|*[!0-9]*|0) die "invalid SANE_RELIABILITY_LOCK_TIMEOUT: $LOCK_TIMEOUT" ;;
	esac
	lk_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
	[ "$lk_pid" = "$$" ] && return 0
	mkdir -p "$STATE" || die "cannot create reliability state for locking"
	lk_tries=0
	lk_empty=0
	lk_max=$((LOCK_TIMEOUT * 10))
	while ! mkdir "$LOCK_DIR" 2>/dev/null; do
		lk_tries=$((lk_tries + 1))
		[ "$lk_tries" -le "$lk_max" ] || \
			die "timed out waiting for reliability lock: $LOCK_DIR"
		lk_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
		[ "$lk_pid" = "$$" ] && return 0
		lk_stale=0
		case "$lk_pid" in
			'') lk_empty=$((lk_empty + 1))
			    [ "$lk_empty" -ge 10 ] && lk_stale=1 ;;
			*[!0-9]*) lk_stale=1 ;;
			*) lk_empty=0
			   kill -0 "$lk_pid" 2>/dev/null || lk_stale=1 ;;
		esac
		if [ "$lk_stale" = 1 ]; then
			if mv "$LOCK_DIR" "$LOCK_DIR.stale.$$" 2>/dev/null; then
				rm -rf -- "$LOCK_DIR.stale.$$"
			else
				sleep 0.1
			fi
		else
			sleep 0.1
		fi
	done
	printf '%s\n' "$$" > "$LOCK_DIR/pid"
	trap release_lock EXIT
	trap 'exit 1' HUP INT TERM
	heal_snapshot_swaps
}

case "$CMD" in
	init)          cmd_init "$@" ;;
	list)          cmd_list "$@" ;;
	verify)        cmd_verify "$@" ;;
	log)           cmd_log "$@" ;;
	snapshot|rollback|upgrade|recover|net-recover|backup|restore)
		# All mutators serialize on the state lock. Acquisition happens only
		# here, at the top-level entry; the EXIT-trap release belongs to this
		# acquisition alone. Nested mutator calls within the process reuse the
		# held lock (reentrant by pid) and never re-acquire or release it.
		acquire_lock
		case "$CMD" in
			snapshot)    cmd_snapshot "$@" ;;
			rollback)    cmd_rollback "$@" ;;
			upgrade)     cmd_upgrade "$@" ;;
			recover)     cmd_recover "$@" ;;
			net-recover) cmd_net_recover "$@" ;;
			backup)      cmd_backup "$@" ;;
			restore)     cmd_restore "$@" ;;
		esac
		;;
	*) usage >&2; die "unknown command: $CMD" ;;
esac
