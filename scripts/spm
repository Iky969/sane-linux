#!/bin/sh
# scripts/spm -- S.A.N.E Package Manager CLI
#
# POSIX-compliant, deterministic, offline-first package manager for S.A.N.E Linux.
# Implements atomic staged installations via rename(2) avoiding ETXTBSY,
# strict anti-tar-slip & symlink traversal guards, flat-file database tracking,
# declarative ninit service snippet validation, and safe bottom-up removal.
#
# Subcommands:
#   spm init [--root <path>]
#   spm list [--root <path>]
#   spm info <pkg-name> [--root <path>]
#   spm query <path> [--root <path>]
#   spm install <pkg.spm.tar.xz> [--root <path>]
#   spm remove <pkg-name> [--root <path>]

set -eu
export LC_ALL=C

die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'WARNING: %s\n' "$*" >&2
}

log() {
    printf '==> %s\n' "$*"
}

usage() {
    cat <<'EOF'
Usage: spm [OPTIONS] <subcommand> [ARGS...]

Subcommands:
  init                     Initialize the SPM database layout
  list                     List installed packages (name, version, release, arch, base)
  info <pkg-name>          Show detailed package metadata and dependencies
  query <path>             Find which package provides a given file path
  install <archive>        Install an .spm package atomically with checksum verification
  remove <pkg-name>        Safely remove a package and clean empty directories bottom-up

Options:
  -f, --force              Force removal of packages marked base=true
  -r, --root <path>        Target system root directory (default: /)
  -h, --help               Show this help message and exit
  -v, --version            Display spm version
EOF
}

TARGET_ROOT=""
SUBCOMMAND=""
FORCE=false

# Parse command line arguments preserving positional args for subcommand
nargs=$#
while [ $nargs -gt 0 ]; do
    arg="$1"
    shift
    nargs=$((nargs - 1))
    case "$arg" in
        -f|--force)
            FORCE=true
            ;;
        --root)
            [ $nargs -ge 1 ] || die "Option '--root' requires an argument"
            TARGET_ROOT="$1"
            shift
            nargs=$((nargs - 1))
            ;;
        --root=*)
            TARGET_ROOT="${arg#*=}"
            ;;
        -r)
            [ $nargs -ge 1 ] || die "Option '-r' requires an argument"
            TARGET_ROOT="$1"
            shift
            nargs=$((nargs - 1))
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            printf 'spm 1.0.0 (S.A.N.E Package Manager)\n'
            exit 0
            ;;
        init|list|info|query|install|remove)
            if [ -z "$SUBCOMMAND" ]; then
                SUBCOMMAND="$arg"
            else
                set -- "$@" "$arg"
            fi
            ;;
        *)
            set -- "$@" "$arg"
            ;;
    esac
done

[ -n "$SUBCOMMAND" ] || { usage >&2; exit 1; }

# Normalize TARGET_ROOT
if [ -n "$TARGET_ROOT" ] && [ "$TARGET_ROOT" != "/" ]; then
    mkdir -p "$TARGET_ROOT"
    TARGET_ROOT="$(cd "$TARGET_ROOT" && pwd -P)"
    TARGET_ROOT="${TARGET_ROOT%/}"
else
    TARGET_ROOT=""
fi

SPM_DB_DIR="${TARGET_ROOT}/var/lib/spm"
INSTALLED_DIR="${SPM_DB_DIR}/installed"
PROVIDERS_FILE="${SPM_DB_DIR}/providers"
RDEPS_DIR="${SPM_DB_DIR}/rdeps"
WORLD_FILE="${SPM_DB_DIR}/world"
STAGING_BASE="${SPM_DB_DIR}/staging"
LOCK_FILE="${SPM_DB_DIR}/spm.lock"

# Locking management via flock(1)
LOCK_FD=9
CURRENT_STAGING_DIR=""
CURRENT_PKG_NAME=""
IN_TRANSACTION=false

do_rollback() {
    local staging_dir="${1:-$CURRENT_STAGING_DIR}"
    local pkg="${2:-$CURRENT_PKG_NAME}"
    [ -n "$staging_dir" ] && [ -d "$staging_dir" ] || return 0

    local rjournal="$staging_dir/.journal"
    local rbackup="$rjournal/backup"
    local rcreated="$rjournal/created"

    # Remove newly created files in reverse order
    if [ -s "$rcreated" ]; then
        awk '{a[NR]=$0} END {for (i=NR; i>=1; i--) print a[i]}' "$rcreated" | while IFS= read -r cfile || [ -n "$cfile" ]; do
            [ -n "$cfile" ] || continue
            rm -f -- "$cfile" 2>/dev/null || true
            rmdir "$(dirname "$cfile")" 2>/dev/null || true
        done
    fi

    # Restore replaced and obsolete files from backup
    if [ -d "$rbackup" ]; then
        find "$rbackup" \( -type f -o -type l \) | while IFS= read -r bfile || [ -n "$bfile" ]; do
            [ -n "$bfile" ] || continue
            local brel="${bfile#$rbackup/}"
            local rdst="${TARGET_ROOT}/$brel"
            mkdir -p "$(dirname "$rdst")"
            mv -f "$bfile" "$rdst" 2>/dev/null || true
        done
    fi

    # Clean up empty directories from manifest in reverse depth order
    if [ -f "$staging_dir/.META/files" ]; then
        LC_ALL=C sort -r "$staging_dir/.META/files" | while IFS= read -r fline || [ -n "$fline" ]; do
            case "$fline" in
                */)
                    rmdir "${TARGET_ROOT}/${fline%/}" 2>/dev/null || true
                    ;;
            esac
        done
    fi

    # Restore database state from snapshot
    if [ -n "$pkg" ]; then
        if [ -f "$rjournal/had_installed_pkg" ]; then
            rm -rf "$INSTALLED_DIR/$pkg"
            cp -a "$rjournal/installed_pkg" "$INSTALLED_DIR/$pkg" 2>/dev/null || true
        elif [ -f "$rjournal/no_installed_pkg" ]; then
            rm -rf "$INSTALLED_DIR/$pkg" 2>/dev/null || true
        fi
    fi

    if [ -f "$rjournal/providers" ]; then
        cp -a "$rjournal/providers" "$PROVIDERS_FILE" 2>/dev/null || true
    else
        rm -f "$PROVIDERS_FILE" 2>/dev/null || true
    fi

    if [ -f "$rjournal/world" ]; then
        cp -a "$rjournal/world" "$WORLD_FILE" 2>/dev/null || true
    else
        rm -f "$WORLD_FILE" 2>/dev/null || true
    fi

    if [ -d "$rjournal/rdeps" ]; then
        rm -rf "$RDEPS_DIR"
        cp -a "$rjournal/rdeps" "$RDEPS_DIR" 2>/dev/null || true
    else
        rm -rf "$RDEPS_DIR" 2>/dev/null || true
    fi
}

cleanup_all() {
    if [ "${IN_TRANSACTION:-false}" = true ]; then
        IN_TRANSACTION=false
        do_rollback "${CURRENT_STAGING_DIR:-}" "${CURRENT_PKG_NAME:-}"
    fi

    if [ -n "${CURRENT_STAGING_DIR:-}" ] && [ -d "$CURRENT_STAGING_DIR" ]; then
        rm -rf "$CURRENT_STAGING_DIR" 2>/dev/null || true
    fi
    release_lock
}
trap cleanup_all EXIT INT TERM

acquire_lock() {
    mkdir -p "$SPM_DB_DIR"
    touch "$LOCK_FILE"
    eval "exec ${LOCK_FD}>\"$LOCK_FILE\""
    if ! flock -n -x $LOCK_FD 2>/dev/null; then
        log "Waiting for exclusive lock on $LOCK_FILE..."
        flock -x $LOCK_FD
    fi
}

acquire_shared_lock() {
    mkdir -p "$SPM_DB_DIR"
    touch "$LOCK_FILE"
    eval "exec ${LOCK_FD}<\"$LOCK_FILE\""
    flock -s $LOCK_FD
}

release_lock() {
    flock -u $LOCK_FD 2>/dev/null || true
    eval "exec ${LOCK_FD}>&-" 2>/dev/null || true
}

# Helper to read key=value manifest
get_val() {
    local file="$1"
    local key="$2"
    grep -E "^[[:space:]]*${key}=" "$file" 2>/dev/null | head -n 1 | cut -d= -f2- | tr -d '\r\n' || true
}

get_val_from_str() {
    local str="$1"
    local key="$2"
    printf '%s\n' "$str" | grep -E "^[[:space:]]*${key}=" 2>/dev/null | head -n 1 | cut -d= -f2- | tr -d '\r\n' || true
}

# Helper to verify archive entries (anti-tar-slip)
verify_archive_entries() {
    local pkg="$1"
    local member
    local tmp_tar
    tmp_tar="$(mktemp "${TMPDIR:-/tmp}/spm-entries.XXXXXX")"
    tar -tf "$pkg" > "$tmp_tar" 2>/dev/null || { rm -f "$tmp_tar"; die "Failed to read archive: $pkg"; }

    while IFS= read -r member || [ -n "$member" ]; do
        [ -n "$member" ] || continue
        # Reject leading slashes
        case "$member" in
            /*)
                rm -f "$tmp_tar"
                die "Archive entry has forbidden leading slash: $member"
                ;;
        esac
        # Reject path traversal components
        if echo "$member" | grep -qE '(^|/)\.\.(/|$)'; then
            rm -f "$tmp_tar"
            die "Path traversal detected in archive entry: $member"
        fi
        # Entries must strictly start with ./.META/ or ./x/
        case "$member" in
            ./.META|./.META/*|./x|./x/*)
                ;;
            *)
                rm -f "$tmp_tar"
                die "Forbidden archive entry outside ./.META/ and ./x/: $member"
                ;;
        esac
    done < "$tmp_tar"
    rm -f "$tmp_tar"
}

# Helper to verify symlink safety
verify_symlink_safety() {
    local link_path="$1"
    local link_target="$2"

    # Reject symlinks in .META/
    case "$link_path" in
        ./.META|./.META/*)
            die "Symlinks are strictly forbidden in .META directory: $link_path"
            ;;
    esac

    local rel_link="${link_path#./x/}"

    # Handle absolute symlink targets
    case "$link_target" in
        /*)
            # Reject path traversal components in absolute targets
            if echo "$link_target" | grep -qE '(^|/)\.\.(/|$)'; then
                die "Path traversal detected in absolute symlink target: $link_path -> $link_target"
            fi
            # Forbidden sensitive host paths
            case "$link_target" in
                /etc/shadow*|/etc/passwd*|/etc/sudoers*|/etc/gshadow*|/proc/*|/sys/*|/dev/*|/root/*|/home/*)
                    die "Symlink escape attack: forbidden system target $link_target"
                    ;;
            esac
            # Absolute targets must point to standard system root directories
            case "$link_target" in
                /bin/*|/sbin/*|/usr/bin/*|/usr/sbin/*|/usr/share/*|/lib/*|/usr/lib/*|/boot/*|/opt/*)
                    return 0
                    ;;
                *)
                    die "Symlink escape attack: absolute target outside allowed system directories: $link_target"
                    ;;
            esac
            ;;
    esac

    # Handle relative symlink targets: ensure they do not escape ./x/ payload root
    local dir_part
    dir_part="$(dirname "$rel_link")"
    local depth=0
    if [ "$dir_part" != "." ]; then
        local old_ifs="$IFS"
        IFS='/'
        set -f
        set -- $dir_part
        set +f
        IFS="$old_ifs"
        depth=$#
    fi

    local cur_depth=$depth
    local old_ifs="$IFS"
    IFS='/'
    set -f
    set -- $link_target
    set +f
    IFS="$old_ifs"

    for p in "$@"; do
        if [ "$p" = ".." ]; then
            cur_depth=$((cur_depth - 1))
            if [ $cur_depth -lt 0 ]; then
                die "Relative symlink escapes target payload root: $link_path -> $link_target"
            fi
        elif [ -n "$p" ] && [ "$p" != "." ]; then
            cur_depth=$((cur_depth + 1))
        fi
    done
    return 0
}

# Helper to inspect all symlinks inside archive
verify_archive_symlinks() {
    local pkg="$1"
    local line
    local tmp_tar
    tmp_tar="$(mktemp "${TMPDIR:-/tmp}/spm-symlinks.XXXXXX")"
    tar -tvf "$pkg" > "$tmp_tar" 2>/dev/null || { rm -f "$tmp_tar"; die "Failed to inspect archive symlinks: $pkg"; }

    while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] || continue
        case "$line" in
            l*" -> "*)
                local before="${line% -> *}"
                local ltarget="${line#* -> }"
                local lpath="${before##* }"
                verify_symlink_safety "$lpath" "$ltarget"
                ;;
        esac
    done < "$tmp_tar"
    rm -f "$tmp_tar"
}

# Helper to validate an individual entry in .META/files
validate_manifest_entry() {
    local fline="$1"
    [ -n "$fline" ] || die "Invalid empty entry in .META/files"
    case "$fline" in
        /*)
            die "Invalid entry in .META/files: leading slash forbidden: $fline"
            ;;
        *//*)
            die "Invalid entry in .META/files: double slash forbidden: $fline"
            ;;
    esac
    if echo "$fline" | grep -qE '(^|/)\.\.(/|$)'; then
        die "Path traversal detected in .META/files: $fline"
    fi
    if echo "$fline" | grep -qE '(^|/)\.(/|$)'; then
        die "Invalid dot component detected in .META/files: $fline"
    fi
    if ! echo "$fline" | grep -qE '^[a-zA-Z0-9._/+-]+$'; then
        die "Invalid characters detected in .META/files: $fline"
    fi
}

# Helper to verify 1:1 bidirectional match between .META/files and $STAGING_DIR/x/
verify_manifest_payload_parity() {
    local staging_root="$1"
    local files_manifest="$staging_root/.META/files"
    local staging_payload="$staging_root/x"

    [ -f "$files_manifest" ] || die "Archive missing metadata manifest .META/files"
    [ -s "$files_manifest" ] || die "Metadata manifest .META/files is empty"
    [ -d "$staging_payload" ] || die "Archive missing payload root ./x/"

    while IFS= read -r fline || [ -n "$fline" ]; do
        validate_manifest_entry "$fline"
    done < "$files_manifest"

    local manifest_sorted="$staging_root/.manifest_sorted"
    LC_ALL=C sort "$files_manifest" > "$manifest_sorted"

    # Check for duplicate lines in manifest
    local dup_entry
    dup_entry="$(LC_ALL=C uniq -d "$manifest_sorted" | head -n 1)"
    [ -z "$dup_entry" ] || die "Duplicate entry found in .META/files: $dup_entry"

    local payload_actual="$staging_root/.payload_actual"
    (
        cd "$staging_payload"
        {
            find . -mindepth 1 -type d | sed 's|^\./||' | sed 's|$|/|'
            find . -mindepth 1 ! -type d | sed 's|^\./||'
        } | LC_ALL=C sort > "$payload_actual"
    )

    if ! cmp -s "$manifest_sorted" "$payload_actual"; then
        local missing_in_payload
        missing_in_payload="$(comm -23 "$manifest_sorted" "$payload_actual" | head -n 1)"
        if [ -n "$missing_in_payload" ]; then
            die "Payload parity violation: entry in .META/files does not exist in staging payload: $missing_in_payload"
        fi
        local unrecorded_in_payload
        unrecorded_in_payload="$(comm -13 "$manifest_sorted" "$payload_actual" | head -n 1)"
        if [ -n "$unrecorded_in_payload" ]; then
            die "Payload parity violation: unrecorded entry in staging payload: $unrecorded_in_payload"
        fi
    fi
}

# Helper to verify SHA-256 checksums with fail-closed semantics and 1:1 match
verify_payload_checksums() {
    local staging_root="$1"
    local sha_manifest="$staging_root/.META/sha256"
    local staging_payload="$staging_root/x"

    [ -f "$sha_manifest" ] || die "Archive is missing mandatory checksum manifest .META/sha256"

    local payload_reg_files="$staging_root/.payload_reg_files"
    (
        cd "$staging_payload"
        find . -type f | sed 's|^\./||' | LC_ALL=C sort > "$payload_reg_files"
    )

    local recorded_files="$staging_root/.sha_recorded_files"
    rm -f "$recorded_files"
    touch "$recorded_files"

    while IFS= read -r sha_line || [ -n "$sha_line" ]; do
        [ -n "$sha_line" ] || die "Invalid empty line in .META/sha256"

        if ! echo "$sha_line" | grep -qE '^[0-9a-fA-F]{64}[[:space:]]+.+$'; then
            die "Malformed checksum entry in .META/sha256: '$sha_line'"
        fi

        local exp_hash exp_rel
        exp_hash="$(echo "$sha_line" | awk '{print $1}' | tr '[:upper:]' '[:lower:]')"
        exp_rel="$(echo "$sha_line" | sed 's/^[0-9a-fA-F]\{64\}[[:space:]]\+//')"

        case "$exp_rel" in
            /*|*//*)
                die "Path traversal or invalid path in .META/sha256: '$exp_rel'"
                ;;
        esac
        if echo "$exp_rel" | grep -qE '(^|/)\.\.(/|$)'; then
            die "Path traversal or invalid path in .META/sha256: '$exp_rel'"
        fi

        if grep -q -x -F "$exp_rel" "$recorded_files" 2>/dev/null; then
            die "Duplicate checksum entry in .META/sha256: '$exp_rel'"
        fi
        printf '%s\n' "$exp_rel" >> "$recorded_files"

        local staged_file="$staging_payload/$exp_rel"
        if [ ! -f "$staged_file" ] || [ -L "$staged_file" ]; then
            die "Checksum entry does not correspond to a regular file in payload: '$exp_rel'"
        fi

        local calc_hash
        calc_hash="$(sha256sum "$staged_file" | awk '{print $1}')"
        if [ "$calc_hash" != "$exp_hash" ]; then
            die "Checksum mismatch for '$exp_rel': expected $exp_hash, got $calc_hash"
        fi
    done < "$sha_manifest"

    LC_ALL=C sort "$recorded_files" -o "$recorded_files"
    if ! cmp -s "$payload_reg_files" "$recorded_files"; then
        local missing_in_sha
        missing_in_sha="$(comm -23 "$payload_reg_files" "$recorded_files" | head -n 1)"
        if [ -n "$missing_in_sha" ]; then
            die "Checksum verification failed: regular file missing in .META/sha256: $missing_in_sha"
        fi
        local unrecorded_in_payload
        unrecorded_in_payload="$(comm -13 "$payload_reg_files" "$recorded_files" | head -n 1)"
        if [ -n "$unrecorded_in_payload" ]; then
            die "Checksum entry has no corresponding regular file in payload: $unrecorded_in_payload"
        fi
    fi
}

# Helper to guard against destination directory symlink escape attacks
verify_destination_path_safety() {
    local rel_entry="$1"
    local clean_entry="${rel_entry%/}"
    local rel_dir
    case "$rel_entry" in
        */)
            rel_dir="$clean_entry"
            ;;
        *)
            rel_dir="$(dirname "$clean_entry")"
            ;;
    esac
    [ "$rel_dir" != "." ] || return 0

    local base_root="${TARGET_ROOT:-/}"
    local cur_path="$base_root"
    local canon_root="${TARGET_ROOT:-/}"

    local old_ifs="$IFS"
    IFS='/'
    set -f
    set -- $rel_dir
    set +f
    IFS="$old_ifs"

    for part in "$@"; do
        [ -n "$part" ] || continue
        if [ "$cur_path" = "/" ]; then
            cur_path="/$part"
        else
            cur_path="$cur_path/$part"
        fi

        if [ -L "$cur_path" ]; then
            local resolved
            resolved="$(realpath -q "$cur_path" 2>/dev/null || true)"
            [ -n "$resolved" ] || die "Destination directory symlink cannot be resolved: $cur_path"

            if [ "$canon_root" != "/" ]; then
                case "$resolved" in
                    "$canon_root"|"$canon_root"/*)
                        ;;
                    *)
                        die "Symlink escape attack: destination directory component '$cur_path' resolves to '$resolved' outside target root '$canon_root'"
                        ;;
                esac
            else
                case "$resolved" in
                    /etc/shadow*|/etc/passwd*|/etc/sudoers*|/etc/gshadow*|/proc*|/sys*|/dev*)
                        die "Symlink escape attack: destination directory component '$cur_path' points to forbidden system target: $resolved"
                        ;;
                esac
            fi
        elif [ ! -e "$cur_path" ]; then
            break
        fi
    done
}

# Helper to validate service snippets in staging
validate_service_snippets() {
    local staging_root="$1"
    local service_dir="$staging_root/x/usr/share/ninit/services"
    [ -d "$service_dir" ] || return 0

    for sfile in "$service_dir"/*; do
        [ -e "$sfile" ] || [ -L "$sfile" ] || continue
        local sname
        sname="$(basename "$sfile")"

        if [ -L "$sfile" ]; then
            die "Service snippet must not be a symlink: $sname"
        fi
        [ -f "$sfile" ] || die "Service snippet is not a regular file: $sname"
        case "$sname" in
            *.service)
                ;;
            *)
                die "Service snippet filename must end in .service: $sname"
                ;;
        esac

        # Enforce non-executable 0644 permissions
        chmod 0644 "$sfile"

        # Check line count: strictly single line
        local line_count
        line_count="$(grep -c '^' "$sfile" || true)"
        [ "$line_count" -le 1 ] || die "Service snippet must be strictly a single definition line: $sname (found $line_count lines)"

        local content
        content="$(tr -d '\r\n' < "$sfile")"
        [ -n "$content" ] || die "Service snippet is empty: $sname"

        # Regex syntax check: (name:)?(once|respawn):<command> [args] [options...]
        # Options allow :deps=..., :user=..., :group=..., :memory_max=..., etc.
        if ! echo "$content" | grep -qE '^([a-zA-Z0-9_-]+:)?(once|respawn):[a-zA-Z0-9_/.-]+([[:space:]][a-zA-Z0-9_/.-]+)*(:[a-zA-Z0-9_=., -]+)*$'; then
            die "Invalid service snippet syntax in $sname: must match '[(<name>):](once|respawn):<cmd> [<args>...]'"
        fi

        # Check forbidden dangerous keywords
        for forbidden in "/run/initctl" "reboot" "poweroff" "halt" "kill" "signal"; do
            if echo "$content" | grep -qw "$forbidden"; then
                die "Forbidden keyword '$forbidden' detected in service snippet: $sname"
            fi
        done

        # Check forbidden shell metacharacters
        if echo "$content" | grep -qE '[|><;&`$]'; then
            die "Forbidden shell metacharacters detected in service snippet: $sname"
        fi
    done
}

# Subcommand: init
cmd_init() {
    acquire_lock
    mkdir -p "$INSTALLED_DIR" "$RDEPS_DIR" "$STAGING_BASE"
    [ -f "$PROVIDERS_FILE" ] || touch "$PROVIDERS_FILE"
    [ -f "$WORLD_FILE" ] || touch "$WORLD_FILE"
    log "Initialized empty SPM database in $SPM_DB_DIR"
    release_lock
}

# Subcommand: list
cmd_list() {
    acquire_shared_lock
    if [ -d "$INSTALLED_DIR" ]; then
        for pdir in "$INSTALLED_DIR"/*; do
            [ -d "$pdir" ] || continue
            local pmanifest="$pdir/package"
            [ -f "$pmanifest" ] || continue

            local name version release arch base
            name="$(get_val "$pmanifest" "name")"
            version="$(get_val "$pmanifest" "version")"
            release="$(get_val "$pmanifest" "release")"
            arch="$(get_val "$pmanifest" "arch")"
            base="$(get_val "$pmanifest" "base")"
            [ -n "$release" ] || release="1"

            printf '%s %s-%s %s base=%s\n' "$name" "$version" "$release" "$arch" "$base"
        done
    fi
    release_lock
}

# Subcommand: info
cmd_info() {
    [ $# -ge 1 ] || die "Missing package name for 'info' subcommand"
    local pkg_name="$1"

    acquire_shared_lock
    local pdir="$INSTALLED_DIR/$pkg_name"
    local pmanifest="$pdir/package"

    [ -d "$pdir" ] && [ -f "$pmanifest" ] || die "Package '$pkg_name' is not installed"

    local name version release arch description base deps
    name="$(get_val "$pmanifest" "name")"
    version="$(get_val "$pmanifest" "version")"
    release="$(get_val "$pmanifest" "release")"
    arch="$(get_val "$pmanifest" "arch")"
    description="$(get_val "$pmanifest" "description")"
    base="$(get_val "$pmanifest" "base")"
    deps="$(get_val "$pmanifest" "dependencies")"
    [ -n "$release" ] || release="1"

    if [ -z "$deps" ] && [ -f "$pdir/depends" ]; then
        deps="$(tr '\n' ' ' < "$pdir/depends" | sed 's/[[:space:]]*$//')"
    fi
    [ -n "$deps" ] || deps="(none)"

    printf 'Name: %s\n' "$name"
    printf 'Version: %s\n' "$version"
    printf 'Release: %s\n' "$release"
    printf 'Architecture: %s\n' "$arch"
    printf 'Base: %s\n' "$base"
    printf 'Description: %s\n' "$description"
    printf 'Dependencies: %s\n' "$deps"

    release_lock
}

# Subcommand: query
cmd_query() {
    [ $# -ge 1 ] || die "Missing file path for 'query' subcommand"
    local query_path="$1"

    # Normalize queried path
    if [ -n "$TARGET_ROOT" ]; then
        case "$query_path" in
            "$TARGET_ROOT"*)
                query_path="${query_path#$TARGET_ROOT}"
                ;;
        esac
    fi
    case "$query_path" in
        /*) ;;
        *) query_path="/$query_path" ;;
    esac
    [ "$query_path" = "/" ] || query_path="${query_path%/}"

    acquire_shared_lock
    if [ ! -f "$PROVIDERS_FILE" ]; then
        release_lock
        die "No package provides $query_path"
    fi

    local owner_pkg
    owner_pkg="$(awk -v p="$query_path" -F'\t' '$1 == p { print $2; exit }' "$PROVIDERS_FILE" 2>/dev/null || true)"

    if [ -n "$owner_pkg" ]; then
        printf '%s is provided by %s\n' "$query_path" "$owner_pkg"
        release_lock
    else
        release_lock
        die "No package provides $query_path"
    fi
}

# Subcommand: install
cmd_install() {
    [ $# -ge 1 ] || die "Missing package archive path for 'install' subcommand"
    local archive_file="$1"

    [ -f "$archive_file" ] || die "Package archive not found: $archive_file"
    archive_file="$(cd "$(dirname "$archive_file")" && pwd -P)/$(basename "$archive_file")"

    acquire_lock

    # Ensure DB directories exist
    mkdir -p "$INSTALLED_DIR" "$RDEPS_DIR" "$STAGING_BASE"
    [ -f "$PROVIDERS_FILE" ] || touch "$PROVIDERS_FILE"
    [ -f "$WORLD_FILE" ] || touch "$WORLD_FILE"

    log "Step 1/6: Verifying archive format and security invariants..."
    verify_archive_entries "$archive_file"
    verify_archive_symlinks "$archive_file"

    log "Step 2/6: Validating package metadata and dependencies..."
    local manifest_content
    manifest_content="$(tar -xOf "$archive_file" ./.META/package 2>/dev/null || die "Archive is missing mandatory .META/package")"

    local pkg_name pkg_version pkg_release pkg_arch pkg_base pkg_desc pkg_deps
    pkg_name="$(get_val_from_str "$manifest_content" "name")"
    pkg_version="$(get_val_from_str "$manifest_content" "version")"
    pkg_release="$(get_val_from_str "$manifest_content" "release")"
    pkg_arch="$(get_val_from_str "$manifest_content" "arch")"
    pkg_base="$(get_val_from_str "$manifest_content" "base")"
    pkg_desc="$(get_val_from_str "$manifest_content" "description")"
    pkg_deps="$(get_val_from_str "$manifest_content" "dependencies")"

    [ -n "$pkg_name" ] || die "Manifest missing 'name'"
    [ -n "$pkg_version" ] || die "Manifest missing 'version'"
    [ -n "$pkg_arch" ] || die "Manifest missing 'arch'"
    [ -n "$pkg_desc" ] || die "Manifest missing 'description'"
    [ -n "$pkg_release" ] || pkg_release="1"
    [ -n "$pkg_base" ] || pkg_base="false"

    if ! echo "$pkg_name" | grep -qE '^[a-z0-9][a-z0-9-]*$'; then
        die "Invalid package name '$pkg_name'"
    fi
    [ "$pkg_arch" = "x86_64" ] || [ "$pkg_arch" = "all" ] || die "Architecture '$pkg_arch' is not supported (must be 'x86_64' or 'all')"
    [ "$pkg_base" = "true" ] || [ "$pkg_base" = "false" ] || die "Invalid base flag '$pkg_base' (must be 'true' or 'false')"

    # Check dependencies
    local deps_content
    deps_content="$(tar -xOf "$archive_file" ./.META/depends 2>/dev/null || true)"
    if [ -n "$deps_content" ]; then
        local tmp_deps
        tmp_deps="$(mktemp "${TMPDIR:-/tmp}/spm-deps.XXXXXX")"
        printf '%s\n' "$deps_content" > "$tmp_deps"
        while IFS= read -r dep || [ -n "$dep" ]; do
            dep="$(echo "$dep" | tr -d '[:space:]')"
            [ -n "$dep" ] || continue
            if [ ! -d "$INSTALLED_DIR/$dep" ]; then
                rm -f "$tmp_deps"
                die "Missing dependency: package '$dep' is required by '$pkg_name' but not installed"
            fi
        done < "$tmp_deps"
        rm -f "$tmp_deps"
    fi

    log "Step 3/6: Checking for file collisions against providers index..."
    local files_content
    files_content="$(tar -xOf "$archive_file" ./.META/files 2>/dev/null || die "Archive is missing mandatory .META/files")"
    [ -n "$files_content" ] || die "Archive metadata .META/files is empty"

    local tmp_files
    tmp_files="$(mktemp "${TMPDIR:-/tmp}/spm-files.XXXXXX")"
    printf '%s\n' "$files_content" > "$tmp_files"

    while IFS= read -r fline || [ -n "$fline" ]; do
        [ -n "$fline" ] || continue
        validate_manifest_entry "$fline"
        verify_destination_path_safety "$fline"

        # Directories are shared, skip providers conflict check
        case "$fline" in
            */)
                local dir_disk_path="${TARGET_ROOT}/${fline%/}"
                if [ -f "$dir_disk_path" ] || [ -L "$dir_disk_path" ]; then
                    rm -f "$tmp_files"
                    die "Conflict: directory '$fline' clashes with existing non-directory on disk: $dir_disk_path"
                fi
                continue
                ;;
        esac

        local norm_path="/$fline"
        local disk_path="${TARGET_ROOT}${norm_path}"

        # Check providers index
        local owner
        owner="$(awk -v p="$norm_path" -F'\t' '$1 == p { print $2; exit }' "$PROVIDERS_FILE" 2>/dev/null || true)"
        if [ -n "$owner" ]; then
            if [ "$owner" != "$pkg_name" ]; then
                rm -f "$tmp_files"
                die "File collision: path '$norm_path' is already owned by package '$owner'"
            fi
        else
            # Path unrecorded in providers
            if [ -e "$disk_path" ] || [ -L "$disk_path" ]; then
                if [ "$pkg_base" = "true" ]; then
                    log "Base package '$pkg_name' claiming pre-existing unowned file: $norm_path"
                else
                    rm -f "$tmp_files"
                    die "File collision: path '$norm_path' already exists on disk but is unowned"
                fi
            fi
        fi
    done < "$tmp_files"
    rm -f "$tmp_files"

    log "Step 4/6: Extracting to scratch staging area and auditing checksums..."
    local txid="tx-$pkg_name-$$"
    local STAGING_DIR="${STAGING_BASE}/${txid}"
    rm -rf "$STAGING_DIR"
    mkdir -p "$STAGING_DIR"
    CURRENT_STAGING_DIR="$STAGING_DIR"

    tar -C "$STAGING_DIR" --no-same-owner -xf "$archive_file"

    [ -d "$STAGING_DIR/x" ] || { rm -rf "$STAGING_DIR"; die "Archive missing payload root ./x/"; }
    [ -d "$STAGING_DIR/.META" ] || { rm -rf "$STAGING_DIR"; die "Archive missing metadata directory ./.META/"; }

    # Bidirectional 1:1 manifest-to-payload parity verification
    verify_manifest_payload_parity "$STAGING_DIR"

    # Cryptographic SHA-256 verification of regular files (fail-closed, 1:1 match)
    verify_payload_checksums "$STAGING_DIR"

    # Validate declarative ninit service snippets
    validate_service_snippets "$STAGING_DIR" || {
        rm -rf "$STAGING_DIR"
        die "Service snippet validation failed"
    }

    log "Step 5/6: Committing files atomically via rename(2) avoiding ETXTBSY..."
    local ROLLBACK_JOURNAL="$STAGING_DIR/.journal"
    local ROLLBACK_BACKUP="$ROLLBACK_JOURNAL/backup"
    local ROLLBACK_CREATED="$ROLLBACK_JOURNAL/created"
    mkdir -p "$ROLLBACK_BACKUP"
    touch "$ROLLBACK_CREATED"

    # Snapshot DB state for target package before filesystem commit
    if [ -d "$INSTALLED_DIR/$pkg_name" ]; then
        cp -a "$INSTALLED_DIR/$pkg_name" "$ROLLBACK_JOURNAL/installed_pkg"
        touch "$ROLLBACK_JOURNAL/had_installed_pkg"
    else
        touch "$ROLLBACK_JOURNAL/no_installed_pkg"
    fi

    if [ -f "$PROVIDERS_FILE" ]; then
        cp -a "$PROVIDERS_FILE" "$ROLLBACK_JOURNAL/providers"
    fi
    if [ -f "$WORLD_FILE" ]; then
        cp -a "$WORLD_FILE" "$ROLLBACK_JOURNAL/world"
    fi
    if [ -d "$RDEPS_DIR" ]; then
        cp -a "$RDEPS_DIR" "$ROLLBACK_JOURNAL/rdeps"
    fi

    CURRENT_PKG_NAME="$pkg_name"
    IN_TRANSACTION=true

    rollback_transaction() {
        warn "Commit failed; executing unified atomic rollback..."
        IN_TRANSACTION=false
        do_rollback "$STAGING_DIR" "$pkg_name"
        rm -rf "$STAGING_DIR"
        CURRENT_STAGING_DIR=""
        CURRENT_PKG_NAME=""
        release_lock
        die "Package deployment failed; unified state rolled back cleanly"
    }

    # Check for package self-upgrade and obsolete files
    local is_upgrade=false
    local old_files_list="$INSTALLED_DIR/$pkg_name/files.list"
    local obsolete_paths_file="$STAGING_DIR/.obsolete_paths"
    rm -f "$obsolete_paths_file"
    touch "$obsolete_paths_file"

    if [ -f "$old_files_list" ]; then
        is_upgrade=true
        local old_paths_sorted="$STAGING_DIR/.old_paths_sorted"
        local new_paths_sorted="$STAGING_DIR/.new_paths_sorted"
        LC_ALL=C sort "$old_files_list" > "$old_paths_sorted"
        awk '{ print "/" $0 }' "$STAGING_DIR/.META/files" | LC_ALL=C sort > "$new_paths_sorted"
        comm -23 "$old_paths_sorted" "$new_paths_sorted" > "$obsolete_paths_file"
    fi

    # 5a. Create target directories
    while IFS= read -r fline || [ -n "$fline" ]; do
        [ -n "$fline" ] || continue
        verify_destination_path_safety "$fline"
        case "$fline" in
            */)
                local target_dir="${TARGET_ROOT}/${fline%/}"
                if [ ! -d "$target_dir" ]; then
                    mkdir -p "$target_dir" || rollback_transaction
                fi
                ;;
        esac
    done < "$STAGING_DIR/.META/files"

    # 5b. Move files atomically with rename(2)
    while IFS= read -r fline || [ -n "$fline" ]; do
        [ -n "$fline" ] || continue
        case "$fline" in
            */)
                ;;
            *)
                verify_destination_path_safety "$fline"
                local src_path="$STAGING_DIR/x/$fline"
                local dst_path="${TARGET_ROOT}/$fline"
                local dst_dir
                dst_dir="$(dirname "$dst_path")"

                mkdir -p "$dst_dir" || rollback_transaction

                if [ -e "$dst_path" ] || [ -L "$dst_path" ]; then
                    # Backup existing file for rollback without removing it from dst_path
                    local bak_path="$ROLLBACK_BACKUP/$fline"
                    mkdir -p "$(dirname "$bak_path")"
                    cp -a "$dst_path" "$bak_path" || rollback_transaction
                else
                    printf '%s\n' "$dst_path" >> "$ROLLBACK_CREATED"
                fi

                # Atomic replacement via mv (calls rename(2) avoiding ETXTBSY)
                mv -f "$src_path" "$dst_path" || rollback_transaction
                ;;
        esac
    done < "$STAGING_DIR/.META/files"

    # 5c. Prune obsolete files from previous version (self-upgrade)
    if [ "$is_upgrade" = true ] && [ -s "$obsolete_paths_file" ]; then
        log "Pruning obsolete files from previous package version..."
        local tmp_sorted_obs="$STAGING_DIR/.sorted_obsolete"
        awk '{
            orig = $0
            p = $0
            is_dir = (p ~ /\/$/) ? 0 : 1
            sub(/\/$/, "", p)
            n = gsub(/\//, "/", p)
            print n "\t" is_dir "\t" orig
        }' "$obsolete_paths_file" | sort -k1,1nr -k2,2nr | cut -f3- > "$tmp_sorted_obs"

        while IFS= read -r p || [ -n "$p" ]; do
            [ -n "$p" ] || continue
            local is_dir=false
            case "$p" in
                */) is_dir=true ;;
            esac
            local clean_p="${p%/}"
            local dst_path="${TARGET_ROOT}${clean_p}"

            if [ "$is_dir" = true ]; then
                rmdir "$dst_path" 2>/dev/null || true
                rmdir "$(dirname "$dst_path")" 2>/dev/null || true
            else
                if [ -f "$dst_path" ] || [ -L "$dst_path" ]; then
                    local rel_bak="${p#/}"
                    local bak_path="$ROLLBACK_BACKUP/$rel_bak"
                    mkdir -p "$(dirname "$bak_path")"
                    mv -f "$dst_path" "$bak_path" || rollback_transaction
                    rmdir "$(dirname "$dst_path")" 2>/dev/null || true
                fi
            fi
        done < "$tmp_sorted_obs"
        rm -f "$tmp_sorted_obs"
    fi

    log "Step 6/6: Committing metadata to database..."
    local pkg_installed_dir="$INSTALLED_DIR/$pkg_name"
    mkdir -p "$pkg_installed_dir" || rollback_transaction

    # Identify dropped dependencies for package upgrades
    local dropped_deps_file="$STAGING_DIR/.dropped_deps"
    rm -f "$dropped_deps_file"
    touch "$dropped_deps_file"
    if [ -f "$pkg_installed_dir/depends" ]; then
        local old_deps_file="$STAGING_DIR/.old_deps"
        local new_deps_file="$STAGING_DIR/.new_deps"
        awk '{ for (i=1; i<=NF; i++) { gsub(/,/, "", $i); if (length($i)) print $i } }' "$pkg_installed_dir/depends" | LC_ALL=C sort -u > "$old_deps_file"
        if [ -f "$STAGING_DIR/.META/depends" ]; then
            awk '{ for (i=1; i<=NF; i++) { gsub(/,/, "", $i); if (length($i)) print $i } }' "$STAGING_DIR/.META/depends" | LC_ALL=C sort -u > "$new_deps_file"
        else
            touch "$new_deps_file"
        fi
        comm -23 "$old_deps_file" "$new_deps_file" > "$dropped_deps_file"
        rm -f "$old_deps_file" "$new_deps_file"
        if [ -s "$dropped_deps_file" ]; then
            cp -p "$dropped_deps_file" "$ROLLBACK_JOURNAL/dropped_rdeps" 2>/dev/null || true
        fi
    fi

    cp -p "$STAGING_DIR/.META/package" "$pkg_installed_dir/package" || rollback_transaction
    cp -p "$STAGING_DIR/.META/sha256" "$pkg_installed_dir/sha256" || rollback_transaction
    [ -f "$STAGING_DIR/.META/depends" ] && cp -p "$STAGING_DIR/.META/depends" "$pkg_installed_dir/depends" || touch "$pkg_installed_dir/depends" || rollback_transaction
    printf '%s-%s\n' "$pkg_version" "$pkg_release" > "$pkg_installed_dir/version" || rollback_transaction

    # Write absolute paths into files.list
    awk '{ print "/" $0 }' "$STAGING_DIR/.META/files" > "$pkg_installed_dir/files.list" || rollback_transaction

    # Update providers index
    local tmp_providers="${STAGING_DIR}/.providers.tmp"
    if [ -f "$PROVIDERS_FILE" ]; then
        awk -v pkg="$pkg_name" -F'\t' '$NF != pkg' "$PROVIDERS_FILE" > "$tmp_providers" || rollback_transaction
    else
        touch "$tmp_providers" || rollback_transaction
    fi

    while IFS= read -r fline || [ -n "$fline" ]; do
        [ -n "$fline" ] || continue
        case "$fline" in
            */) ;;
            *)
                printf '/%s\t%s\n' "$fline" "$pkg_name" >> "$tmp_providers"
                ;;
        esac
    done < "$STAGING_DIR/.META/files"

    LC_ALL=C sort -u "$tmp_providers" -o "$PROVIDERS_FILE" || rollback_transaction
    rm -f "$tmp_providers"

    # Update reverse dependencies index (rdeps)
    if [ -s "$dropped_deps_file" ]; then
        while IFS= read -r dropped_dep || [ -n "$dropped_dep" ]; do
            dropped_dep="$(echo "$dropped_dep" | tr -d '[:space:]')"
            [ -n "$dropped_dep" ] || continue
            local rdep_file="$RDEPS_DIR/$dropped_dep"
            if [ -f "$rdep_file" ]; then
                local tmp_rdep="${STAGING_DIR}/.rdep_${dropped_dep}.tmp"
                awk -v pkg="$pkg_name" -F'\t' '$NF != pkg' "$rdep_file" > "$tmp_rdep" || rollback_transaction
                if [ -s "$tmp_rdep" ]; then
                    mv -f "$tmp_rdep" "$rdep_file" || rollback_transaction
                else
                    rm -f "$rdep_file" "$tmp_rdep" || rollback_transaction
                fi
            fi
        done < "$dropped_deps_file"
    fi

    if [ -s "$pkg_installed_dir/depends" ]; then
        while IFS= read -r dep || [ -n "$dep" ]; do
            dep="$(echo "$dep" | tr -d '[:space:]')"
            [ -n "$dep" ] || continue
            mkdir -p "$RDEPS_DIR" || rollback_transaction
            if [ -e "$RDEPS_DIR/$dep" ] && [ ! -f "$RDEPS_DIR/$dep" ]; then
                rollback_transaction
            fi
            printf '%s\t%s\n' "$dep" "$pkg_name" >> "$RDEPS_DIR/$dep" || rollback_transaction
            LC_ALL=C sort -u "$RDEPS_DIR/$dep" -o "$RDEPS_DIR/$dep" || rollback_transaction
        done < "$pkg_installed_dir/depends"
    fi

    # Update world manifest
    local tmp_world="${STAGING_DIR}/.world.tmp"
    [ -f "$WORLD_FILE" ] && cp -p "$WORLD_FILE" "$tmp_world" || touch "$tmp_world" || rollback_transaction
    printf '%s\n' "$pkg_name" >> "$tmp_world"
    LC_ALL=C sort -u "$tmp_world" -o "$WORLD_FILE" || rollback_transaction
    rm -f "$tmp_world"

    # Purge staging directory
    IN_TRANSACTION=false
    rm -rf "$STAGING_DIR"
    CURRENT_STAGING_DIR=""
    CURRENT_PKG_NAME=""

    log "SUCCESS: Installed package '$pkg_name' ($pkg_version-$pkg_release)"
    release_lock
}

# Subcommand: remove
cmd_remove() {
    [ $# -ge 1 ] || die "Missing package name for 'remove' subcommand"
    local pkg_name=""
    local force="$FORCE"
    while [ $# -gt 0 ]; do
        case "$1" in
            -f|--force)
                force=true
                shift
                ;;
            *)
                if [ -z "$pkg_name" ]; then
                    pkg_name="$1"
                fi
                shift
                ;;
        esac
    done
    [ -n "$pkg_name" ] || die "Missing package name for 'remove' subcommand"

    acquire_lock

    local pkg_installed_dir="$INSTALLED_DIR/$pkg_name"
    [ -d "$pkg_installed_dir" ] || {
        release_lock
        die "Package '$pkg_name' is not installed"
    }

    # Check base package protection
    local pmanifest="$pkg_installed_dir/package"
    local is_base="false"
    if [ -f "$pmanifest" ]; then
        is_base="$(get_val "$pmanifest" "base")"
    fi
    if [ "$is_base" = "true" ] && [ "$force" != true ]; then
        release_lock
        die "Cannot remove base system package '$pkg_name' without --force (marked base=true)"
    fi

    # Check reverse dependencies
    if [ -f "$RDEPS_DIR/$pkg_name" ] && [ -s "$RDEPS_DIR/$pkg_name" ]; then
        local dependents
        dependents="$(awk '{print $NF}' "$RDEPS_DIR/$pkg_name" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
        release_lock
        die "Cannot remove '$pkg_name': required by dependent package(s): $dependents"
    fi

    log "Step 1/2: Removing package files bottom-up..."
    local files_list="$pkg_installed_dir/files.list"
    if [ -f "$files_list" ]; then
        # Sort paths in reverse depth order: files before directories, deepest paths first
        local tmp_sorted_rem="${SPM_DB_DIR}/.sorted_rem.$$"
        awk '{
            orig = $0
            p = $0
            is_dir = (p ~ /\/$/) ? 0 : 1
            sub(/\/$/, "", p)
            n = gsub(/\//, "/", p)
            print n "\t" is_dir "\t" orig
        }' "$files_list" | sort -k1,1nr -k2,2nr | cut -f3- > "$tmp_sorted_rem"

        while IFS= read -r p || [ -n "$p" ]; do
            [ -n "$p" ] || continue
            local is_dir=false
            case "$p" in
                */) is_dir=true ;;
            esac
            local clean_p="${p%/}"
            local dst_path="${TARGET_ROOT}${clean_p}"

            if [ "$is_dir" = true ]; then
                # Safe bottom-up rmdir on empty directories only (zero rm -rf)
                rmdir "$dst_path" 2>/dev/null || true
                rmdir "$(dirname "$dst_path")" 2>/dev/null || true
            else
                # Regular file or symlink removal without dereferencing
                if [ -f "$dst_path" ] || [ -L "$dst_path" ]; then
                    rm -f -- "$dst_path"
                    rmdir "$(dirname "$dst_path")" 2>/dev/null || true
                fi
            fi
        done < "$tmp_sorted_rem"
        rm -f "$tmp_sorted_rem"
    fi

    log "Step 2/2: Cleaning database records..."
    # Update reverse dependencies index
    if [ -f "$pkg_installed_dir/depends" ]; then
        while IFS= read -r dep || [ -n "$dep" ]; do
            dep="$(echo "$dep" | tr -d '[:space:]')"
            [ -n "$dep" ] || continue
            if [ -f "$RDEPS_DIR/$dep" ]; then
                local tmp_rdep="${RDEPS_DIR}/.${dep}.tmp.$$"
                awk -v pkg="$pkg_name" -F'\t' '$NF != pkg' "$RDEPS_DIR/$dep" > "$tmp_rdep" || true
                if [ -s "$tmp_rdep" ]; then
                    mv -f "$tmp_rdep" "$RDEPS_DIR/$dep"
                else
                    rm -f "$RDEPS_DIR/$dep" "$tmp_rdep"
                fi
            fi
        done < "$pkg_installed_dir/depends"
    fi

    # Clean providers index
    if [ -f "$PROVIDERS_FILE" ]; then
        local tmp_prov="${PROVIDERS_FILE}.tmp.$$"
        awk -v pkg="$pkg_name" -F'\t' '$NF != pkg' "$PROVIDERS_FILE" > "$tmp_prov" || true
        mv -f "$tmp_prov" "$PROVIDERS_FILE"
    fi

    # Clean world list
    if [ -f "$WORLD_FILE" ]; then
        local tmp_world="${WORLD_FILE}.tmp.$$"
        awk -v pkg="$pkg_name" '$1 != pkg' "$WORLD_FILE" > "$tmp_world" || true
        mv -f "$tmp_world" "$WORLD_FILE"
    fi

    # Clean package installation records
    rm -f "$RDEPS_DIR/$pkg_name" 2>/dev/null || true
    rm -rf "$pkg_installed_dir"

    log "SUCCESS: Package '$pkg_name' successfully removed"
    release_lock
}

# Main dispatcher
case "$SUBCOMMAND" in
    init)
        cmd_init "$@"
        ;;
    list)
        cmd_list "$@"
        ;;
    info)
        cmd_info "$@"
        ;;
    query)
        cmd_query "$@"
        ;;
    install)
        cmd_install "$@"
        ;;
    remove)
        cmd_remove "$@"
        ;;
    *)
        die "Unknown subcommand: $SUBCOMMAND (see --help)"
        ;;
esac
