#!/bin/sh
# sane-account-recovery -- boot-time guard against broken identity files.
#
# Runs as a `once` service before firstboot/getty. A corrupt passwd, group,
# shadow or doas.conf must never lock the console out: validate first, and
# rebuild from the baseline if validation fails.
set -u
# Overridable for unit tests; production uses the installed CLI.
CLI=${SANE_ACCOUNTS_CLI:-/usr/bin/sane-accounts}
BUSYBOX=${SANE_RECOVERY_BUSYBOX:-/bin/busybox}

# Older images may ship a BusyBox without awk/mktemp symlinks. sane-accounts
# needs both for validation and for its atomic file rewrites.
# PR #31 policy: never clobber an existing regular file. Create the link
# only when the path is fully absent ([ ! -e ] && [ ! -L ]); repair an
# existing symlink ([ -L ], including a dangling one); a symlink already
# resolving to busybox is left untouched. A regular file occupying the
# path is skipped (it may be a real tool). The /bin fallback applies only
# when a link attempt fails (e.g. unwritable directory), same policy.
for applet in awk mktemp; do
    command -v "$applet" >/dev/null 2>&1 && continue
    if [ -x "$BUSYBOX" ]; then
        BIN_DIR=${SANE_RECOVERY_BIN_DIR:-/usr/bin}
        for dest in "$BIN_DIR/$applet" "/bin/$applet"; do
            if [ -e "$dest" ] && [ ! -L "$dest" ]; then
                break
            fi
            if [ ! -e "$dest" ] && [ ! -L "$dest" ]; then
                ln -s "$BUSYBOX" "$dest" 2>/dev/null && break
            elif [ -L "$dest" ]; then
                # -ef is supported by every target shell (dash, BusyBox ash,
                # bash). A stat-based inode comparison would add an external
                # dependency this guard cannot assume: it runs precisely when
                # applets are missing from the image.
                # shellcheck disable=SC3013
                [ "$dest" -ef "$BUSYBOX" ] && break
                ln -sfn "$BUSYBOX" "$dest" 2>/dev/null && break
            fi
        done
    fi
done

if [ ! -x "$CLI" ]; then
    printf 'recovery: %s missing or not executable; cannot validate accounts\n' "$CLI" >&2
    exit 1
fi

run_cli() {
    if [ "$(id -u 2>/dev/null || true)" = "0" ]; then
        "$CLI" "$@"
    else
        "$CLI" --skip-owner-check "$@"
    fi
}

if run_cli validate >/dev/null 2>&1; then
    exit 0
fi

printf '=== S.A.N.E account recovery: identity files invalid ===\n'
run_cli recover || {
    printf 'recovery: rebuild failed; failing closed for supervised rescue\n' >&2
    exit 1
}
run_cli validate || {
    printf 'recovery: validation still failing; failing closed for supervised rescue\n' >&2
    exit 1
}
exit 0
