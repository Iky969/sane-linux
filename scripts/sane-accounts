#!/bin/sh
# sane-accounts -- S.A.N.E account lifecycle and policy validation.
#
# Build-time / host-side tool that operates on a target rootfs (--root DIR).
# It never touches the host's /etc unless --root / is passed explicitly.
# POSIX sh, fail-closed: invalid input exits non-zero without partial edits.
#
# Subcommands:
#   init [--force] [--firstboot|--allow-weak-defaults]
#                                write baseline passwd/group/shadow/doas.conf
#   add-user NAME [UID] [GROUP]  create account, group and home (locked by default)
#   del-user NAME [--remove-home] remove account, group membership and home
#   set-password NAME            read password from stdin, write SHA-512 hash
#   lock NAME | unlock NAME      prefix/remove the shadow lock marker
#   list                         list accounts
#   validate                     audit files, hashes and doas policy
#   recover                      repair identity files without lockout (merge)
#
set -eu

PROG=${0##*/}
ROOT=/
VERBOSE=0
FORCE=0
SKIP_CHOWN=0
FIRSTBOOT=0
SKIP_OWNER=0
ALLOW_WEAK_DEFAULTS=0
# NOTE (K1): no default password hash is shipped in this repo any more.
# The pre-v1.3.0 deterministic root/root and sane/sane hashes were removed;
# they remain in git history, so treat any v1.2.0 image as using publicly
# known credentials and do not distribute it.

usage() {
	cat <<EOF
Usage: $PROG [--root DIR] [--force] [--skip-chown] [--firstboot|--allow-weak-defaults] <command> [args]

Commands:
  init [--force] [--firstboot|--allow-weak-defaults]
                              write baseline identity files (refuse overwrite)
  add-user NAME [UID] [GROUP]   create a locked account + home
  del-user NAME [--remove-home] remove an account
  set-password NAME             read password from stdin (one line)
  lock NAME                     lock an account (prefix '!' in shadow)
  unlock NAME                   unlock an account
  list                          list accounts
  validate                      audit account files and doas policy
  recover                       repair broken identity files (merge); re-run firstboot if needed
EOF
}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
note() { [ "$VERBOSE" -eq 1 ] && printf 'ok: %s\n' "$*"; return 0; }

while [ "$#" -gt 0 ]; do
	case "$1" in
		--root)
			[ "$#" -ge 2 ] || die "--root needs a directory"
			ROOT=$2; shift 2 ;;
		-v|--verbose) VERBOSE=1; shift ;;
		--force) FORCE=1; shift ;;
		--skip-chown) SKIP_CHOWN=1; shift ;;
		--firstboot) FIRSTBOOT=1; shift ;;
		--allow-weak-defaults) ALLOW_WEAK_DEFAULTS=1; shift ;;
		--skip-owner-check) SKIP_OWNER=1; shift ;;
		-h|--help) usage; exit 0 ;;
		--) shift; break ;;
		-*) die "unknown option: $1" ;;
		*) break ;;
	esac
done

[ "$#" -ge 1 ] || { usage >&2; exit 1; }
CMD=$1; shift

case "$ROOT" in
	/*) ;;
	*) die "--root must be an absolute path" ;;
esac

ETC="$ROOT/etc"
HOME_BASE="$ROOT/home"
PASSWD="$ETC/passwd"
GROUP="$ETC/group"
SHADOW="$ETC/shadow"
DOAS_CONF="$ETC/doas.conf"

mode_of() {
	stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null || printf '?'
}

owner_of() {
	stat -c '%u:%g' "$1" 2>/dev/null || stat -f '%u:%g' "$1" 2>/dev/null || printf '?:?'
}

# A SHA-512 crypt hash is $6$<salt>$<checksum>: salt 1-16 chars, checksum
# exactly 86 chars, both from [./A-Za-z0-9]. A bare "$6$" prefix (e.g. a hash
# truncated by an interrupted passwd) must NOT count as usable, otherwise the
# recovery service accepts it and firstboot stays marked done with no login.
valid_sha512_hash() {
	case "$1" in
		'$6$'*) ;;
		*) return 1 ;;
	esac
	awk -v h="${1#\$6\$}" 'BEGIN {
		n = split(h, part, "\\$")
		if (n != 2) exit 1
		salt = part[1]; sum = part[2]
		if (salt == "" || length(salt) > 16 || salt ~ /[^.\/A-Za-z0-9]/) exit 1
		if (length(sum) != 86 || sum ~ /[^.\/A-Za-z0-9]/) exit 1
		exit 0
	}'
}

ensure_etc() {
	[ -d "$ETC" ] || die "target root has no /etc: $ETC"
}

ensure_base() {
	ensure_etc
	[ -f "$PASSWD" ] || printf 'root:x:0:0:root:/root:/bin/sh\n' > "$PASSWD"
	[ -f "$GROUP" ] || printf 'root:x:0:\n' > "$GROUP"
	[ -f "$SHADOW" ] || printf 'root:!:19700:0:99999:7:::\n' > "$SHADOW"
	chmod 0644 "$PASSWD" "$GROUP"
	chmod 0600 "$SHADOW"
}

# Password policy (S3): at least 12 characters, and never the account name
# itself (case-insensitive). Enforced by set-password, by the
# --allow-weak-defaults init path, and (mirrored) by sane-firstboot.
check_password_policy() {
	name=$1; password=$2
	[ "$(printf '%s' "$password" | wc -m)" -ge 12 ] || die "password for '$name' is too short (minimum 12 characters)"
	lower_name=$(printf '%s' "$name" | tr 'A-Z' 'a-z')
	lower_pw=$(printf '%s' "$password" | tr 'A-Z' 'a-z')
	[ "$lower_pw" != "$lower_name" ] || die "password for '$name' must not be the account name"
}

valid_name() {
	case "$1" in
		''|*[!a-z0-9_-]*) return 1 ;;
	esac
	case "$1" in
		[a-z_]* ) return 0 ;;
		*) return 1 ;;
	esac
}

user_exists() { awk -F: -v n="$1" '$1==n {found=1} END{exit !found}' "$PASSWD"; }
group_exists() { awk -F: -v n="$1" '$1==n {found=1} END{exit !found}' "$GROUP"; }

field_of() {
	# field_of FILE NAME FIELD
	awk -F: -v n="$2" -v f="$3" '$1==n {print $f; exit}' "$1"
}

set_field() {
	# set_field FILE NAME FIELD VALUE -- atomic rewrite via unpredictable temp
	file=$1; name=$2; field=$3; value=$4
	dir=$(dirname "$file")
	tmp=$(mktemp "$dir/.sane-accounts.XXXXXX") || die "cannot create temp file in $dir"
	if ! awk -v n="$name" -v f="$field" -v v="$value" \
		'BEGIN{FS=OFS=":"} $1==n {$f=v} {print}' "$file" > "$tmp"; then
		rm -f "$tmp"
		die "failed to rewrite $file"
	fi
	mv "$tmp" "$file"
}

next_id() {
	# next_id FILE -- smallest free id in 1000..65534. First-free scan,
	# not max+1: a high-uid import (e.g. nobody 65534) must not exhaust
	# the range, and gaps below the maximum are reused. Prints nothing
	# when the whole range is in use; callers report a clean error.
	awk -F: '{used[$3+0]=1} END{
		for (i = 1000; i <= 65534; i++)
			if (!(i in used)) { print i; exit }
	}' "$1"
}

cmd_init() {
	# --force is also accepted after the subcommand for convenience.
	if [ "${1:-}" = "--force" ]; then
		FORCE=1
	fi
	if [ "${1:-}" = "--firstboot" ]; then
		FIRSTBOOT=1
	fi
	if [ "${2:-}" = "--firstboot" ]; then
		FIRSTBOOT=1
	fi
	if [ "${1:-}" = "--allow-weak-defaults" ] || [ "${2:-}" = "--allow-weak-defaults" ]; then
		ALLOW_WEAK_DEFAULTS=1
	fi
	# Fail closed BEFORE writing anything (K1): without --firstboot there is
	# no password to write any more, and without --allow-weak-defaults plus
	# runtime passwords there is nothing safe to fall back to. Validate the
	# runtime passwords here too, so a missing/weak one also fails before
	# any passwd/group file is touched.
	if [ "$FIRSTBOOT" -ne 1 ] && [ "$ALLOW_WEAK_DEFAULTS" -ne 1 ]; then
		die "refusing to write password accounts without --firstboot; use --firstboot (locked accounts), or set passwords explicitly with set-password"
	fi
	if [ "$ALLOW_WEAK_DEFAULTS" -eq 1 ] && [ "$FIRSTBOOT" -ne 1 ]; then
		[ -n "${SANE_TEST_ROOT_PASSWORD:-}" ] || die "--allow-weak-defaults requires SANE_TEST_ROOT_PASSWORD in the environment"
		[ -n "${SANE_TEST_SANE_PASSWORD:-}" ] || die "--allow-weak-defaults requires SANE_TEST_SANE_PASSWORD in the environment"
		check_password_policy root "$SANE_TEST_ROOT_PASSWORD"
		check_password_policy sane "$SANE_TEST_SANE_PASSWORD"
	fi
	if [ "$FORCE" -ne 1 ]; then
		for f in "$PASSWD" "$GROUP" "$SHADOW" "$DOAS_CONF"; do
			[ -e "$f" ] && die "refusing to overwrite existing ${f#$ROOT}; use --force"
		done
	fi
	ensure_etc
	mkdir -p "$HOME_BASE/sane"
	printf 'root:x:0:0:root:/root:/bin/sh\nsane:x:1000:1000:S.A.N.E User:/home/sane:/bin/sh\n' > "$PASSWD"
	printf 'root:x:0:\nwheel:x:10:root,sane\nsane:x:1000:\n' > "$GROUP"
	if [ "$FIRSTBOOT" -eq 1 ]; then
		# No public password: accounts stay locked until sane-firstboot sets them.
		printf 'root:!:19700:0:99999:7:::\nsane:!:19700:0:99999:7:::\n' > "$SHADOW"
	elif [ "$ALLOW_WEAK_DEFAULTS" -eq 1 ]; then
		# Test-only path (K1): there is no deterministic hash any more.
		# Passwords must be supplied at runtime via the environment
		# (never committed); without them init refuses to write accounts.
		root_pw=${SANE_TEST_ROOT_PASSWORD:-}
		sane_pw=${SANE_TEST_SANE_PASSWORD:-}
		[ -n "$root_pw" ] || die "--allow-weak-defaults requires SANE_TEST_ROOT_PASSWORD in the environment"
		[ -n "$sane_pw" ] || die "--allow-weak-defaults requires SANE_TEST_SANE_PASSWORD in the environment"
		check_password_policy root "$root_pw"
		check_password_policy sane "$sane_pw"
		command -v openssl >/dev/null 2>&1 || die "openssl is required to hash passwords"
		root_hash=$(printf '%s' "$root_pw" | openssl passwd -6 -salt "$(openssl rand -hex 8)" -stdin) || die "failed to hash root password"
		sane_hash=$(printf '%s' "$sane_pw" | openssl passwd -6 -salt "$(openssl rand -hex 8)" -stdin) || die "failed to hash sane password"
		printf 'root:%s:19700:0:99999:7:::\nsane:%s:19700:0:99999:7:::\n' \
			"$root_hash" "$sane_hash" > "$SHADOW"
	else
		die "refusing to write password accounts without --firstboot; use --firstboot (locked accounts), or set passwords explicitly with set-password"
	fi
	printf 'permit persist :wheel\n' > "$DOAS_CONF"
	chmod 0644 "$PASSWD" "$GROUP"
	chmod 0600 "$SHADOW" "$DOAS_CONF"
	[ "$ROOT" = "/" ] && chown 0:0 "$DOAS_CONF" 2>/dev/null || true
	chmod 0750 "$HOME_BASE/sane"
	note "baseline identity files written to $ETC"
}

cmd_add_user() {
	[ "$#" -ge 1 ] || die "add-user needs a name"
	name=$1; shift
	uid=; group=
	skip_chown=$SKIP_CHOWN
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--skip-chown) skip_chown=1 ;;
			*)
				if [ -z "$uid" ]; then
					uid=$1
				elif [ -z "$group" ]; then
					group=$1
				else
					die "too many arguments to add-user"
				fi
				;;
		esac
		shift
	done
	[ -n "$group" ] || group=$name
	valid_name "$name" || die "invalid account name: $name"
	[ "$name" = "root" ] && die "refusing to add the reserved 'root' account"
	ensure_base
	user_exists "$name" && die "account already exists: $name"

	if [ -z "$uid" ]; then
		uid=$(next_id "$PASSWD")
		[ -n "$uid" ] || die "no free uid in range 1000..65534"
	fi
	case "$uid" in
		''|*[!0-9]*) die "uid must be numeric: $uid" ;;
	esac
	[ "$uid" -ge 1000 ] && [ "$uid" -le 65534 ] || die "uid out of range: $uid"
	if awk -F: -v u="$uid" '$3==u {found=1} END{exit !found}' "$PASSWD"; then
		die "uid already in use: $uid"
	fi

	created_group=0
	if group_exists "$group"; then
		gid=$(field_of "$GROUP" "$group" 3)
	else
		valid_name "$group" || die "invalid group name: $group"
		# A default private group shares the account's UID.
		if [ "$group" = "$name" ] && [ -n "$uid" ]; then
			gid=$uid
		else
			gid=$(next_id "$GROUP")
			[ -n "$gid" ] || die "no free gid in range 1000..65534"
		fi
		if awk -F: -v g="$gid" '$3==g {found=1} END{exit !found}' "$GROUP"; then
			die "gid already in use: $gid"
		fi
		created_group=1
	fi
	case "$gid" in
		''|*[!0-9]*) die "gid must be numeric: $gid" ;;
	esac

	# Create the home FIRST: if that fails, no identity entry is left behind.
	home="$HOME_BASE/$name"
	if [ -e "$home" ] && [ ! -d "$home" ]; then
		die "home path exists but is not a directory: $home"
	fi
	mkdir -p "$home" || die "cannot create home directory: $home"
	chmod 0750 "$home" || { rmdir "$home" 2>/dev/null || true; die "cannot set home mode: $home"; }
	if [ "$skip_chown" -eq 1 ]; then
		note "WARNING: ownership of $home not set (--skip-chown)"
	else
		if ! chown "$uid:$gid" "$home"; then
			rmdir "$home" 2>/dev/null || true
			die "cannot set ownership of $home to $uid:$gid; use --skip-chown only for non-privileged test builds"
		fi
	fi

	rollback_add() {
		# Undo every partial edit so a failed add cannot leave a ghost account.
		for file in "$PASSWD" "$SHADOW"; do
			tmp=$(mktemp "$(dirname "$file")/.sane-accounts.XXXXXX") || continue
			awk -v n="$name" 'BEGIN{FS=OFS=":"} $1!=n {print}' "$file" > "$tmp"
			mv "$tmp" "$file"
		done
		tmp=$(mktemp "$(dirname "$GROUP")/.sane-accounts.XXXXXX") || return 0
		if [ "$created_group" -eq 1 ]; then
			# The group was created for this account but is named independently
			# ($group), so it must be removed by group name, not account name.
			awk -v n="$group" 'BEGIN{FS=OFS=":"} $1!=n {print}' "$GROUP" > "$tmp"
		else
			awk -v n="$name" 'BEGIN{FS=OFS=":"} {
				if ($4!="") {
					out=""; c=0; k=split($4,a,",")
					for (i=1;i<=k;i++) if (a[i]!="" && a[i]!=n) {
						out=out (c?",":"") a[i]; c++
					}
					$4=out
				}
				print
			}' "$GROUP" > "$tmp"
		fi
		mv "$tmp" "$GROUP"
		# mktemp files are 0600; restore the canonical modes after replacing
		# passwd/group/shadow with those temp files.
		chmod 0644 "$PASSWD" "$GROUP" 2>/dev/null || true
		chmod 0600 "$SHADOW" 2>/dev/null || true
		rmdir "$home" 2>/dev/null || true
	}

	if [ "$created_group" -eq 1 ]; then
		if ! printf '%s:x:%s:\n' "$group" "$gid" >> "$GROUP"; then
			rmdir "$home" 2>/dev/null || true
			die "failed to write group entry"
		fi
	else
		tmp=$(mktemp "$(dirname "$GROUP")/.sane-accounts.XXXXXX") || die "cannot create temp file"
		if ! awk -v n="$name" -v g="$group" 'BEGIN{FS=OFS=":"} $1==g {
			k=split($4,a,","); found=0
			for (i=1;i<=k;i++) if (a[i]==n) found=1
			if (!found) $4 = ($4=="" ? n : $4 "," n)
		} {print}' "$GROUP" > "$tmp"; then
			rm -f "$tmp"; rmdir "$home" 2>/dev/null || true
			die "failed to update group membership"
		fi
		mv "$tmp" "$GROUP"
	fi

	if ! printf '%s:x:%s:%s:%s:/home/%s:/bin/sh\n' \
		"$name" "$uid" "$gid" "$name" "$name" >> "$PASSWD"; then
		rollback_add; die "failed to write passwd entry"
	fi
	if ! printf '%s:!:19700:0:99999:7:::\n' "$name" >> "$SHADOW"; then
		rollback_add; die "failed to write shadow entry"
	fi
	chmod 0644 "$PASSWD" "$GROUP"; chmod 0600 "$SHADOW"
	note "created $name (uid=$uid gid=$gid, locked, home=/home/$name)"
}

cmd_del_user() {
	[ "$#" -ge 1 ] || die "del-user needs a name"
	name=$1; remove_home=0
	if [ "$#" -eq 2 ] && [ "$2" = "--remove-home" ]; then
		remove_home=1
	elif [ "$#" -gt 1 ]; then
		die "usage: del-user NAME [--remove-home]"
	fi
	valid_name "$name" || die "invalid account name: $name"
	[ "$name" = "root" ] && die "refusing to delete the reserved 'root' account"
	ensure_base
	user_exists "$name" || die "no such account: $name"

	# Never delete a private group that another account still relies on.
	keep_group=0
	if group_exists "$name"; then
		ggid=$(field_of "$GROUP" "$name" 3)
		if awk -F: -v g="$ggid" -v n="$name" \
			'$1!=n && $4==g {found=1} END{exit !found}' "$PASSWD"; then
			keep_group=1
		elif awk -F: -v n="$name" '$1==n {
			k=split($4,a,","); for(i=1;i<=k;i++) if(a[i]!="" && a[i]!=n) found=1
		} END{exit !found}' "$GROUP"; then
			keep_group=1
		fi
		if [ "$keep_group" -eq 1 ]; then
			note "keeping group '$name' (gid=$ggid): still in use by another account"
		fi
	fi

	for file in "$PASSWD" "$SHADOW"; do
		tmp=$(mktemp "$(dirname "$file")/.sane-accounts.XXXXXX") || die "cannot create temp file"
		awk -v n="$name" 'BEGIN{FS=OFS=":"} $1!=n {print}' "$file" > "$tmp"
		mv "$tmp" "$file"
	done
	tmp=$(mktemp "$(dirname "$GROUP")/.sane-accounts.XXXXXX") || die "cannot create temp file"
	awk -v n="$name" -v keep="$keep_group" 'BEGIN{FS=OFS=":"} {
		if ($1==n && keep!="1") next
		if ($4!="") {
			out=""; c=0; k=split($4,a,",")
			for (i=1;i<=k;i++) if (a[i]!="" && a[i]!=n) {
				out=out (c?",":"") a[i]; c++
			}
			$4=out
		}
		print
	}' "$GROUP" > "$tmp"
	mv "$tmp" "$GROUP"
	if [ "$remove_home" -eq 1 ]; then
		case "$name" in
			''|*/*|.|..) die "unsafe home name: $name" ;;
		esac
		[ -d "$HOME_BASE/$name" ] && rm -rf -- "${HOME_BASE:?}/${name:?}"
	fi
	chmod 0644 "$PASSWD" "$GROUP"; chmod 0600 "$SHADOW"
	note "removed $name"
}

cmd_set_password() {
	[ "$#" -eq 1 ] || die "usage: set-password NAME (password on stdin)"
	name=$1
	# Read one line from stdin: keeps the secret out of argv and shell history.
	password=
	IFS= read -r password || true
	ensure_base
	user_exists "$name" || die "no such account: $name"
	[ -n "$password" ] || die "refusing to set an empty password"
	check_password_policy "$name" "$password"
	command -v openssl >/dev/null 2>&1 || die "openssl is required to hash passwords"
	salt=$(openssl rand -hex 8)
	[ -n "$salt" ] || die "failed to generate salt"
	hash=$(printf '%s' "$password" | openssl passwd -6 -salt "$salt" -stdin)
	case "$hash" in
		'$6$'*) ;;
		*) die "unexpected hash format from openssl" ;;
	esac
	# Drop a lock marker so the new password is usable.
	hash=$(printf '%s' "$hash")
	set_field "$SHADOW" "$name" 2 "$hash"
	chmod 0600 "$SHADOW"
	note "password updated for $name (SHA-512 crypt)"
}

cmd_lock() {
	[ "$#" -eq 1 ] || die "usage: lock NAME"
	name=$1; ensure_base; user_exists "$name" || die "no such account: $name"
	h=$(field_of "$SHADOW" "$name" 2)
	case "$h" in '!'*) note "$name already locked"; return 0 ;; esac
	set_field "$SHADOW" "$name" 2 "!$h"; chmod 0600 "$SHADOW"
	note "locked $name"
}

cmd_unlock() {
	[ "$#" -eq 1 ] || die "usage: unlock NAME"
	name=$1; ensure_base; user_exists "$name" || die "no such account: $name"
	h=$(field_of "$SHADOW" "$name" 2)
	case "$h" in
		'!'*) h=${h#\!} ;;
		*) note "$name already unlocked"; return 0 ;;
	esac
	# A lock marker without a real hash must never become an empty password
	# field: some login implementations treat that as passwordless access.
	case "$h" in
		''|'*'|'!'*) die "account '$name' has no usable password hash; run set-password first" ;;
		'$6$'*) ;;
		*) die "account '$name' has an unsupported password hash; refusing to unlock" ;;
	esac
	set_field "$SHADOW" "$name" 2 "$h"; chmod 0600 "$SHADOW"
	note "unlocked $name"
}

cmd_list() {
	ensure_base
	printf 'UID  GID  USER\n'
	awk -F: '{printf "%-4s %-4s %s\n", $3, $4, $1}' "$PASSWD"
}

FAIL=0
audit_fail() { printf 'FAIL: %s\n' "$*" >&2; FAIL=$((FAIL+1)); }

# doas policy scans shared by validate and recover so both enforce the
# identical rule boundary. Inline comments are stripped first so comment
# text is never a grant, and tokens are compared strictly so a setenv value
# like X=nopass is not mistaken for the nopass option. A setenv { ... }
# block is skipped as a whole: "as" and "cmd" INSIDE the braces are
# environment variable names, not option terminators, so a nopass after the
# closing brace is still an option. The remaining boundary: a literal cmd
# or as token OUTSIDE a setenv block ends the option part; everything after
# it is a command argument or target identity, not a doas option. Examples:
#   "permit setenv { as } :wheel cmd /usr/bin/echo nopass" -> valid
#   "permit setenv { as } nopass :wheel" -> a nopass grant, rejected
#   "permit setenv { as } :wheel" -> valid :wheel identity, accepted
doas_has_nopass() {
	awk '{sub(/#.*/, "")} $1 == "permit" {
		in_setenv = 0
		for (i = 2; i <= NF; i++) {
			if (in_setenv) {
				if ($i ~ /\}$/) in_setenv = 0
				continue
			}
			if ($i == "setenv") { in_setenv = 1; continue }
			if ($i == "cmd" || $i == "as") break
			if ($i == "nopass") bad = 1
		}
	} END {exit !bad}' "$1"
}

doas_has_effective_wheel() {
	# ONE permit rule with :wheel as the identity suffices for the whole
	# file; a :wheel that is only a command argument does not count.
	awk '{sub(/#.*/, "")} $1 == "permit" {
		in_setenv = 0
		for (i = 2; i <= NF; i++) {
			if (in_setenv) {
				if ($i ~ /\}$/) in_setenv = 0
				continue
			}
			if ($i == "setenv") { in_setenv = 1; continue }
			if ($i == "cmd" || $i == "as") break
			if ($i == ":wheel") found = 1
		}
	} END {exit !found}' "$1"
}

doas_policy_ok() {
	if doas_has_nopass "$1"; then return 1; fi
	doas_has_effective_wheel "$1"
}

cmd_validate() {
	ensure_etc
	MARK="$ETC/.sane-firstboot-done"
	for f in "$PASSWD" "$GROUP" "$SHADOW" "$DOAS_CONF"; do
		[ -f "$f" ] || audit_fail "missing file: ${f#$ROOT}"
	done
	[ "$FAIL" -eq 0 ] || return 1

	m=$(mode_of "$PASSWD"); [ "$m" = 644 ] || audit_fail "passwd mode $m (expected 644)"
	m=$(mode_of "$GROUP");  [ "$m" = 644 ] || audit_fail "group mode $m (expected 644)"
	m=$(mode_of "$SHADOW"); [ "$m" = 600 ] || audit_fail "shadow mode $m (expected 600)"
	m=$(mode_of "$DOAS_CONF"); [ "$m" = 600 ] || audit_fail "doas.conf mode $m (expected 600)"
	if [ "$SKIP_OWNER" -ne 1 ]; then
		o=$(owner_of "$DOAS_CONF"); [ "$o" = 0:0 ] || \
			audit_fail "doas.conf owner $o (expected 0:0)"
	fi

	awk -F: '$3!~/^[0-9]+$/ || $4!~/^[0-9]+$/ {bad=1} END{exit !bad}' "$PASSWD" && \
		audit_fail "passwd contains non-numeric uid/gid"
	awk -F: -v n=0 '$1!="root" && $3==0 {bad=1} END{exit !bad}' "$PASSWD" && \
		audit_fail "non-root account has uid 0"
	awk -F: '{if (seen[$3]++) {bad=1}} END{exit !bad}' "$PASSWD" && \
		audit_fail "duplicate uid in passwd"
	awk -F: '{if (seen[$3]++) {bad=1}} END{exit !bad}' "$GROUP" && \
		audit_fail "duplicate gid in group"

	# An active hash must be a complete SHA-512 crypt value, not just a "$6$"
	# prefix. A truncated hash passes a prefix-only check and leaves the
	# console locked out while validation still reports success.
	bad=0
	weak_default=0
	while IFS=: read -r _u _p _uid _gid _gecos _home _shell _rest; do
		h=$_p; [ -z "$h" ] && { bad=1; continue; }
		case "$h" in '!'*) h=${h#!} ;; esac
		# K1: the pre-v1.3.0 deterministic hashes used the salts 'root' and
		# 'sane'. Any live hash with those salts is a known weak default
		# credential from an old image; rotate both passwords.
		case "$h" in
			'$6$root$'*|'$6$sane$'*) weak_default=1 ;;
		esac
		case "$h" in
			'*'|'') continue ;;  # deliberately disabled account
			'$6$'*) valid_sha512_hash "$h" || bad=1 ;;
			*) bad=1 ;;           # unsupported active hash algorithm
		esac
	done < "$SHADOW"
	[ "$bad" -eq 0 ] || \
		audit_fail "shadow has an empty field, truncated hash, or unsupported active hash"
	[ "$weak_default" -eq 0 ] || \
		audit_fail "shadow contains a known weak default credential hash (deterministic salt 'root'/'sane' from a pre-v1.3.0 image); rotate both passwords"

	if ! awk -F: -v n=wheel '$1==n {found=1} END{exit !found}' "$GROUP"; then
		audit_fail "wheel group is missing"
	elif ! awk -F: -v n=wheel '$1==n && $4 ~ /(^|,)sane(,|$)/ {found=1} END{exit !found}' "$GROUP"; then
		audit_fail "wheel group does not include 'sane'"
	fi

	# Scan every option token after 'permit', not just the first: options
	# may be reordered (permit persist nopass :wheel). The scan shares the
	# effective-rule boundary below: tokens after the first 'cmd'/'as' are
	# command arguments, not options (see doas_has_nopass).
	if doas_has_nopass "$DOAS_CONF"; then
		audit_fail "doas.conf grants 'nopass' (passwordless escalation)"
	fi
	# Effective-rule token scan: ONE permit rule with :wheel as the
	# identity suffices for the whole file (see doas_has_effective_wheel
	# for the documented cmd/as terminator boundary).
	if ! doas_has_effective_wheel "$DOAS_CONF"; then
		audit_fail "doas.conf has no effective permit rule for :wheel"
	fi
	if [ -e "$ROOT/usr/bin/doas" ]; then
		m=$(mode_of "$ROOT/usr/bin/doas")
		[ "$m" = 4755 ] || audit_fail "doas mode $m (expected 4755 setuid root)"
		if [ "$SKIP_OWNER" -ne 1 ]; then
			o=$(owner_of "$ROOT/usr/bin/doas")
			[ "$o" = 0:0 ] || audit_fail "doas owner $o (expected 0:0)"
		fi
	else
		audit_fail "doas binary is missing"
	fi

	# root and sane are required daily-use accounts. Once firstboot is marked
	# done they must have an active hash; a surviving root hash alone is not
	# enough, otherwise a lost sane hash silently locks the daily account out.
	if [ -f "$MARK" ]; then
		for req in root sane; do
			h=$(field_of "$SHADOW" "$req" 2 || true)
			case "$h" in '!'*) h=${h#!} ;; esac
			valid_sha512_hash "$h" || \
				audit_fail "required account $req has no usable hash after firstboot"
		done
	fi

	if [ "$FAIL" -ne 0 ]; then
		printf '%s: %d validation failure(s)\n' "$PROG" "$FAIL" >&2
		return 1
	fi
	note "account policy validation passed"
}

# Structural audits for recover's targeted checks. They mirror
# cmd_validate's numeric/duplicate/uid-0 audits and additionally flag
# conflicts a merge could otherwise introduce: a non-baseline line
# holding a baseline id (root 0, sane 1000, wheel gid 10) or a duplicated
# baseline name would leave a duplicate id after the baseline is ensured,
# i.e. a state that still fails validation. Recover must never produce one.
passwd_structurally_ok() {
	awk -F: '
		$3 !~ /^[0-9]+$/ || $4 !~ /^[0-9]+$/ { bad = 1 }
		$1 != "root" && $3 == 0 { bad = 1 }
		$1 != "sane" && $3 == 1000 { bad = 1 }
		{ if (seen[$3]++) bad = 1 }
		$1 == "root" { rc++ }
		$1 == "sane" { sc++ }
		END { if (rc > 1 || sc > 1) bad = 1; exit bad }
	' "$1"
}

group_structurally_ok() {
	awk -F: '
		$3 !~ /^[0-9]+$/ { bad = 1 }
		$1 != "root" && $3 == 0 { bad = 1 }
		$1 != "wheel" && $3 == 10 { bad = 1 }
		$1 != "sane" && $3 == 1000 { bad = 1 }
		{ if (seen[$3]++) bad = 1 }
		$1 == "root" { rc++ }
		$1 == "wheel" { wc++ }
		$1 == "sane" { sc++ }
		END { if (rc > 1 || wc > 1 || sc > 1) bad = 1; exit bad }
	' "$1"
}

# Structural audit for recover's shadow check. Mirrors passwd/group structural
# checks and the cmd_validate hash rules: every line must have the complete
# 9-field shape, a unique name that also exists in passwd (with the baseline
# uid for root/sane), numeric age fields, and a complete active SHA-512 hash
# or a lock/disable marker. Passwd has already been merged when this runs, so
# a name that only a corrupt passwd could supply is no longer in the way.
shadow_structurally_ok() {
	awk -F: -v passwd_file="$PASSWD" '
		function shadow_hash_ok(h, a) {
			if (h == "") return 0
			if (h ~ /^!/) sub(/^!/, "", h)
			if (h == "*" || h == "") return 1
			if (h !~ /^\$6\$/) return 0
			sub(/^\$6\$/, "", h)
			if (split(h, a, "\\$") != 2) return 0
			if (a[1] == "" || length(a[1]) > 16 || a[1] ~ /[^.\/A-Za-z0-9]/) return 0
			if (length(a[2]) != 86 || a[2] ~ /[^.\/A-Za-z0-9]/) return 0
			return 1
		}
		FILENAME == passwd_file { puid[$1] = $3; next }
		{
			if (NF != 9) { bad = 1; next }
			if ($1 !~ /^[a-z_][a-z0-9_-]*$/) { bad = 1; next }
			if (seen[$1]++) bad = 1
			if (!shadow_hash_ok($2)) bad = 1
			# An empty field3 disables password aging (shadow(5)).
			if ($3 != "" && $3 !~ /^[0-9]+$/) bad = 1
			for (i = 4; i <= 8; i++)
				if ($i != "" && $i !~ /^[0-9]+$/) bad = 1
			if (!($1 in puid)) bad = 1
			if ($1 == "root" && puid[$1] != "0") bad = 1
			if ($1 == "sane" && puid[$1] != "1000") bad = 1
		}
		END { exit bad }
	' "$PASSWD" "$1"
}

merge_passwd() {
	# Ensure root/sane match the baseline exactly (replace the line when
	# present, append when missing); every other line survives byte-for-byte.
	tmp=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	if ! awk -F: '
		$1 == "root" { print "root:x:0:0:root:/root:/bin/sh"; r = 1; next }
		$1 == "sane" { print "sane:x:1000:1000:S.A.N.E User:/home/sane:/bin/sh"; s = 1; next }
		{ print }
		END {
			if (!r) print "root:x:0:0:root:/root:/bin/sh"
			if (!s) print "sane:x:1000:1000:S.A.N.E User:/home/sane:/bin/sh"
		}' "$PASSWD" > "$tmp"; then
		rm -f "$tmp"
		die "failed to merge $PASSWD"
	fi
	mv "$tmp" "$PASSWD"
}

merge_group() {
	# Ensure root/wheel/sane exist with baseline gids and wheel contains
	# root and sane. Existing memberships and all non-baseline lines are
	# preserved; missing baseline groups are appended.
	tmp=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	if ! awk -F: 'BEGIN { OFS = ":" }
		$1 == "root" { $2 = "x"; $3 = "0"; print; r = 1; next }
		$1 == "sane" { $2 = "x"; $3 = "1000"; print; s = 1; next }
		$1 == "wheel" {
			$2 = "x"; $3 = "10"
			k = split($4, a, ","); out = ""; c = 0; hr = 0; hs = 0
			for (i = 1; i <= k; i++) {
				if (a[i] == "") continue
				if (a[i] == "root") hr = 1
				if (a[i] == "sane") hs = 1
				out = out (c ? "," : "") a[i]; c++
			}
			if (!hr) { out = out (c ? "," : "") "root"; c++ }
			if (!hs) { out = out (c ? "," : "") "sane"; c++ }
			$4 = out
			print; w = 1; next
		}
		{ print }
		END {
			if (!r) print "root:x:0:"
			if (!w) print "wheel:x:10:root,sane"
			if (!s) print "sane:x:1000:"
		}' "$GROUP" > "$tmp"; then
		rm -f "$tmp"
		die "failed to merge $GROUP"
	fi
	mv "$tmp" "$GROUP"
}

rebuild_passwd() {
	# Baseline template + every non-baseline line of the old file that is
	# itself valid and conflict-free: 7 fields, numeric uid/gid, uid >=
	# 1000, uid and name unique against the template and already-restored
	# lines. Conflicting or malformed lines are dropped.
	tmp=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	printf 'root:x:0:0:root:/root:/bin/sh\nsane:x:1000:1000:S.A.N.E User:/home/sane:/bin/sh\n' > "$tmp"
	if [ -f "$PASSWD" ]; then
		if ! awk -F: '
			BEGIN { seen[0] = 1; seen[1000] = 1; names["root"] = 1; names["sane"] = 1 }
			$1 == "root" || $1 == "sane" { next }
			NF != 7 { next }
			$3 !~ /^[0-9]+$/ || $4 !~ /^[0-9]+$/ { next }
			$3 + 0 < 1000 { next }
			seen[$3]++ { next }
			names[$1]++ { next }
			{ print }
		' "$PASSWD" >> "$tmp"; then
			rm -f "$tmp"
			die "failed to rebuild $PASSWD"
		fi
	fi
	mv "$tmp" "$PASSWD"
}

rebuild_group() {
	# Same policy as rebuild_passwd: baseline template + valid,
	# conflict-free non-baseline groups (4 fields, numeric gid >= 1000,
	# unique gid and name).
	tmp=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	printf 'root:x:0:\nwheel:x:10:root,sane\nsane:x:1000:\n' > "$tmp"
	if [ -f "$GROUP" ]; then
		if ! awk -F: '
			BEGIN { seen[0] = 1; seen[10] = 1; seen[1000] = 1
				names["root"] = 1; names["wheel"] = 1; names["sane"] = 1 }
			$1 == "root" || $1 == "wheel" || $1 == "sane" { next }
			NF != 4 { next }
			$3 !~ /^[0-9]+$/ { next }
			$3 + 0 < 1000 { next }
			seen[$3]++ { next }
			names[$1]++ { next }
			{ print }
		' "$GROUP" >> "$tmp"; then
			rm -f "$tmp"
			die "failed to rebuild $GROUP"
		fi
	fi
	mv "$tmp" "$GROUP"
}

merge_shadow() {
	# root/sane get the baseline fields, with the old hash only when it was
	# usable (otherwise the locked marker). Every other line is printed
	# verbatim, so additional accounts keep their hashes byte-for-byte.
	root_hash=$1; sane_hash=$2
	tmp=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	if ! awk -F: -v rh="$root_hash" -v sh="$sane_hash" '
		$1 == "root" {
			print "root:" (rh == "" ? "!" : rh) ":19700:0:99999:7:::"; r = 1; next
		}
		$1 == "sane" {
			print "sane:" (sh == "" ? "!" : sh) ":19700:0:99999:7:::"; s = 1; next
		}
		{ print }
		END {
			if (!r) print "root:" (rh == "" ? "!" : rh) ":19700:0:99999:7:::"
			if (!s) print "sane:" (sh == "" ? "!" : sh) ":19700:0:99999:7:::"
		}
	' "$SHADOW" > "$tmp"; then
		rm -f "$tmp"
		die "failed to merge $SHADOW"
	fi
	mv "$tmp" "$SHADOW"
}

rebuild_shadow() {
	# Baseline locked template + every extra entry that is itself valid and
	# conflict-free: unique name still present in passwd, complete 9 fields,
	# numeric age fields, and a valid active SHA-512 or lock/disable marker.
	root_hash=$1; sane_hash=$2
	tmp=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	printf 'root:!:19700:0:99999:7:::\nsane:!:19700:0:99999:7:::\n' > "$tmp"
	if [ -f "$SHADOW" ]; then
		if ! awk -F: -v passwd_file="$PASSWD" '
			function shadow_hash_ok(h, a) {
				if (h == "") return 0
				if (h ~ /^!/) sub(/^!/, "", h)
				if (h == "*" || h == "") return 1
				if (h !~ /^\$6\$/) return 0
				sub(/^\$6\$/, "", h)
				if (split(h, a, "\\$") != 2) return 0
				if (a[1] == "" || length(a[1]) > 16 || a[1] ~ /[^.\/A-Za-z0-9]/) return 0
				if (length(a[2]) != 86 || a[2] ~ /[^.\/A-Za-z0-9]/) return 0
				return 1
			}
			FILENAME == passwd_file { pname[$1] = 1; next }
			$1 == "root" || $1 == "sane" { next }
			NF != 9 { next }
			$1 !~ /^[a-z_][a-z0-9_-]*$/ { next }
			!shadow_hash_ok($2) { next }
			# Empty field3 is valid: password aging is disabled.
			$3 != "" && $3 !~ /^[0-9]+$/ { next }
			{
				ok = 1
				for (i = 4; i <= 8; i++)
					if ($i != "" && $i !~ /^[0-9]+$/) ok = 0
				if (!ok) next
			}
			!($1 in pname) { next }
			seen[$1]++ { next }
			{ print }
		' "$PASSWD" "$SHADOW" >> "$tmp"; then
			rm -f "$tmp"
			die "failed to rebuild $SHADOW"
		fi
	fi
	mv "$tmp" "$SHADOW"
	if [ -n "$root_hash" ] && [ "$root_hash" != "!" ]; then
		set_field "$SHADOW" root 2 "$root_hash"
	fi
	if [ -n "$sane_hash" ] && [ "$sane_hash" != "!" ]; then
		set_field "$SHADOW" sane 2 "$sane_hash"
	fi
}

# Inspect field 2 of an account in shadow and separate lock state ('!') from
# hash validity so recovery never strips an administrator lock prefix.
inspect_shadow_recovery() {
	raw=$(field_of "$1" "$2" 2 || true)
	case "$raw" in
		'!'*) is_locked=1; bare=${raw#!} ;;
		*)    is_locked=0; bare=$raw ;;
	esac
	if valid_sha512_hash "$bare"; then
		hash_valid=1
		clean_hash=$bare
	else
		hash_valid=0
		clean_hash=
	fi
}

# Format field 2 for merge_shadow/rebuild_shadow from separate validity & lock state.
compose_shadow_field() {
	valid=$1; locked=$2; hash=$3
	if [ "$valid" -eq 1 ]; then
		if [ "$locked" -eq 1 ]; then
			printf '!%s\n' "$hash"
		else
			printf '%s\n' "$hash"
		fi
	else
		printf '!\n'
	fi
}

cmd_recover() {
	# Merge, not rewrite (X6): repair each identity file individually and
	# preserve everything still valid. A structurally sound passwd/group is
	# merged (baseline ensured, extra lines and memberships kept); only a
	# structurally corrupt one is rebuilt from the template with valid,
	# conflict-free extra lines restored. A policy-compliant doas.conf is
	# preserved and only its mode/owner is repaired. A structurally sound shadow
	# is merged (root/sane repaired only when their old hash is usable, with
	# intentional lock markers preserved; every extra entry kept byte-for-byte);
	# a corrupt one is rebuilt from the locked baseline with valid, conflict-free
	# extra entries appended again. If no valid root/sane hash survives, remove
	# the firstboot marker so the console setup runs again on this boot.
	ensure_etc
	recover_root_valid=0
	recover_root_locked=0
	recover_root_hash=
	recover_sane_valid=0
	recover_sane_locked=0
	recover_sane_hash=
	if [ -f "$SHADOW" ]; then
		inspect_shadow_recovery "$SHADOW" root
		recover_root_valid=$hash_valid
		recover_root_locked=$is_locked
		recover_root_hash=$clean_hash

		inspect_shadow_recovery "$SHADOW" sane
		recover_sane_valid=$hash_valid
		recover_sane_locked=$is_locked
		recover_sane_hash=$clean_hash
	fi
	recover_root_field=$(compose_shadow_field "$recover_root_valid" "$recover_root_locked" "$recover_root_hash")
	recover_sane_field=$(compose_shadow_field "$recover_sane_valid" "$recover_sane_locked" "$recover_sane_hash")

	# doas.conf: keep policy-compliant content, repair mode/owner only.
	if [ -f "$DOAS_CONF" ] && doas_policy_ok "$DOAS_CONF"; then
		chmod 0600 "$DOAS_CONF"
		[ "$(id -u)" = 0 ] && chown 0:0 "$DOAS_CONF" 2>/dev/null || true
		printf 'recover: doas.conf preserved (policy ok; mode/owner repaired)\n'
	else
		printf 'permit persist :wheel\n' > "$DOAS_CONF"
		chmod 0600 "$DOAS_CONF"
		[ "$(id -u)" = 0 ] && chown 0:0 "$DOAS_CONF" 2>/dev/null || true
		printf 'recover: doas.conf rebuilt from baseline (missing or policy violation)\n'
	fi

	if [ -f "$PASSWD" ] && passwd_structurally_ok "$PASSWD"; then
		merge_passwd
		printf 'recover: passwd merged (root/sane ensured; extra entries preserved)\n'
	else
		rebuild_passwd
		printf 'recover: passwd rebuilt from baseline (structural corruption; valid extra entries restored)\n'
	fi

	if [ -f "$GROUP" ] && group_structurally_ok "$GROUP"; then
		merge_group
		printf 'recover: group merged (root/wheel/sane ensured; extra entries preserved)\n'
	else
		rebuild_group
		printf 'recover: group rebuilt from baseline (structural corruption; valid extra entries restored)\n'
	fi

	# shadow: merge when structurally sound (extra hashes preserved
	# byte-for-byte); otherwise rebuild the locked baseline and append back
	# only valid, conflict-free extra entries. Usable root/sane hashes (and
	# any existing '!' lock prefix) are restored in both paths.
	if [ -f "$SHADOW" ] && shadow_structurally_ok "$SHADOW"; then
		merge_shadow "$recover_root_field" "$recover_sane_field"
		printf 'recover: shadow merged (root/sane repaired when usable; extra entries preserved)\n'
	else
		rebuild_shadow "$recover_root_field" "$recover_sane_field"
		printf 'recover: shadow rebuilt from baseline (structural corruption; valid extra entries restored)\n'
	fi

	chmod 0644 "$PASSWD" "$GROUP"
	chmod 0600 "$SHADOW" "$DOAS_CONF"
	mkdir -p "$HOME_BASE/sane"
	chmod 0750 "$HOME_BASE/sane"

	MARK="$ETC/.sane-firstboot-done"
	if [ "$recover_root_valid" -ne 1 ] || [ "$recover_sane_valid" -ne 1 ]; then
		rm -f "$MARK"
		printf 'recover: no usable root/sane hash; first boot will ask for passwords again\n'
	else
		printf 'done\n' > "$MARK"
		chmod 0600 "$MARK"
		printf 'recover: preserved usable password hashes\n'
	fi
	note "identity recovery complete under $ETC"
}

case "$CMD" in
	init)          cmd_init "$@" ;;
	add-user)      cmd_add_user "$@" ;;
	del-user)      cmd_del_user "$@" ;;
	set-password)  cmd_set_password "$@" ;;
	lock)          cmd_lock "$@" ;;
	unlock)        cmd_unlock "$@" ;;
	list)          cmd_list "$@" ;;
	validate)      cmd_validate "$@" ;;
	recover)       cmd_recover "$@" ;;
	*) usage >&2; die "unknown command: $CMD" ;;
esac
