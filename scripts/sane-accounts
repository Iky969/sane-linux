#!/bin/sh
# sane-accounts -- S.A.N.E account lifecycle and policy validation.
#
# Build-time / host-side tool that operates on a target rootfs (--root DIR).
# It never touches the host's /etc unless --root / is passed explicitly.
# POSIX sh, fail-closed: invalid input exits non-zero without partial edits.
#
# Subcommands:
#   init [--force] [--firstboot|--allow-weak-defaults]
#                                write baseline passwd/group/shadow/doas.conf
#   add-user NAME [UID] [GROUP]  create account, group and home (locked by default)
#   del-user NAME [--remove-home] remove account, group membership and home
#   set-password NAME            read password from stdin, write SHA-512 hash
#   lock NAME | unlock NAME      prefix/remove the shadow lock marker
#   list                         list accounts
#   validate                     audit files, hashes and doas policy
#   recover                      repair identity files without lockout (merge)
#
set -eu

PROG=${0##*/}
ROOT=/
VERBOSE=0
FORCE=0
SKIP_CHOWN=0
FIRSTBOOT=0
SKIP_OWNER=0
ALLOW_WEAK_DEFAULTS=0
# NOTE (K1): no default password hash is shipped in this repo any more.
# The pre-v1.3.0 deterministic root/root and sane/sane hashes were removed;
# they remain in git history, so treat any v1.2.0 image as using publicly
# known credentials and do not distribute it.

usage() {
	cat <<EOF
Usage: $PROG [--root DIR] [--force] [--skip-chown] [--firstboot|--allow-weak-defaults] <command> [args]

Commands:
  init [--force] [--firstboot|--allow-weak-defaults]
                              write baseline identity files (refuse overwrite)
  add-user NAME [UID] [GROUP]   create a locked account + home
  del-user NAME [--remove-home] remove an account
  set-password NAME             read password from stdin (one line)
  lock NAME                     lock an account (prefix '!' in shadow)
  unlock NAME                   unlock an account
  list                          list accounts
  validate                      audit account files and doas policy
  recover                       repair broken identity files (merge); re-run firstboot if needed
EOF
}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
note() { [ "$VERBOSE" -eq 1 ] && printf 'ok: %s\n' "$*"; return 0; }

TMP_1='' TMP_2='' TMP_3='' TMP_4=''
cleanup_temps() {
	rm -f -- ${TMP_1:+"$TMP_1"} ${TMP_2:+"$TMP_2"} ${TMP_3:+"$TMP_3"} ${TMP_4:+"$TMP_4"} 2>/dev/null || true
}
trap cleanup_temps EXIT HUP INT TERM

atomic_mv_replace() {
	amr_src=$1; amr_dst=$2
	if mv -fT -- "$amr_src" "$amr_dst" 2>/dev/null; then
		return 0
	fi
	if [ -L "$amr_dst" ]; then
		rm -f -- "$amr_dst" && mv -fT -- "$amr_src" "$amr_dst"
		return $?
	fi
	mv -fT -- "$amr_src" "$amr_dst"
}

normalize_path() {
	np_in=$1
	case "$np_in" in /*) ;; *) return 1 ;; esac
	np_out=
	np_rest=${np_in#/}
	while [ -n "$np_rest" ]; do
		case "$np_rest" in
			*/*) np_comp=${np_rest%%/*}; np_rest=${np_rest#*/} ;;
			*) np_comp=$np_rest; np_rest= ;;
		esac
		case "$np_comp" in
			''|.) continue ;;
			..) np_out=${np_out%/*} ;;
			*) np_out="$np_out/$np_comp" ;;
		esac
	done
	printf '%s\n' "${np_out:-/}"
}

canonicalize_root() {
	cr_path=$ROOT
	while [ "${cr_path%/}" != "$cr_path" ]; do cr_path=${cr_path%/}; done
	[ -n "$cr_path" ] || cr_path=/
	cr_tail=
	while [ ! -d "$cr_path" ]; do
		cr_tail="/${cr_path##*/}$cr_tail"
		cr_path=${cr_path%/*}
		[ -n "$cr_path" ] || cr_path=/
	done
	cr_base=$(cd -P "$cr_path" && pwd) || die "cannot resolve --root: $ROOT"
	cr_rest=${cr_tail#/}
	cr_hops=0
	while [ -n "$cr_rest" ]; do
		case "$cr_rest" in
			*/*) cr_comp=${cr_rest%%/*}; cr_rest=${cr_rest#*/} ;;
			*) cr_comp=$cr_rest; cr_rest= ;;
		esac
		case "$cr_comp" in
			''|.) continue ;;
			..) cr_base=${cr_base%/*}; [ -n "$cr_base" ] || cr_base=/; continue ;;
		esac
		if [ -L "$cr_base/$cr_comp" ]; then
			cr_hops=$((cr_hops + 1))
			[ "$cr_hops" -le 40 ] || die "too many symlink hops in --root: $ROOT"
			cr_target=$(readlink "$cr_base/$cr_comp" 2>/dev/null) || \
				die "cannot read root symlink: $cr_base/$cr_comp"
			[ -n "$cr_target" ] || die "empty root symlink target: $cr_base/$cr_comp"
			case "$cr_target" in
				/*) cr_base=/; cr_rest="${cr_target#/}/$cr_rest" ;;
				*) cr_rest="$cr_target/$cr_rest" ;;
			esac
			continue
		fi
		if [ "$cr_base" = "/" ]; then
			cr_base="/$cr_comp"
		else
			cr_base="$cr_base/$cr_comp"
		fi
	done
	ROOT=$(normalize_path "$cr_base") || die "cannot normalize --root: $ROOT"
}

resolve_abs_no_contain() {
	rac_base=/
	rac_rest=${1#/}
	rac_hops=0
	while [ -n "$rac_rest" ]; do
		case "$rac_rest" in
			*/*) rac_comp=${rac_rest%%/*}; rac_rest=${rac_rest#*/} ;;
			*) rac_comp=$rac_rest; rac_rest= ;;
		esac
		case "$rac_comp" in
			''|.) continue ;;
		esac
		rac_cand=$(normalize_path "$rac_base/$rac_comp") || return 1
		if [ -L "$rac_cand" ]; then
			rac_hops=$((rac_hops + 1))
			[ "$rac_hops" -le 40 ] || return 1
			rac_target=$(readlink "$rac_cand" 2>/dev/null) || return 1
			[ -n "$rac_target" ] || return 1
			case "$rac_target" in
				/*) rac_base=/; rac_rest="${rac_target#/}/$rac_rest" ;;
				*)  rac_base=$(dirname "$rac_cand")
				    rac_rest="$rac_target/$rac_rest" ;;
			esac
			continue
		fi
		rac_base=$rac_cand
	done
	printf '%s\n' "$rac_base"
}

symlink_resolve_contained() {
	src_root=$(normalize_path "$ROOT") || return 1
	src_base=$src_root
	src_rest=$1
	src_hops=0
	while [ -n "$src_rest" ]; do
		case "$src_rest" in
			*/*) src_comp=${src_rest%%/*}; src_rest=${src_rest#*/} ;;
			*) src_comp=$src_rest; src_rest= ;;
		esac
		case "$src_comp" in
			''|.) continue ;;
		esac
		src_cand=$(normalize_path "$src_base/$src_comp") || return 1
		if [ "$src_root" != "/" ]; then
			case "$src_cand/" in
				"$src_root/"*) ;;
				*) return 1 ;;
			esac
		fi
		if [ -L "$src_cand" ]; then
			src_hops=$((src_hops + 1))
			[ "$src_hops" -le 40 ] || return 1
			src_target=$(readlink "$src_cand" 2>/dev/null) || return 1
			[ -n "$src_target" ] || return 1
			case "$src_target" in
				/*)
					src_abs=$(resolve_abs_no_contain "$src_target") || return 1
					if [ "$src_root" != "/" ]; then
						case "$src_abs/" in
							"$src_root/"*) ;;
							*) return 1 ;;
						esac
					fi
					src_base=$src_abs
					;;
				*)  src_base=$(dirname "$src_cand")
				    src_rest="$src_target/$src_rest" ;;
			esac
			continue
		fi
		src_base=$src_cand
	done
	return 0
}

require_contained_rel() {
	symlink_resolve_contained "$1" || die "path escapes root: $1"
}

reject_symlink() {
	[ ! -L "$1" ] || die "refusing symlink path: $1"
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		--root)
			[ "$#" -ge 2 ] || die "--root needs a directory"
			ROOT=$2; shift 2 ;;
		-v|--verbose) VERBOSE=1; shift ;;
		--force) FORCE=1; shift ;;
		--skip-chown) SKIP_CHOWN=1; shift ;;
		--firstboot) FIRSTBOOT=1; shift ;;
		--allow-weak-defaults) ALLOW_WEAK_DEFAULTS=1; shift ;;
		--skip-owner-check) SKIP_OWNER=1; shift ;;
		-h|--help) usage; exit 0 ;;
		--) shift; break ;;
		-*) die "unknown option: $1" ;;
		*) break ;;
	esac
done

[ "$#" -ge 1 ] || { usage >&2; exit 1; }
CMD=$1; shift

case "$ROOT" in
	/*) ;;
	*) die "--root must be an absolute path" ;;
esac
canonicalize_root

if [ "$ROOT" = "/" ]; then
	ETC=/etc
	HOME_BASE=/home
else
	ETC="$ROOT/etc"
	HOME_BASE="$ROOT/home"
fi
PASSWD="$ETC/passwd"
GROUP="$ETC/group"
SHADOW="$ETC/shadow"
DOAS_CONF="$ETC/doas.conf"

mode_of() {
	stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null || printf '?'
}

owner_of() {
	stat -c '%u:%g' "$1" 2>/dev/null || stat -f '%u:%g' "$1" 2>/dev/null || printf '?:?'
}

# A SHA-512 crypt hash is $6$<salt>$<checksum>: salt 1-16 chars, checksum
# exactly 86 chars, both from [./A-Za-z0-9]. Reject truncated hashes as well
# as the pre-v1.3.0 deterministic weak-default salts 'root' and 'sane'.
valid_sha512_hash() {
	case "$1" in
		'$6$root$'*|'$6$sane$'*) return 1 ;;
		'$6$'*) ;;
		*) return 1 ;;
	esac
	awk -v h="${1#\$6\$}" 'BEGIN {
		n = split(h, part, "\\$")
		if (n != 2) exit 1
		salt = part[1]; sum = part[2]
		if (salt == "" || length(salt) > 16 || salt ~ /[^.\/A-Za-z0-9]/) exit 1
		if (length(sum) != 86 || sum ~ /[^.\/A-Za-z0-9]/) exit 1
		exit 0
	}'
}

ensure_etc() {
	require_contained_rel "etc"
	[ -d "$ETC" ] || die "target root has no /etc: $ETC"
}

write_atomic_text() {
	# write_atomic_text DEST MODE TEXT
	wat_dest=$1; wat_mode=$2; wat_text=$3
	wat_dir=$(dirname "$wat_dest")
	TMP_1=$(mktemp "$wat_dir/.sane-accounts.XXXXXX") || die "cannot create temp file in $wat_dir"
	if ! chmod "$wat_mode" "$TMP_1" || ! printf '%s' "$wat_text" > "$TMP_1" || ! mv -fT -- "$TMP_1" "$wat_dest"; then
		rm -f -- "$TMP_1"; TMP_1=''
		die "failed to write $wat_dest"
	fi
	TMP_1=''
}

ensure_base() {
	ensure_etc
	require_contained_rel "etc/passwd"
	require_contained_rel "etc/group"
	require_contained_rel "etc/shadow"
	reject_symlink "$PASSWD"
	reject_symlink "$GROUP"
	reject_symlink "$SHADOW"
	[ -f "$PASSWD" ] || write_atomic_text "$PASSWD" 0644 'root:x:0:0:root:/root:/bin/sh
'
	[ -f "$GROUP" ]  || write_atomic_text "$GROUP"  0644 'root:x:0:
'
	[ -f "$SHADOW" ] || write_atomic_text "$SHADOW" 0600 'root:!:19700:0:99999:7:::
'
}

# Password policy (S3): at least 12 characters, and never the account name
# itself (case-insensitive). Enforced by set-password, by the
# --allow-weak-defaults init path, and (mirrored) by sane-firstboot.
check_password_policy() {
	name=$1; password=$2
	[ "$(printf '%s' "$password" | wc -m)" -ge 12 ] || die "password for '$name' is too short (minimum 12 characters)"
	lower_name=$(printf '%s' "$name" | tr 'A-Z' 'a-z')
	lower_pw=$(printf '%s' "$password" | tr 'A-Z' 'a-z')
	[ "$lower_pw" != "$lower_name" ] || die "password for '$name' must not be the account name"
}

valid_name() {
	case "$1" in
		''|*[!a-z0-9_-]*) return 1 ;;
	esac
	case "$1" in
		[a-z_]* ) return 0 ;;
		*) return 1 ;;
	esac
}

user_exists() { awk -F: -v n="$1" '$1==n {found=1} END{exit !found}' "$PASSWD"; }
group_exists() { awk -F: -v n="$1" '$1==n {found=1} END{exit !found}' "$GROUP"; }

field_of() {
	# field_of FILE NAME FIELD
	awk -F: -v n="$2" -v f="$3" '$1==n {print $f; exit}' "$1"
}

set_field() {
	# set_field FILE NAME FIELD VALUE MODE -- atomic rewrite via unpredictable temp
	file=$1; name=$2; field=$3; value=$4; mode=${5:-0600}
	reject_symlink "$file"
	dir=$(dirname "$file")
	TMP_1=$(mktemp "$dir/.sane-accounts.XXXXXX") || die "cannot create temp file in $dir"
	if ! chmod "$mode" "$TMP_1" || ! awk -v n="$name" -v f="$field" -v v="$value" \
		'BEGIN{FS=OFS=":"} $1==n {$f=v} {print}' "$file" > "$TMP_1" || ! mv -fT -- "$TMP_1" "$file"; then
		rm -f -- "$TMP_1"; TMP_1=''
		die "failed to rewrite $file"
	fi
	TMP_1=''
}

next_id() {
	# next_id FILE -- smallest free id in 1000..65534. First-free scan,
	# not max+1: a high-uid import (e.g. nobody 65534) must not exhaust
	# the range, and gaps below the maximum are reused. Prints nothing
	# when the whole range is in use; callers report a clean error.
	awk -F: '{used[$3+0]=1} END{
		for (i = 1000; i <= 65534; i++)
			if (!(i in used)) { print i; exit }
	}' "$1"
}

cmd_init() {
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--force) FORCE=1 ;;
			--firstboot) FIRSTBOOT=1 ;;
			--allow-weak-defaults) ALLOW_WEAK_DEFAULTS=1 ;;
			-*) die "unknown init option: $1" ;;
			*) die "unexpected argument to init: $1" ;;
		esac
		shift
	done
	# Fail closed BEFORE writing anything (K1): without --firstboot there is
	# no password to write any more, and without --allow-weak-defaults plus
	# runtime passwords there is nothing safe to fall back to. Validate the
	# runtime passwords here too, so a missing/weak one also fails before
	# any passwd/group file is touched.
	if [ "$FIRSTBOOT" -ne 1 ] && [ "$ALLOW_WEAK_DEFAULTS" -ne 1 ]; then
		die "refusing to write password accounts without --firstboot; use --firstboot (locked accounts), or set passwords explicitly with set-password"
	fi
	if [ "$ALLOW_WEAK_DEFAULTS" -eq 1 ] && [ "$FIRSTBOOT" -ne 1 ]; then
		[ -n "${SANE_TEST_ROOT_PASSWORD:-}" ] || die "--allow-weak-defaults requires SANE_TEST_ROOT_PASSWORD in the environment"
		[ -n "${SANE_TEST_SANE_PASSWORD:-}" ] || die "--allow-weak-defaults requires SANE_TEST_SANE_PASSWORD in the environment"
		check_password_policy root "$SANE_TEST_ROOT_PASSWORD"
		check_password_policy sane "$SANE_TEST_SANE_PASSWORD"
	fi
	ensure_etc
	require_contained_rel "etc/passwd"
	require_contained_rel "etc/group"
	require_contained_rel "etc/shadow"
	require_contained_rel "etc/doas.conf"
	require_contained_rel "home"
	require_contained_rel "home/sane"
	reject_symlink "$HOME_BASE/sane"
	if [ -e "$HOME_BASE/sane" ] && [ ! -d "$HOME_BASE/sane" ]; then
		die "home path exists but is not a directory: $HOME_BASE/sane"
	fi
	if [ "$FORCE" -ne 1 ]; then
		for f in "$PASSWD" "$GROUP" "$SHADOW" "$DOAS_CONF"; do
			if [ -e "$f" ] || [ -L "$f" ]; then
				die "refusing to overwrite existing ${f#$ROOT}; use --force"
			fi
		done
	fi
	if [ "$FIRSTBOOT" -eq 1 ]; then
		# No public password: accounts stay locked until sane-firstboot sets them.
		shadow_content='root:!:19700:0:99999:7:::
sane:!:19700:0:99999:7:::
'
	elif [ "$ALLOW_WEAK_DEFAULTS" -eq 1 ]; then
		# Test-only path (K1): there is no deterministic hash any more.
		# Passwords must be supplied at runtime via the environment
		# (never committed); without them init refuses to write accounts.
		root_pw=${SANE_TEST_ROOT_PASSWORD:-}
		sane_pw=${SANE_TEST_SANE_PASSWORD:-}
		[ -n "$root_pw" ] || die "--allow-weak-defaults requires SANE_TEST_ROOT_PASSWORD in the environment"
		[ -n "$sane_pw" ] || die "--allow-weak-defaults requires SANE_TEST_SANE_PASSWORD in the environment"
		check_password_policy root "$root_pw"
		check_password_policy sane "$sane_pw"
		command -v openssl >/dev/null 2>&1 || die "openssl is required to hash passwords"
		root_hash=$(printf '%s' "$root_pw" | openssl passwd -6 -salt "$(openssl rand -hex 8)" -stdin) || die "failed to hash root password"
		sane_hash=$(printf '%s' "$sane_pw" | openssl passwd -6 -salt "$(openssl rand -hex 8)" -stdin) || die "failed to hash sane password"
		shadow_content=$(printf 'root:%s:19700:0:99999:7:::\nsane:%s:19700:0:99999:7:::\n' "$root_hash" "$sane_hash")
	else
		die "refusing to write password accounts without --firstboot; use --firstboot (locked accounts), or set passwords explicitly with set-password"
	fi
	mkdir -p "$HOME_BASE/sane"
	chmod 0750 "$HOME_BASE/sane"
	TMP_1=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	TMP_2=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	TMP_3=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	TMP_4=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	chmod 0644 "$TMP_1" "$TMP_2" || die "cannot set staged identity file modes"
	chmod 0600 "$TMP_3" "$TMP_4" || die "cannot set staged secret file modes"
	[ "$(id -u)" = 0 ] && chown 0:0 "$TMP_4" 2>/dev/null || true
	printf 'root:x:0:0:root:/root:/bin/sh\nsane:x:1000:1000:S.A.N.E User:/home/sane:/bin/sh\n' > "$TMP_1"
	printf 'root:x:0:\nwheel:x:10:root,sane\nsane:x:1000:\n' > "$TMP_2"
	printf '%s' "$shadow_content" > "$TMP_3"
	printf 'permit persist :wheel\n' > "$TMP_4"
	atomic_mv_replace "$TMP_1" "$PASSWD"; TMP_1=''
	atomic_mv_replace "$TMP_2" "$GROUP"; TMP_2=''
	atomic_mv_replace "$TMP_3" "$SHADOW"; TMP_3=''
	atomic_mv_replace "$TMP_4" "$DOAS_CONF"; TMP_4=''
	note "baseline identity files written to $ETC"
}

cmd_add_user() {
	[ "$#" -ge 1 ] || die "add-user needs a name"
	name=$1; shift
	uid=; group=
	skip_chown=$SKIP_CHOWN
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--skip-chown) skip_chown=1 ;;
			*)
				if [ -z "$uid" ]; then
					uid=$1
				elif [ -z "$group" ]; then
					group=$1
				else
					die "too many arguments to add-user"
				fi
				;;
		esac
		shift
	done
	[ -n "$group" ] || group=$name
	valid_name "$name" || die "invalid account name: $name"
	[ "$name" = "root" ] && die "refusing to add the reserved 'root' account"
	ensure_base
	user_exists "$name" && die "account already exists: $name"

	if [ -z "$uid" ]; then
		uid=$(next_id "$PASSWD")
		[ -n "$uid" ] || die "no free uid in range 1000..65534"
	fi
	case "$uid" in
		''|*[!0-9]*) die "uid must be numeric: $uid" ;;
	esac
	[ "$uid" -ge 1000 ] && [ "$uid" -le 65534 ] || die "uid out of range: $uid"
	if awk -F: -v u="$uid" '$3==u {found=1} END{exit !found}' "$PASSWD"; then
		die "uid already in use: $uid"
	fi

	created_group=0
	if group_exists "$group"; then
		gid=$(field_of "$GROUP" "$group" 3)
	else
		valid_name "$group" || die "invalid group name: $group"
		# A default private group shares the account's UID.
		if [ "$group" = "$name" ] && [ -n "$uid" ]; then
			gid=$uid
		else
			gid=$(next_id "$GROUP")
			[ -n "$gid" ] || die "no free gid in range 1000..65534"
		fi
		if awk -F: -v g="$gid" '$3==g {found=1} END{exit !found}' "$GROUP"; then
			die "gid already in use: $gid"
		fi
		created_group=1
	fi
	case "$gid" in
		''|*[!0-9]*) die "gid must be numeric: $gid" ;;
	esac

	# Create the home FIRST: if that fails, no identity entry is left behind.
	require_contained_rel "home"
	require_contained_rel "home/$name"
	home="$HOME_BASE/$name"
	reject_symlink "$HOME_BASE"
	reject_symlink "$home"
	if [ -e "$home" ] && [ ! -d "$home" ]; then
		die "home path exists but is not a directory: $home"
	fi
	mkdir -p "$home" || die "cannot create home directory: $home"
	chmod 0750 "$home" || { rmdir "$home" 2>/dev/null || true; die "cannot set home mode: $home"; }
	if [ "$skip_chown" -eq 1 ]; then
		note "WARNING: ownership of $home not set (--skip-chown)"
	else
		if ! chown "$uid:$gid" "$home"; then
			rmdir "$home" 2>/dev/null || true
			die "cannot set ownership of $home to $uid:$gid; use --skip-chown only for non-privileged test builds"
		fi
	fi

	rollback_add() {
		# Undo every partial edit so a failed add cannot leave a ghost account.
		for rb_spec in "$PASSWD:0644" "$SHADOW:0600"; do
			rb_file=${rb_spec%:*}
			rb_mode=${rb_spec##*:}
			rb_tmp=$(mktemp "$(dirname "$rb_file")/.sane-accounts.XXXXXX") || continue
			if chmod "$rb_mode" "$rb_tmp" && \
				awk -v n="$name" 'BEGIN{FS=OFS=":"} $1!=n {print}' "$rb_file" > "$rb_tmp"; then
				mv -fT -- "$rb_tmp" "$rb_file" || rm -f -- "$rb_tmp"
			else
				rm -f -- "$rb_tmp"
			fi
		done
		rb_gtmp=$(mktemp "$(dirname "$GROUP")/.sane-accounts.XXXXXX") || { rmdir "$home" 2>/dev/null || true; return 0; }
		if chmod 0644 "$rb_gtmp"; then
			if [ "$created_group" -eq 1 ]; then
				awk -v n="$group" 'BEGIN{FS=OFS=":"} $1!=n {print}' "$GROUP" > "$rb_gtmp"
			else
				awk -v n="$name" 'BEGIN{FS=OFS=":"} {
					if ($4!="") {
						out=""; c=0; k=split($4,a,",")
						for (i=1;i<=k;i++) if (a[i]!="" && a[i]!=n) {
							out=out (c?",":"") a[i]; c++
						}
						$4=out
					}
					print
				}' "$GROUP" > "$rb_gtmp"
			fi
			mv -fT -- "$rb_gtmp" "$GROUP" || rm -f -- "$rb_gtmp"
		else
			rm -f -- "$rb_gtmp"
		fi
		rmdir "$home" 2>/dev/null || true
	}

	TMP_1=$(mktemp "$ETC/.sane-accounts.XXXXXX") || { rmdir "$home" 2>/dev/null || true; die "cannot create temp file"; }
	if ! chmod 0644 "$TMP_1"; then
		rm -f -- "$TMP_1"; TMP_1=''; rmdir "$home" 2>/dev/null || true
		die "cannot set group temp mode"
	fi
	if [ "$created_group" -eq 1 ]; then
		if ! { cat "$GROUP" && printf '%s:x:%s:\n' "$group" "$gid"; } > "$TMP_1" || ! mv -fT -- "$TMP_1" "$GROUP"; then
			rm -f -- "$TMP_1"; TMP_1=''; rmdir "$home" 2>/dev/null || true
			die "failed to write group entry"
		fi
	else
		if ! awk -v n="$name" -v g="$group" 'BEGIN{FS=OFS=":"} $1==g {
			k=split($4,a,","); found=0
			for (i=1;i<=k;i++) if (a[i]==n) found=1
			if (!found) $4 = ($4=="" ? n : $4 "," n)
		} {print}' "$GROUP" > "$TMP_1" || ! mv -fT -- "$TMP_1" "$GROUP"; then
			rm -f -- "$TMP_1"; TMP_1=''; rmdir "$home" 2>/dev/null || true
			die "failed to update group membership"
		fi
	fi
	TMP_1=''

	TMP_1=$(mktemp "$ETC/.sane-accounts.XXXXXX") || { rollback_add; die "cannot create temp file"; }
	if ! chmod 0644 "$TMP_1" || ! { cat "$PASSWD" && printf '%s:x:%s:%s:%s:/home/%s:/bin/sh\n' \
		"$name" "$uid" "$gid" "$name" "$name"; } > "$TMP_1" || ! mv -fT -- "$TMP_1" "$PASSWD"; then
		rm -f -- "$TMP_1"; TMP_1=''
		rollback_add; die "failed to write passwd entry"
	fi
	TMP_1=''

	TMP_1=$(mktemp "$ETC/.sane-accounts.XXXXXX") || { rollback_add; die "cannot create temp file"; }
	if ! chmod 0600 "$TMP_1" || ! { cat "$SHADOW" && printf '%s:!:19700:0:99999:7:::\n' "$name"; } > "$TMP_1" || ! mv -fT -- "$TMP_1" "$SHADOW"; then
		rm -f -- "$TMP_1"; TMP_1=''
		rollback_add; die "failed to write shadow entry"
	fi
	TMP_1=''
	note "created $name (uid=$uid gid=$gid, locked, home=/home/$name)"
}

cmd_del_user() {
	[ "$#" -ge 1 ] || die "del-user needs a name"
	name=$1; remove_home=0
	if [ "$#" -eq 2 ] && [ "$2" = "--remove-home" ]; then
		remove_home=1
	elif [ "$#" -gt 1 ]; then
		die "usage: del-user NAME [--remove-home]"
	fi
	valid_name "$name" || die "invalid account name: $name"
	[ "$name" = "root" ] && die "refusing to delete the reserved 'root' account"
	ensure_base
	if [ "$remove_home" -eq 1 ]; then
		case "$name" in
			''|*/*|.|..) die "unsafe home name: $name" ;;
		esac
		require_contained_rel "home"
		require_contained_rel "home/$name"
		reject_symlink "$HOME_BASE/$name"
	fi
	user_exists "$name" || die "no such account: $name"

	# Never delete a private group that another account still relies on.
	keep_group=0
	if group_exists "$name"; then
		ggid=$(field_of "$GROUP" "$name" 3)
		if awk -F: -v g="$ggid" -v n="$name" \
			'$1!=n && $4==g {found=1} END{exit !found}' "$PASSWD"; then
			keep_group=1
		elif awk -F: -v n="$name" '$1==n {
			k=split($4,a,","); for(i=1;i<=k;i++) if(a[i]!="" && a[i]!=n) found=1
		} END{exit !found}' "$GROUP"; then
			keep_group=1
		fi
		if [ "$keep_group" -eq 1 ]; then
			note "keeping group '$name' (gid=$ggid): still in use by another account"
		fi
	fi

	TMP_1=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file"
	TMP_2=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file"
	TMP_3=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file"
	chmod 0644 "$TMP_1" "$TMP_3" || die "cannot set temp modes"
	chmod 0600 "$TMP_2" || die "cannot set temp mode"
	awk -v n="$name" 'BEGIN{FS=OFS=":"} $1!=n {print}' "$PASSWD" > "$TMP_1" || die "failed to update passwd"
	awk -v n="$name" 'BEGIN{FS=OFS=":"} $1!=n {print}' "$SHADOW" > "$TMP_2" || die "failed to update shadow"
	awk -v n="$name" -v keep="$keep_group" 'BEGIN{FS=OFS=":"} {
		if ($1==n && keep!="1") next
		if ($4!="") {
			out=""; c=0; k=split($4,a,",")
			for (i=1;i<=k;i++) if (a[i]!="" && a[i]!=n) {
				out=out (c?",":"") a[i]; c++
			}
			$4=out
		}
		print
	}' "$GROUP" > "$TMP_3" || die "failed to update group"
	mv -fT -- "$TMP_1" "$PASSWD"; TMP_1=''
	mv -fT -- "$TMP_2" "$SHADOW"; TMP_2=''
	mv -fT -- "$TMP_3" "$GROUP"; TMP_3=''
	if [ "$remove_home" -eq 1 ]; then
		[ -d "$HOME_BASE/$name" ] && rm -rf -- "${HOME_BASE:?}/${name:?}"
	fi
	note "removed $name"
}

cmd_set_password() {
	[ "$#" -eq 1 ] || die "usage: set-password NAME (password on stdin)"
	name=$1
	# Read one line from stdin: keeps the secret out of argv and shell history.
	password=
	IFS= read -r password || true
	ensure_base
	user_exists "$name" || die "no such account: $name"
	[ -n "$password" ] || die "refusing to set an empty password"
	check_password_policy "$name" "$password"
	command -v openssl >/dev/null 2>&1 || die "openssl is required to hash passwords"
	salt=$(openssl rand -hex 8)
	[ -n "$salt" ] || die "failed to generate salt"
	hash=$(printf '%s' "$password" | openssl passwd -6 -salt "$salt" -stdin)
	case "$hash" in
		'$6$'*) ;;
		*) die "unexpected hash format from openssl" ;;
	esac
	# Drop a lock marker so the new password is usable.
	hash=$(printf '%s' "$hash")
	set_field "$SHADOW" "$name" 2 "$hash" 0600
	note "password updated for $name (SHA-512 crypt)"
}

cmd_lock() {
	[ "$#" -eq 1 ] || die "usage: lock NAME"
	name=$1; ensure_base; user_exists "$name" || die "no such account: $name"
	h=$(field_of "$SHADOW" "$name" 2)
	case "$h" in '!'*) note "$name already locked"; return 0 ;; esac
	set_field "$SHADOW" "$name" 2 "!$h" 0600
	note "locked $name"
}

cmd_unlock() {
	[ "$#" -eq 1 ] || die "usage: unlock NAME"
	name=$1; ensure_base; user_exists "$name" || die "no such account: $name"
	h=$(field_of "$SHADOW" "$name" 2)
	case "$h" in
		'!'*) ;;
		*) note "$name already unlocked"; return 0 ;;
	esac
	while :; do
		case "$h" in
			'!'*) h=${h#!} ;;
			*) break ;;
		esac
	done
	# A lock marker without a real hash must never become an empty password
	# field: some login implementations treat that as passwordless access.
	case "$h" in
		''|'*') die "account '$name' has no usable password hash; run set-password first" ;;
		'$6$'*) valid_sha512_hash "$h" || die "account '$name' has a weak or invalid password hash; run set-password first" ;;
		*) die "account '$name' has an unsupported password hash; refusing to unlock" ;;
	esac
	set_field "$SHADOW" "$name" 2 "$h" 0600
	note "unlocked $name"
}

cmd_list() {
	ensure_base
	printf 'UID  GID  USER\n'
	awk -F: '{printf "%-4s %-4s %s\n", $3, $4, $1}' "$PASSWD"
}

FAIL=0
audit_fail() { printf 'FAIL: %s\n' "$*" >&2; FAIL=$((FAIL+1)); }

# Quote-, brace-, and comment-aware doas.conf lexer/parser aligned with
# OpenDoas rules:
# - '#' starts a comment ONLY outside double quotes (and unescaped quotes).
# - '{' and '}' split tokens outside quotes (handling 'setenv{' and '}nopass').
# - Supports '\' + newline continuation inside an open setenv { ... } block.
# - Tracks last-match-wins effective :wheel grant across permit/deny rules
#   (so trailing unconditional 'deny :wheel' revokes earlier grants), while
#   flagging any 'permit' rule with an unquoted 'nopass' option before cmd/as.
doas_audit_awk() {
	awk -v mode="$1" '
	BEGIN {
		has_nopass = 0
		effective_wheel = 0
		wheel_cmd = ""
		syntax_err = 0
		cont_setenv = 0
	}
	{
		line = $0
		n = length(line)
		ntok = 0
		tok = ""
		has_tok = 0
		tok_q = 0
		in_q = 0
		esc = 0
		cont_bs = 0

		if (cont_setenv) {
			# Check if continued setenv line ends with unescaped backslash outside quotes/comments.
			# We lex normally and handle continuation at the end of the line.
		}
		for (i = 1; i <= n; i++) {
			c = substr(line, i, 1)
			if (in_q) {
				if (esc) {
					tok = tok c
					esc = 0
				} else if (c == "\\") {
					esc = 1
				} else if (c == "\"") {
					in_q = 0
				} else {
					tok = tok c
				}
			} else {
				if (c == "#") {
					break
				} else if (c == " " || c == "\t" || c == "\r") {
					if (has_tok) {
						ntok++
						toks[ntok] = tok
						qs[ntok] = tok_q
						tok = ""
						has_tok = 0
						tok_q = 0
					}
				} else if (c == "{" || c == "}") {
					if (has_tok) {
						ntok++
						toks[ntok] = tok
						qs[ntok] = tok_q
						tok = ""
						has_tok = 0
						tok_q = 0
					}
					ntok++
					toks[ntok] = c
					qs[ntok] = 0
				} else if (c == "\"") {
					in_q = 1
					tok_q = 1
					has_tok = 1
				} else {
					tok = tok c
					has_tok = 1
				}
			}
		}
		if (in_q || esc) {
			syntax_err = 1
			cont_setenv = 0
			next
		}
		if (has_tok) {
			ntok++
			toks[ntok] = tok
			qs[ntok] = tok_q
		}
		if (!cont_setenv) {
			if (ntok == 0) next
			if (qs[1] || (toks[1] != "permit" && toks[1] != "deny")) {
				syntax_err = 1
				next
			}
			c_action = toks[1]
			c_in_setenv = 0
			c_expect_brace = 0
			c_saw_nopass = 0
			c_ident = ""
			c_target = ""
			c_cmd = ""
			c_has_cmd = 0
			c_rule_err = 0
			start_i = 2
		} else {
			cont_setenv = 0
			start_i = 1
		}

		for (i = start_i; i <= ntok; i++) {
			t = toks[i]
			tq = qs[i]
			if (c_expect_brace) {
				c_expect_brace = 0
				if (!tq && t == "{") {
					c_in_setenv = 1
					continue
				}
				if (!tq && t ~ /=/) {
					continue
				}
				c_rule_err = 1
			}
			if (c_in_setenv) {
				if (!tq && t == "}" ) {
					c_in_setenv = 0
				}
				continue
			}
			if (!tq && (t == "{" || t == "}")) {
				c_rule_err = 1
				break
			}
			if (!tq && t == "setenv") {
				if (c_ident != "") { c_rule_err = 1; break }
				c_expect_brace = 1
				continue
			}
			if (!tq && t == "nopass") {
				if (c_ident != "") { c_rule_err = 1; break }
				c_saw_nopass = 1
				continue
			}
			if (!tq && (t == "persist" || t == "keepenv" || t == "nolog")) {
				if (c_ident != "") { c_rule_err = 1; break }
				continue
			}
			if (!tq && t == "as") {
				if (c_ident == "" || i + 1 > ntok) { c_rule_err = 1; break }
				i++
				c_target = toks[i]
				continue
			}
			if (!tq && t == "cmd") {
				if (c_ident == "" || i + 1 > ntok) { c_rule_err = 1; break }
				c_has_cmd = 1
				c_cmd = toks[i + 1]
				break
			}
			if (c_ident == "") {
				c_ident = t
			} else {
				c_rule_err = 1
				break
			}
		}

		if (c_in_setenv && ntok > 0 && !qs[ntok] && substr(toks[ntok], length(toks[ntok]), 1) == "\\") {
			cont_setenv = 1
			next
		}
		if (c_in_setenv || c_expect_brace || c_ident == "") {
			c_rule_err = 1
		}
		if (c_action == "permit" && c_saw_nopass) {
			has_nopass = 1
		}
		if (c_rule_err) {
			syntax_err = 1
			next
		}
		if (c_action == "permit") {
			if (c_ident == ":wheel" && (c_target == "" || c_target == "root" || c_target == "0") && !c_has_cmd) {
				effective_wheel = 1
				wheel_cmd = ""
			}
		} else {
			if ((c_ident == ":wheel" || c_ident == "sane" || c_ident == ":sane" || \
		     c_ident == "1000") && (c_target == "" || c_target == "root" || c_target == "0")) {
				if (!c_has_cmd) {
					effective_wheel = 0
					wheel_cmd = ""
				} else if (wheel_cmd != "" && c_cmd == wheel_cmd) {
					effective_wheel = 0
					wheel_cmd = ""
				}
			}
		}
	}
	END {
		if (cont_setenv) syntax_err = 1
		if (mode == "nopass") exit !has_nopass
		if (mode == "syntax") exit syntax_err
		if (mode == "wheel") exit (syntax_err || !effective_wheel)
		exit (syntax_err || has_nopass || !effective_wheel)
	}' "$2"
}

doas_has_nopass() { doas_audit_awk nopass "$1"; }
doas_syntax_ok() { doas_audit_awk syntax "$1"; }
doas_has_effective_wheel() { doas_audit_awk wheel "$1"; }
doas_policy_ok() { doas_audit_awk policy "$1"; }
doas_has_deny() { grep -Eq '^[[:space:]]*deny([[:space:]]|$)' "$1"; }

cmd_validate() {
	ensure_etc
	MARK="$ETC/.sane-firstboot-done"
	for rel in etc/passwd etc/group etc/shadow etc/doas.conf usr usr/bin usr/bin/doas; do
		symlink_resolve_contained "$rel" || audit_fail "path escapes root: $rel"
	done
	for f in "$PASSWD" "$GROUP" "$SHADOW" "$DOAS_CONF"; do
		[ -f "$f" ] || audit_fail "missing file: ${f#$ROOT}"
		[ ! -L "$f" ] || audit_fail "refusing symlink identity file: ${f#$ROOT}"
	done
	[ "$FAIL" -eq 0 ] || return 1

	m=$(mode_of "$PASSWD"); [ "$m" = 644 ] || audit_fail "passwd mode $m (expected 644)"
	m=$(mode_of "$GROUP");  [ "$m" = 644 ] || audit_fail "group mode $m (expected 644)"
	m=$(mode_of "$SHADOW"); [ "$m" = 600 ] || audit_fail "shadow mode $m (expected 600)"
	m=$(mode_of "$DOAS_CONF"); [ "$m" = 600 ] || audit_fail "doas.conf mode $m (expected 600)"
	if [ "$SKIP_OWNER" -ne 1 ]; then
		o=$(owner_of "$DOAS_CONF"); [ "$o" = 0:0 ] || \
			audit_fail "doas.conf owner $o (expected 0:0)"
	fi

	awk -F: 'NF!=7 || $3!~/^[0-9]+$/ || $4!~/^[0-9]+$/ {bad=1} END{exit !bad}' "$PASSWD" && \
		audit_fail "passwd contains malformed entry or non-numeric uid/gid"
	awk -F: '$1!="root" && $3==0 {bad=1} END{exit !bad}' "$PASSWD" && \
		audit_fail "non-root account has uid 0"
	awk -F: '{if (seen[$3]++) {bad=1}} END{exit !bad}' "$PASSWD" && \
		audit_fail "duplicate uid in passwd"
	awk -F: '{if (seen[$1]++) {bad=1}} END{exit !bad}' "$PASSWD" && \
		audit_fail "duplicate username in passwd"
	awk -F: '$1=="root" && $3==0 {r=1} $1=="sane" && $3==1000 {s=1} END{exit !(r && s)}' "$PASSWD" || \
		audit_fail "passwd missing baseline root(0) or sane(1000)"
	awk -F: '{if (seen[$3]++) {bad=1}} END{exit !bad}' "$GROUP" && \
		audit_fail "duplicate gid in group"
	awk -F: '{if (seen[$1]++) {bad=1}} END{exit !bad}' "$GROUP" && \
		audit_fail "duplicate group name in group"

	# An active hash must be a complete SHA-512 crypt value, not just a "$6$"
	# prefix. A truncated hash passes a prefix-only check and leaves the
	# console locked out while validation still reports success.
	bad=0
	weak_default=0
	while IFS=: read -r _u _p _uid _gid _gecos _home _shell _rest; do
		h=$_p; [ -z "$h" ] && { bad=1; continue; }
		while :; do
			case "$h" in
				'!'*) h=${h#!} ;;
				*) break ;;
			esac
		done
		# K1: the pre-v1.3.0 deterministic hashes used the salts 'root' and
		# 'sane'. Any live hash with those salts is a known weak default
		# credential from an old image; rotate both passwords.
		case "$h" in
			'$6$root$'*|'$6$sane$'*) weak_default=1 ;;
		esac
		case "$h" in
			'*'|'') continue ;;  # deliberately disabled account
			'$6$'*) valid_sha512_hash "$h" || bad=1 ;;
			*) bad=1 ;;           # unsupported active hash algorithm
		esac
	done < "$SHADOW"
	[ "$bad" -eq 0 ] || \
		audit_fail "shadow has an empty field, truncated hash, or unsupported active hash"
	[ "$weak_default" -eq 0 ] || \
		audit_fail "shadow contains a known weak default credential hash (deterministic salt 'root'/'sane' from a pre-v1.3.0 image); rotate both passwords"

	if ! awk -F: -v n=wheel '$1==n {found=1} END{exit !found}' "$GROUP"; then
		audit_fail "wheel group is missing"
	elif ! awk -F: -v n=wheel '$1==n && $4 ~ /(^|,)sane(,|$)/ {found=1} END{exit !found}' "$GROUP"; then
		audit_fail "wheel group does not include 'sane'"
	fi

	if doas_has_nopass "$DOAS_CONF"; then
		audit_fail "doas.conf grants 'nopass' (passwordless escalation)"
	fi
	if ! doas_syntax_ok "$DOAS_CONF"; then
		audit_fail "doas.conf has invalid syntax"
	elif ! doas_has_effective_wheel "$DOAS_CONF"; then
		audit_fail "doas.conf has no effective permit rule for :wheel"
	fi
	if [ -e "$ROOT/usr/bin/doas" ]; then
		m=$(mode_of "$ROOT/usr/bin/doas")
		[ "$m" = 4755 ] || audit_fail "doas mode $m (expected 4755 setuid root)"
		if [ "$SKIP_OWNER" -ne 1 ]; then
			o=$(owner_of "$ROOT/usr/bin/doas")
			[ "$o" = 0:0 ] || audit_fail "doas owner $o (expected 0:0)"
		fi
	else
		audit_fail "doas binary is missing"
	fi

	# root and sane are required daily-use accounts. Once firstboot is marked
	# done they must have an active hash; a surviving root hash alone is not
	# enough, otherwise a lost sane hash silently locks the daily account out.
	if [ -f "$MARK" ]; then
		for req in root sane; do
			h=$(field_of "$SHADOW" "$req" 2 || true)
			while :; do
				case "$h" in
					'!'*) h=${h#!} ;;
					*) break ;;
				esac
			done
			valid_sha512_hash "$h" || \
				audit_fail "required account $req has no usable hash after firstboot"
		done
	fi

	if [ "$FAIL" -ne 0 ]; then
		printf '%s: %d validation failure(s)\n' "$PROG" "$FAIL" >&2
		return 1
	fi
	note "account policy validation passed"
}

# Structural audits for recover's targeted checks. They mirror
# cmd_validate's numeric/duplicate/uid-0 audits and additionally flag
# conflicts a merge could otherwise introduce: a non-baseline line
# holding a baseline id (root 0, sane 1000, wheel gid 10) or a duplicated
# baseline name would leave a duplicate id after the baseline is ensured,
# i.e. a state that still fails validation. Recover must never produce one.
passwd_structurally_ok() {
	awk -F: '
		NF != 7 || $1 == "" { bad = 1 }
		$3 !~ /^[0-9]+$/ || $4 !~ /^[0-9]+$/ { bad = 1 }
		$1 != "root" && $3 == 0 { bad = 1 }
		$1 != "sane" && $3 == 1000 { bad = 1 }
		{ if (seen[$3]++ || names[$1]++) bad = 1 }
		$1 == "root" { rc++ }
		$1 == "sane" { sc++ }
		END { if (rc > 1 || sc > 1) bad = 1; exit bad }
	' "$1"
}

group_structurally_ok() {
	awk -F: '
		NF != 4 || $1 == "" { bad = 1 }
		$3 !~ /^[0-9]+$/ { bad = 1 }
		$1 != "root" && $3 == 0 { bad = 1 }
		$1 != "wheel" && $3 == 10 { bad = 1 }
		$1 != "sane" && $3 == 1000 { bad = 1 }
		{ if (seen[$3]++) bad = 1 }
		$1 == "root" { rc++ }
		$1 == "wheel" { wc++ }
		$1 == "sane" { sc++ }
		END { if (rc > 1 || wc > 1 || sc > 1) bad = 1; exit bad }
	' "$1"
}

# Structural audit for recover's shadow check. Mirrors passwd/group structural
# checks and the cmd_validate hash rules: every line must have the complete
# 9-field shape, a unique name that also exists in passwd (with the baseline
# uid for root/sane), numeric age fields, and a complete active SHA-512 hash
# or a lock/disable marker. Passwd has already been merged when this runs, so
# a name that only a corrupt passwd could supply is no longer in the way.
AWK_SHADOW_HASH_OK='
	function shadow_hash_ok(h, a) {
		if (h == "") return 0
		if (h ~ /^!+/) sub(/^!+/, "", h)
		if (h == "*" || h == "") return 1
		if (h ~ /^\$6\$(root|sane)\$/) return 0
		if (h !~ /^\$6\$/) return 0
		sub(/^\$6\$/, "", h)
		if (split(h, a, "\\$") != 2) return 0
		if (a[1] == "" || length(a[1]) > 16 || a[1] ~ /[^.\/A-Za-z0-9]/) return 0
		if (length(a[2]) != 86 || a[2] ~ /[^.\/A-Za-z0-9]/) return 0
		return 1
	}
'

shadow_structurally_ok() {
	awk -F: -v passwd_file="$PASSWD" "$AWK_SHADOW_HASH_OK"'
		FILENAME == passwd_file { puid[$1] = $3; next }
		{
			if (NF != 9) { bad = 1; next }
			if ($1 !~ /^[a-z_][a-z0-9_-]*$/) { bad = 1; next }
			if (seen[$1]++) bad = 1
			if (!shadow_hash_ok($2)) bad = 1
			# An empty field3 disables password aging (shadow(5)).
			if ($3 != "" && $3 !~ /^[0-9]+$/) bad = 1
			for (i = 4; i <= 8; i++)
				if ($i != "" && $i !~ /^[0-9]+$/) bad = 1
			if (!($1 in puid)) bad = 1
			if ($1 == "root" && puid[$1] != "0") bad = 1
			if ($1 == "sane" && puid[$1] != "1000") bad = 1
		}
		END { exit bad }
	' "$PASSWD" "$1"
}

merge_passwd() {
	# Ensure root/sane match the baseline exactly (replace the line when
	# present, append when missing); every other line survives byte-for-byte.
	TMP_1=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	if ! chmod 0644 "$TMP_1" || ! awk -F: '
		$1 == "root" { print "root:x:0:0:root:/root:/bin/sh"; r = 1; next }
		$1 == "sane" { print "sane:x:1000:1000:S.A.N.E User:/home/sane:/bin/sh"; s = 1; next }
		{ print }
		END {
			if (!r) print "root:x:0:0:root:/root:/bin/sh"
			if (!s) print "sane:x:1000:1000:S.A.N.E User:/home/sane:/bin/sh"
		}' "$PASSWD" > "$TMP_1" || ! mv -fT -- "$TMP_1" "$PASSWD"; then
		rm -f -- "$TMP_1"; TMP_1=''
		die "failed to merge $PASSWD"
	fi
	TMP_1=''
}

merge_group() {
	# Ensure root/wheel/sane exist with baseline gids and wheel contains
	# root and sane. Existing memberships and all non-baseline lines are
	# preserved; missing baseline groups are appended.
	TMP_1=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	if ! chmod 0644 "$TMP_1" || ! awk -F: 'BEGIN { OFS = ":" }
		$1 == "root" { $2 = "x"; $3 = "0"; print; r = 1; next }
		$1 == "sane" { $2 = "x"; $3 = "1000"; print; s = 1; next }
		$1 == "wheel" {
			$2 = "x"; $3 = "10"
			k = split($4, a, ","); out = ""; c = 0; hr = 0; hs = 0
			for (i = 1; i <= k; i++) {
				if (a[i] == "") continue
				if (a[i] == "root") hr = 1
				if (a[i] == "sane") hs = 1
				out = out (c ? "," : "") a[i]; c++
			}
			if (!hr) { out = out (c ? "," : "") "root"; c++ }
			if (!hs) { out = out (c ? "," : "") "sane"; c++ }
			$4 = out
			print; w = 1; next
		}
		{ print }
		END {
			if (!r) print "root:x:0:"
			if (!w) print "wheel:x:10:root,sane"
			if (!s) print "sane:x:1000:"
		}' "$GROUP" > "$TMP_1" || ! mv -fT -- "$TMP_1" "$GROUP"; then
		rm -f -- "$TMP_1"; TMP_1=''
		die "failed to merge $GROUP"
	fi
	TMP_1=''
}

rebuild_passwd() {
	# Baseline template + every non-baseline line of the old file that is
	# itself valid and conflict-free: 7 fields, numeric uid/gid, uid >=
	# 1000, uid and name unique against the template and already-restored
	# lines. Conflicting or malformed lines are dropped.
	TMP_1=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	chmod 0644 "$TMP_1" || { rm -f -- "$TMP_1"; TMP_1=''; die "cannot set mode on temp $PASSWD"; }
	printf 'root:x:0:0:root:/root:/bin/sh\nsane:x:1000:1000:S.A.N.E User:/home/sane:/bin/sh\n' > "$TMP_1"
	if [ -f "$PASSWD" ]; then
		if ! awk -F: '
			BEGIN { seen[0] = 1; seen[1000] = 1; names["root"] = 1; names["sane"] = 1 }
			$1 == "root" || $1 == "sane" { next }
			NF != 7 { next }
			$3 !~ /^[0-9]+$/ || $4 !~ /^[0-9]+$/ { next }
			$3 + 0 < 1000 { next }
			seen[$3]++ { next }
			names[$1]++ { next }
			{ print }
		' "$PASSWD" >> "$TMP_1"; then
			rm -f -- "$TMP_1"; TMP_1=''
			die "failed to rebuild $PASSWD"
		fi
	fi
	mv -fT -- "$TMP_1" "$PASSWD" || { rm -f -- "$TMP_1"; TMP_1=''; die "failed to install $PASSWD"; }
	TMP_1=''
}

rebuild_group() {
	# Same policy as rebuild_passwd: baseline template + valid,
	# conflict-free non-baseline groups (4 fields, numeric gid >= 1000,
	# unique gid and name).
	TMP_1=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	chmod 0644 "$TMP_1" || { rm -f -- "$TMP_1"; TMP_1=''; die "cannot set mode on temp $GROUP"; }
	printf 'root:x:0:\nwheel:x:10:root,sane\nsane:x:1000:\n' > "$TMP_1"
	if [ -f "$GROUP" ]; then
		if ! awk -F: '
			BEGIN { seen[0] = 1; seen[10] = 1; seen[1000] = 1
				names["root"] = 1; names["wheel"] = 1; names["sane"] = 1 }
			$1 == "root" || $1 == "wheel" || $1 == "sane" { next }
			NF != 4 { next }
			$3 !~ /^[0-9]+$/ { next }
			$3 + 0 < 1000 { next }
			seen[$3]++ { next }
			names[$1]++ { next }
			{ print }
		' "$GROUP" >> "$TMP_1"; then
			rm -f -- "$TMP_1"; TMP_1=''
			die "failed to rebuild $GROUP"
		fi
	fi
	mv -fT -- "$TMP_1" "$GROUP" || { rm -f -- "$TMP_1"; TMP_1=''; die "failed to install $GROUP"; }
	TMP_1=''
}

merge_shadow() {
	# root/sane get the baseline fields, with the old hash only when it was
	# usable (otherwise the locked marker). Every other line is printed
	# verbatim, so additional accounts keep their hashes byte-for-byte.
	root_hash=$1; sane_hash=$2
	TMP_1=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	if ! chmod 0600 "$TMP_1" || ! awk -F: -v rh="$root_hash" -v sh="$sane_hash" '
		$1 == "root" {
			print "root:" (rh == "" ? "!" : rh) ":19700:0:99999:7:::"; r = 1; next
		}
		$1 == "sane" {
			print "sane:" (sh == "" ? "!" : sh) ":19700:0:99999:7:::"; s = 1; next
		}
		{ print }
		END {
			if (!r) print "root:" (rh == "" ? "!" : rh) ":19700:0:99999:7:::"
			if (!s) print "sane:" (sh == "" ? "!" : sh) ":19700:0:99999:7:::"
		}
	' "$SHADOW" > "$TMP_1" || ! mv -fT -- "$TMP_1" "$SHADOW"; then
		rm -f -- "$TMP_1"; TMP_1=''
		die "failed to merge $SHADOW"
	fi
	TMP_1=''
}

rebuild_shadow() {
	# Baseline locked template + every extra entry that is itself valid and
	# conflict-free: unique name still present in passwd, complete 9 fields,
	# numeric age fields, and a valid active SHA-512 or lock/disable marker.
	# Write final root/sane fields into "$TMP_1" before atomic mv(1) so an
	# interrupted recovery never leaves a temporary locked state on disk.
	root_hash=$1; sane_hash=$2
	rh_out=$root_hash; [ -n "$rh_out" ] || rh_out='!'
	sh_out=$sane_hash; [ -n "$sh_out" ] || sh_out='!'
	TMP_1=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
	chmod 0600 "$TMP_1" || { rm -f -- "$TMP_1"; TMP_1=''; die "cannot set mode on temp $SHADOW"; }
	printf 'root:%s:19700:0:99999:7:::\nsane:%s:19700:0:99999:7:::\n' "$rh_out" "$sh_out" > "$TMP_1"
	if [ -f "$SHADOW" ]; then
		if ! awk -F: -v passwd_file="$PASSWD" "$AWK_SHADOW_HASH_OK"'
			FILENAME == passwd_file { pname[$1] = 1; next }
			$1 == "root" || $1 == "sane" { next }
			NF != 9 { next }
			$1 !~ /^[a-z_][a-z0-9_-]*$/ { next }
			!shadow_hash_ok($2) { next }
			# Empty field3 is valid: password aging is disabled.
			$3 != "" && $3 !~ /^[0-9]+$/ { next }
			{
				ok = 1
				for (i = 4; i <= 8; i++)
					if ($i != "" && $i !~ /^[0-9]+$/) ok = 0
				if (!ok) next
			}
			!($1 in pname) { next }
			seen[$1]++ { next }
			{ print }
		' "$PASSWD" "$SHADOW" >> "$TMP_1"; then
			rm -f -- "$TMP_1"; TMP_1=''
			die "failed to rebuild $SHADOW"
		fi
	fi
	mv -fT -- "$TMP_1" "$SHADOW" || { rm -f -- "$TMP_1"; TMP_1=''; die "failed to install $SHADOW"; }
	TMP_1=''
}

# Inspect field 2 of an account in shadow and separate lock state ('!') from
# hash validity so recovery never strips an administrator lock prefix.
inspect_shadow_recovery() {
	raw=$(field_of "$1" "$2" 2 || true)
	is_locked=0
	bare=$raw
	while :; do
		case "$bare" in
			'!'*) is_locked=1; bare=${bare#!} ;;
			*) break ;;
		esac
	done
	if valid_sha512_hash "$bare"; then
		hash_valid=1
		clean_hash=$bare
	else
		hash_valid=0
		clean_hash=
	fi
}

# Format field 2 for merge_shadow/rebuild_shadow from separate validity & lock state.
compose_shadow_field() {
	valid=$1; locked=$2; hash=$3
	if [ "$valid" -eq 1 ]; then
		if [ "$locked" -eq 1 ]; then
			printf '!%s\n' "$hash"
		else
			printf '%s\n' "$hash"
		fi
	else
		printf '!\n'
	fi
}

cmd_recover() {
	ensure_etc
	require_contained_rel "etc/passwd"
	require_contained_rel "etc/group"
	require_contained_rel "etc/shadow"
	require_contained_rel "etc/doas.conf"
	require_contained_rel "etc/.sane-firstboot-done"
	require_contained_rel "home"
	require_contained_rel "home/sane"
	reject_symlink "$HOME_BASE/sane"
	recover_root_valid=0
	recover_root_locked=0
	recover_root_hash=
	recover_sane_valid=0
	recover_sane_locked=0
	recover_sane_hash=
	if [ -f "$SHADOW" ] && [ ! -L "$SHADOW" ]; then
		inspect_shadow_recovery "$SHADOW" root
		recover_root_valid=$hash_valid
		recover_root_locked=$is_locked
		recover_root_hash=$clean_hash

		inspect_shadow_recovery "$SHADOW" sane
		recover_sane_valid=$hash_valid
		recover_sane_locked=$is_locked
		recover_sane_hash=$clean_hash
	fi
	recover_root_field=$(compose_shadow_field "$recover_root_valid" "$recover_root_locked" "$recover_root_hash")
	recover_sane_field=$(compose_shadow_field "$recover_sane_valid" "$recover_sane_locked" "$recover_sane_hash")

	# doas.conf: keep policy-compliant content, repair mode/owner only. A
	# syntactically valid custom rule that only grants a restricted command
	# is not sufficient for the daily workstation policy; append the
	# unrestricted baseline rule instead of discarding the custom rule.
	if [ -f "$DOAS_CONF" ] && [ ! -L "$DOAS_CONF" ] && doas_policy_ok "$DOAS_CONF"; then
		chmod 0600 "$DOAS_CONF"
		[ "$(id -u)" = 0 ] && chown 0:0 "$DOAS_CONF" 2>/dev/null || true
		printf 'recover: doas.conf preserved (policy ok; mode/owner repaired)\n'
	elif [ -f "$DOAS_CONF" ] && [ ! -L "$DOAS_CONF" ] && \
	     doas_syntax_ok "$DOAS_CONF" && ! doas_has_nopass "$DOAS_CONF" && \
	     ! doas_has_deny "$DOAS_CONF"; then
		TMP_1=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
		chmod 0600 "$TMP_1"
		[ "$(id -u)" = 0 ] && chown 0:0 "$TMP_1" 2>/dev/null || true
		if ! cp "$DOAS_CONF" "$TMP_1" || \
		   ! printf '\npermit persist :wheel\n' >> "$TMP_1" || \
		   ! doas_policy_ok "$TMP_1" || \
		   ! atomic_mv_replace "$TMP_1" "$DOAS_CONF"; then
			rm -f "$TMP_1"
			die "failed to add unrestricted wheel rule to doas.conf"
		fi
		printf 'recover: unrestricted wheel rule appended; custom rules preserved\n'
	else
		TMP_1=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
		chmod 0600 "$TMP_1"
		[ "$(id -u)" = 0 ] && chown 0:0 "$TMP_1" 2>/dev/null || true
		printf 'permit persist :wheel\n' > "$TMP_1"
		atomic_mv_replace "$TMP_1" "$DOAS_CONF"; TMP_1=''
		printf 'recover: doas.conf rebuilt from baseline (missing or policy violation)\n'
	fi

	if [ -f "$PASSWD" ] && [ ! -L "$PASSWD" ] && passwd_structurally_ok "$PASSWD"; then
		merge_passwd
		printf 'recover: passwd merged (root/sane ensured; extra entries preserved)\n'
	else
		rebuild_passwd
		printf 'recover: passwd rebuilt from baseline (structural corruption; valid extra entries restored)\n'
	fi

	if [ -f "$GROUP" ] && [ ! -L "$GROUP" ] && group_structurally_ok "$GROUP"; then
		merge_group
		printf 'recover: group merged (root/wheel/sane ensured; extra entries preserved)\n'
	else
		rebuild_group
		printf 'recover: group rebuilt from baseline (structural corruption; valid extra entries restored)\n'
	fi

	# shadow: merge when structurally sound (extra hashes preserved
	# byte-for-byte); otherwise rebuild the locked baseline and append back
	# only valid, conflict-free extra entries. Usable root/sane hashes (and
	# any existing '!' lock prefix) are restored in both paths.
	if [ -f "$SHADOW" ] && [ ! -L "$SHADOW" ] && shadow_structurally_ok "$SHADOW"; then
		merge_shadow "$recover_root_field" "$recover_sane_field"
		printf 'recover: shadow merged (root/sane repaired when usable; extra entries preserved)\n'
	else
		rebuild_shadow "$recover_root_field" "$recover_sane_field"
		printf 'recover: shadow rebuilt from baseline (structural corruption; valid extra entries restored)\n'
	fi

	chmod 0644 "$PASSWD" "$GROUP"
	chmod 0600 "$SHADOW" "$DOAS_CONF"
	if [ -e "$HOME_BASE/sane" ] && [ ! -d "$HOME_BASE/sane" ]; then
		die "home path exists but is not a directory: $HOME_BASE/sane"
	fi
	mkdir -p "$HOME_BASE/sane"
	chmod 0750 "$HOME_BASE/sane"

	MARK="$ETC/.sane-firstboot-done"
	if [ "$recover_root_valid" -ne 1 ] || [ "$recover_sane_valid" -ne 1 ]; then
		rm -f -- "$MARK"
		printf 'recover: no usable root/sane hash; first boot will ask for passwords again\n'
	else
		TMP_1=$(mktemp "$ETC/.sane-accounts.XXXXXX") || die "cannot create temp file in $ETC"
		chmod 0600 "$TMP_1"
		printf 'done\n' > "$TMP_1"
		mv -fT -- "$TMP_1" "$MARK"; TMP_1=''
		printf 'recover: preserved usable password hashes\n'
	fi
	note "identity recovery complete under $ETC"
}

case "$CMD" in
	init)          cmd_init "$@" ;;
	add-user)      cmd_add_user "$@" ;;
	del-user)      cmd_del_user "$@" ;;
	set-password)  cmd_set_password "$@" ;;
	lock)          cmd_lock "$@" ;;
	unlock)        cmd_unlock "$@" ;;
	list)          cmd_list "$@" ;;
	validate)      cmd_validate "$@" ;;
	recover)       cmd_recover "$@" ;;
	*) usage >&2; die "unknown command: $CMD" ;;
esac
