#!/bin/sh
# /usr/share/udhcpc/default.script -- BusyBox udhcpc event script (FEAT-64, Phase B)
# Fail-closed: invalid server values are ignored, resolv.conf is replaced
# atomically, and the original resolver is restored on deconfig.
set -eu

[ -n "${1:-}" ] || { printf 'Error: called without event\n' >&2; exit 1; }

ROOT=${SANE_ROOT:-}
while [ "${ROOT%/}" != "$ROOT" ]; do
	ROOT=${ROOT%/}
done
RESOLV_CONF="${ROOT}/etc/resolv.conf"
RESOLV_DEFAULT="${ROOT}/etc/resolv.conf.default"

# A nameserver must be a literal IPv4 or IPv6 address, matching sane-net's
# validation exactly so a resolver written here always passes `sane-net check`.
valid_ipv4() {
	case "$1" in
		[0-9]*.[0-9]*.[0-9]*.[0-9]*) ;;
		*) return 1 ;;
	esac
	case "$1" in *[!0-9.]*) return 1 ;; esac
	_a=${1%%.*}; _r=${1#*.}
	_b=${_r%%.*}; _r=${_r#*.}
	_c=${_r%%.*}; _d=${_r#*.}
	case "$_d" in *.*) return 1 ;; esac
	for _o in "$_a" "$_b" "$_c" "$_d"; do
		case "$_o" in
			''|*[!0-9]*) return 1 ;;
			0) ;;
			0*) return 1 ;;
		esac
		[ "${#_o}" -le 3 ] || return 1
		[ "$_o" -le 255 ] || return 1
	done
	return 0
}

_v6_groups() {
	_v6_count=0
	_g=$1
	while [ -n "$_g" ]; do
		case "$_g" in
			*:*) _part=${_g%%:*}; _g=${_g#*:} ;;
			*)   _part=$_g; _g= ;;
		esac
		if [ -z "$_g" ]; then
			case "$_part" in
				*.*)
					valid_ipv4 "$_part" || return 1
					_v6_count=$((_v6_count + 2))
					return 0
					;;
			esac
		fi
		case "$_part" in ''|*[!0-9a-fA-F]*) return 1 ;; esac
		[ "${#_part}" -le 4 ] || return 1
		_v6_count=$((_v6_count + 1))
	done
	return 0
}

valid_ipv6() {
	case "$1" in *:*) ;; *) return 1 ;; esac
	case "$1" in *[!0-9a-fA-F:.]*) return 1 ;; esac
	_tmp=$1; _dc=0
	while :; do
		case "$_tmp" in
			*::*) _dc=$((_dc + 1)); _tmp=${_tmp#*::} ;;
			*) break ;;
		esac
	done
	[ "$_dc" -le 1 ] || return 1
	if [ "$_dc" -eq 1 ]; then
		_left=${1%%::*}
		_right=${1#*::}
		case "$_left" in *:) return 1 ;; esac
		case "$_right" in :*) return 1 ;; esac
		_v6_groups "$_left" || return 1
		_lc=$_v6_count
		_v6_groups "$_right" || return 1
		_rc=$_v6_count
		[ "$((_lc + _rc))" -lt 8 ] || return 1
		return 0
	fi
	case "$1" in :*|*:) return 1 ;; esac
	_v6_groups "$1" || return 1
	[ "$_v6_count" -eq 8 ] || return 1
	return 0
}

valid_server() {
	valid_ipv4 "$1" && return 0
	valid_ipv6 "$1" && return 0
	return 1
}

write_resolv() {
	dir=$(dirname "$RESOLV_CONF")
	tmp=$(mktemp "$dir/.resolv.conf.XXXXXX") || return 1
	if [ -n "${domain:-}" ]; then
		case "$domain" in
			''|*[!a-zA-Z0-9._-]*) ;;
			*) printf 'domain %s\n' "$domain" >> "$tmp" ;;
		esac
	fi
	for ns in "$@"; do
		valid_server "$ns" || continue
		printf 'nameserver %s\n' "$ns" >> "$tmp"
	done
	chmod 0644 "$tmp"
	mv -f "$tmp" "$RESOLV_CONF"
}

restore_default_resolv() {
	[ -f "$RESOLV_DEFAULT" ] || return 0
	dir=$(dirname "$RESOLV_CONF")
	tmp=$(mktemp "$dir/.resolv.conf.XXXXXX") || return 1
	if ! cat "$RESOLV_DEFAULT" > "$tmp"; then rm -f "$tmp"; return 1; fi
	chmod 0644 "$tmp"
	mv -f "$tmp" "$RESOLV_CONF"
}

case "$1" in
    deconfig)
        ip addr flush dev "$interface" 2>/dev/null || true
        ip link set "$interface" up 2>/dev/null || true
        restore_default_resolv || true
        ;;
    renew|bound)
        ip addr flush dev "$interface" 2>/dev/null || true

        NETMASK=""
        if [ -n "${mask:-}" ]; then
            NETMASK="/$mask"
        elif [ -n "${subnet:-}" ]; then
            NETMASK="/$subnet"
        fi

        ip addr add "${ip}${NETMASK}" dev "$interface"

        if [ -n "${router:-}" ]; then
            for r in $router; do
                ip route add default via "$r" dev "$interface" 2>/dev/null || true
                break
            done
        fi

        if [ -n "${dns:-}" ]; then
            write_resolv $dns || true
        fi
        ;;
    nak|leasefail)
        ;;
esac

exit 0
