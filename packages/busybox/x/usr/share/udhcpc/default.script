#!/bin/sh
# /usr/share/udhcpc/default.script -- BusyBox udhcpc event script (FEAT-64)
set -e

[ -n "${1:-}" ] || { echo "Error: called without event" >&2; exit 1; }

RESOLV_CONF="/etc/resolv.conf"

case "$1" in
    deconfig)
        ip addr flush dev "$interface" 2>/dev/null || true
        ip link set "$interface" up 2>/dev/null || true
        ;;
    renew|bound)
        ip addr flush dev "$interface" 2>/dev/null || true

        NETMASK=""
        if [ -n "${mask:-}" ]; then
            NETMASK="/$mask"
        elif [ -n "${subnet:-}" ]; then
            NETMASK="/$subnet"
        fi

        ip addr add "${ip}${NETMASK}" dev "$interface"

        if [ -n "${router:-}" ]; then
            for r in $router; do
                ip route add default via "$r" dev "$interface" 2>/dev/null || true
                break
            done
        fi

        if [ -n "${dns:-}" ]; then
            tmp_resolv="/etc/resolv.conf.tmp.$$"
            rm -f "$tmp_resolv" 2>/dev/null || true
            for ns in $dns; do
                printf 'nameserver %s\n' "$ns" >> "$tmp_resolv"
            done
            mv -f "$tmp_resolv" "$RESOLV_CONF" 2>/dev/null || true
        fi
        ;;
    nak|leasefail)
        ;;
esac

exit 0
